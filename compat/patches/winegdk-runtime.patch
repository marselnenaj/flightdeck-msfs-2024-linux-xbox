diff --git a/dlls/xgameruntime/GDKComponent/System/TitleAuthHttp.c b/dlls/xgameruntime/GDKComponent/System/TitleAuthHttp.c
new file mode 100644
index 0000000..fa74c0f
--- /dev/null
+++ b/dlls/xgameruntime/GDKComponent/System/TitleAuthHttp.c
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Keep WinHTTP's SDK types separate from the user's WinINet URL parser. */
+#include "TitleAuthHttp.h"
+#include <winhttp.h>
+#include <stdlib.h>
+#include <string.h>
+
+HRESULT xodus_title_auth_http(const WCHAR *method, const WCHAR *host, const WCHAR *path,
+    const char *body, const WCHAR *headers, UCHAR **buffer, SIZE_T *size, DWORD *status)
+{
+    HINTERNET session = NULL, connection = NULL, request = NULL;
+    SIZE_T bodySize = body ? strlen(body) : 0;
+    UCHAR chunk[8192], *grown;
+    DWORD option, length, got;
+    HRESULT hr = E_INVALIDARG;
+    if (!buffer || !size || !status) return E_POINTER;
+    *buffer = NULL; *size = 0; *status = 0;
+    if (!method || !host || !path || !headers || bodySize > 1048576) return E_INVALIDARG;
+    if (!(session = WinHttpOpen(L"Xodus-Title-Auth/1", WINHTTP_ACCESS_TYPE_DEFAULT_PROXY, NULL, NULL, 0))) goto win_error;
+    if (!WinHttpSetTimeouts(session, 10000, 10000, 10000, 10000)) goto win_error;
+    option = WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_2;
+    if (!WinHttpSetOption(session, WINHTTP_OPTION_SECURE_PROTOCOLS, &option, sizeof(option))) goto win_error;
+    if (!(connection = WinHttpConnect(session, host, 443, 0))) goto win_error;
+    if (!(request = WinHttpOpenRequest(connection, method, path, NULL, NULL, WINHTTP_DEFAULT_ACCEPT_TYPES, WINHTTP_FLAG_SECURE))) goto win_error;
+    option = WINHTTP_OPTION_REDIRECT_POLICY_NEVER;
+    if (!WinHttpSetOption(request, WINHTTP_OPTION_REDIRECT_POLICY, &option, sizeof(option))) goto win_error;
+    if (!WinHttpSendRequest(request, headers, -1, (void *)body, bodySize, bodySize, 0) || !WinHttpReceiveResponse(request, NULL)) goto win_error;
+    length = sizeof(*status);
+    if (!WinHttpQueryHeaders(request, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER, NULL, status, &length, NULL)) goto win_error;
+    if (*status != 200) { hr = HRESULT_FROM_WIN32(ERROR_LOGON_FAILURE); goto done; }
+    for (;;)
+    {
+        if (!WinHttpReadData(request, chunk, sizeof(chunk), &got)) goto win_error;
+        if (!got) break;
+        if (*size + got > 1048576) { hr = HRESULT_FROM_WIN32(ERROR_FILE_TOO_LARGE); goto done; }
+        if (!(grown = realloc(*buffer, *size + got))) { hr = E_OUTOFMEMORY; goto done; }
+        *buffer = grown; memcpy(*buffer + *size, chunk, got); *size += got;
+    }
+    hr = S_OK;
+    goto done;
+win_error:
+    hr = HRESULT_FROM_WIN32(GetLastError());
+    if (SUCCEEDED(hr)) hr = E_FAIL;
+done:
+    if (request) WinHttpCloseHandle(request);
+    if (connection) WinHttpCloseHandle(connection);
+    if (session) WinHttpCloseHandle(session);
+    if (FAILED(hr)) { free(*buffer); *buffer = NULL; *size = 0; }
+    return hr;
+}
