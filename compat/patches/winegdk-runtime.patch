+    char account[65]={},request[768],extra[64]={};HRESULT hr=xodus_store_copy_account_context(owned,account);
+    if(FAILED(hr))return hr;
+    if(durable)snprintf(extra,sizeof(extra),"<DurableStoreId>%s</DurableStoreId>",durable);
+    int size=snprintf(request,sizeof(request),"<StoreGameLicenseRequest><Context>%s</Context><StoreId>%s</StoreId><PackageFamilyName>%s</PackageFamilyName><Market>%s</Market>%s</StoreGameLicenseRequest>",account,binding.storeId,binding.family,market,extra);
+    if(updates)size=snprintf(request,sizeof(request),"<StorePackageUpdatesRequest><Context>%s</Context><StoreId>%s</StoreId><PackageFamilyName>%s</PackageFamilyName><Market>%s</Market><Version>%s</Version><Scope>FlightdeckBaseGameOnlyV1</Scope></StorePackageUpdatesRequest>",account,binding.storeId,binding.family,market,binding.version);
+    SecureZeroMemory(account,sizeof(account));
