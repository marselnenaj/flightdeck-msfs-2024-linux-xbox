+done:
+    xmlFreeDoc(doc);return hr;
+}
+
+HRESULT publisher_family(const char *name,const char *publisher,char family[65]) {
+    static const char alphabet[]="0123456789abcdefghjkmnpqrstvwxyz";
+    BCRYPT_ALG_HANDLE algorithm=nullptr;BYTE digest[32];
+    if(!name||!publisher||strlen(name)<3||strlen(name)>50)return E_INVALIDARG;
+    for(const char *p=name;*p;++p)if(!((*p>='a'&&*p<='z')||(*p>='A'&&*p<='Z')||(*p>='0'&&*p<='9')||*p=='.'||*p=='-'))return E_INVALIDARG;
