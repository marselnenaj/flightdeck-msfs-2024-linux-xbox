+        if (FAILED(hr = user_publish_title_policy(titleBuffer, titleSize))) goto cleanup;
+    }
+    free_endpoints(impl->endpoints, impl->endpointsLen);
+    free_signing_policies(impl->policies, impl->policiesLen);
+    impl->endpoints = merged.endpoints;
+    impl->endpointsLen = merged.endpointCount;
+    impl->policies = merged.policies;
+    impl->policiesLen = merged.policyCount;
+    merged.endpoints = NULL;
+    merged.policies = NULL;
+    hr = S_OK;
+cleanup:
+    fprintf(stderr, "xodus-user-policy-cache: stage=%s hr=%08lx\n", stage, (ULONG)hr);
+    free(defaultBuffer);
+    free(titleBuffer);
+    free_signing_document(&defaults);
+    free_signing_document(&title);
+    free_signing_document(&merged);
