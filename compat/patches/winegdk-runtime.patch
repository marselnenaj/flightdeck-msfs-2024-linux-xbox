new file mode 100644
index 0000000..35266bc
--- /dev/null
+++ b/dlls/xgameruntime/GDKComponent/System/UserSessionCache.c
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#define COBJMACROS
+#include "UserSessionCache.h"
+
+static SRWLOCK cache_lock = SRWLOCK_INIT;
+static IUnknown *cached_user;
+static BOOL stopped;
+
+HRESULT xodus_default_user_get(IUnknown **out)
+{
+    HRESULT result;
+    if (!out) return E_POINTER;
+    *out = NULL;
+    AcquireSRWLockShared(&cache_lock);
+    if (stopped) result = E_ABORT;
+    else if (!cached_user) result = S_FALSE;
+    else
+    {
+        IUnknown_AddRef(cached_user);
+        *out = cached_user;
+        result = S_OK;
+    }
+    ReleaseSRWLockShared(&cache_lock);
+    return result;
+}
+
+HRESULT xodus_default_user_store(IUnknown *user)
+{
+    HRESULT result;
+    if (!user) return E_POINTER;
+    AcquireSRWLockExclusive(&cache_lock);
+    if (stopped) result = E_ABORT;
+    else if (cached_user) result = S_FALSE;
+    else
+    {
+        IUnknown_AddRef(user);
+        cached_user = user;
+        result = S_OK;
+    }
+    ReleaseSRWLockExclusive(&cache_lock);
+    return result;
+}
+
+BOOL xodus_default_user_stopped(void)
+{
+    BOOL result;
+    AcquireSRWLockShared(&cache_lock);
+    result = stopped;
+    ReleaseSRWLockShared(&cache_lock);
+    return result;
+}
+
+void xodus_default_user_shutdown(void)
+{
+    IUnknown *release;
+    AcquireSRWLockExclusive(&cache_lock);
+    stopped = TRUE;
+    release = cached_user;
+    cached_user = NULL;
+    ReleaseSRWLockExclusive(&cache_lock);
+    if (release) IUnknown_Release(release);
+}
