+struct signing_document
+{
+    struct xodus_signing_endpoint *endpoints;
+    UINT32 endpointCount;
+    struct xodus_signing_policy *policies;
+    UINT32 policyCount;
+};
+
+static void free_signing_document(struct signing_document *document)
+{
+    free_endpoints(document->endpoints, document->endpointCount);
+    free_signing_policies(document->policies, document->policyCount);
+    memset(document, 0, sizeof(*document));
+}
+
+static HRESULT signing_json_string(IJsonObject *object, const WCHAR *key, BOOL optional,
+        BOOL emptyAllowed, char **out)
+{
+    HSTRING value = NULL;
+    const WCHAR *text;
+    UINT32 length;
+    HRESULT hr;
+    *out = NULL;
+    hr = get_json_string(object, key, &value);
+    if (optional && hr == WEB_E_JSON_VALUE_NOT_FOUND) return S_OK;
+    if (FAILED(hr)) return hr;
+    text = WindowsGetStringRawBuffer(value, &length);
+    if (!length) hr = emptyAllowed ? S_OK : E_INVALIDARG;
+    else if (length > 8192) hr = E_INVALIDARG;
+    else
+    {
+        UINT32 i;
+        for (i = 0; i < length && text[i]; ++i) {}
+        hr = i == length ? HSTRINGToMultiByte(value, out) : E_INVALIDARG;
+    }
+    if (value) WindowsDeleteString(value);
+    return hr;
+}
+
+static HRESULT parse_signing_document(const UCHAR *buffer, SIZE_T size, BOOL authenticatedTitle,
+        UINT32 policyOffset, struct signing_document *document)
+{
+    IJsonObject *object = NULL, *child = NULL;
+    IJsonArray *array = NULL;
+    IVector_IJsonValue *vector = NULL;
+    char *tokenType = NULL;
+    HRESULT hr;
+    memset(document, 0, sizeof(*document));
+    if (!buffer || !size || size > 1024 * 1024 || memchr(buffer, 0, size)) return E_INVALIDARG;
+    if (FAILED(hr = parse_json((const char *)buffer, size, &object))) goto cleanup;
+    hr = get_json_array(object, L"SignaturePolicies", &array);
+    if (authenticatedTitle && hr == WEB_E_JSON_VALUE_NOT_FOUND) hr = S_OK;
+    else
+    {
+        if (FAILED(hr)) goto cleanup;
+        if (FAILED(hr = IJsonArray_QueryInterface(array, &IID_IVector_IJsonValue, (void **)&vector))) goto cleanup;
+        if (FAILED(hr = IVector_IJsonValue_get_Size(vector, &document->policyCount))) goto cleanup;
+        if (document->policyCount > 4096 || document->policyCount > UINT32_MAX - policyOffset)
+        { hr = E_INVALIDARG; goto cleanup; }
+        if (document->policyCount && !(document->policies = calloc(document->policyCount, sizeof(*document->policies))))
+        { hr = E_OUTOFMEMORY; goto cleanup; }
+        for (UINT32 i = 0; i < document->policyCount; ++i)
+        {
+            if (FAILED(hr = IJsonArray_GetObjectAt(array, i, &child))) goto cleanup;
+            if (FAILED(hr = parse_signing_policy(child, &document->policies[i]))) goto cleanup;
+            IJsonObject_Release(child);
+            child = NULL;
+        }
+        IVector_IJsonValue_Release(vector); vector = NULL;
+        IJsonArray_Release(array); array = NULL;
+    }
+    if (FAILED(hr = get_json_array(object, L"EndPoints", &array))) goto cleanup;
+    if (FAILED(hr = IJsonArray_QueryInterface(array, &IID_IVector_IJsonValue, (void **)&vector))) goto cleanup;
+    if (FAILED(hr = IVector_IJsonValue_get_Size(vector, &document->endpointCount))) goto cleanup;
+    if (document->endpointCount > 8192) { hr = E_INVALIDARG; goto cleanup; }
+    if (document->endpointCount && !(document->endpoints = calloc(document->endpointCount, sizeof(*document->endpoints))))
+    { hr = E_OUTOFMEMORY; goto cleanup; }
+    for (UINT32 i = 0; i < document->endpointCount; ++i)
+    {
+        struct xodus_signing_endpoint *endpoint = &document->endpoints[i];
+        DOUBLE policyIndex;
