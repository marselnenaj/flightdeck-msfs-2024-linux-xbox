+        if (FAILED(hr = signing_json_string(child, L"TokenType", TRUE, FALSE, &tokenType))) goto cleanup;
+        hr = get_json_number(child, L"SignaturePolicyIndex", &policyIndex);
+        if (SUCCEEDED(hr))
+        {
