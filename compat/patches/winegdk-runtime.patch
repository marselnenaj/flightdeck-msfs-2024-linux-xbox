diff --git a/dlls/xgameruntime/GDKComponent/Xodus/StoreLicenseTokenProvider.cpp b/dlls/xgameruntime/GDKComponent/Xodus/StoreLicenseTokenProvider.cpp
new file mode 100644
index 0000000..718a9e6
--- /dev/null
+++ b/dlls/xgameruntime/GDKComponent/Xodus/StoreLicenseTokenProvider.cpp
@@ -0,0 +1,163 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Opaque signed Store license token transport. Tokens and caller challenges
+ * never enter diagnostics. The broker returns the original Microsoft JWT. */
+#include "../../private.h"
+#include "Structs.h"
+#include "StoreLicenseProvider.h"
+#include "robuffer.h"
+#include <libxml/parser.h>
+#include <libxml/tree.h>
+#include <string>
+#include <new>
+
+using namespace ABI;
+using namespace ABI::Xodus;
+using namespace ABI::Windows::Foundation;
+using namespace ABI::Windows::Storage::Streams;
+namespace {
+struct SensitiveText {
+    std::string value;
+    ~SensitiveText(){if(!value.empty())SecureZeroMemory(&value[0],value.size());}
+};
+bool blank(const xmlChar *text) {
+    if(!text)return true;
+    for(;*text;++text)if(*text!=' '&&*text!='\t'&&*text!='\r'&&*text!='\n')return false;
+    return true;
+}
+const char *text_value(xmlNode *node) {
+    if(!node||node->ns||node->properties||!node->children||node->children->next||node->children->type!=XML_TEXT_NODE)return nullptr;
+    return reinterpret_cast<const char*>(node->children->content);
+}
+HRESULT status_error(const char *status) {
+    if(!strcmp(status,"Unavailable"))return HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+    if(!strcmp(status,"Expired"))return HRESULT_FROM_WIN32(ERROR_LOGON_FAILURE);
+    if(!strcmp(status,"NotLicensed"))return E_ACCESSDENIED;
+    if(!strcmp(status,"Unsupported"))return E_NOTIMPL;
+    if(!strcmp(status,"InvalidRequest"))return E_INVALIDARG;
+    if(!strcmp(status,"Error"))return E_FAIL;
+    if(!strcmp(status,"Timeout"))return HRESULT_FROM_WIN32(ERROR_TIMEOUT);
+    return HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+}
+bool compact_jwt(const char *value,SIZE_T length) {
+    unsigned dots=0;SIZE_T segment=0;
+    for(SIZE_T i=0;i<length;++i){
+        char c=value[i];
+        if(c=='.'){if(!segment||++dots>2)return false;segment=0;}
+        else if((c>='A'&&c<='Z')||(c>='a'&&c<='z')||(c>='0'&&c<='9')||c=='_'||c=='-')++segment;
+        else return false;
+    }
+    return dots==2&&segment;
+}
+HRESULT parse_token(const BYTE *bytes,UINT32 length,char **out,SIZE_T *size) {
+    *out=nullptr;*size=0;HRESULT hr=HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+    if(!bytes||!length||length>UINT16_MAX)return hr;
+    if(!bytes[length-1])--length;
+    if(!length||memchr(bytes,0,length))return hr;
+    xmlDoc *doc=xmlReadMemory(reinterpret_cast<const char*>(bytes),length,"store-token.xml","UTF-8",XML_PARSE_NONET|XML_PARSE_NOERROR|XML_PARSE_NOWARNING);
+    if(!doc)return hr;
+    xmlNode *root=xmlDocGetRootElement(doc);const char *status=nullptr,*token=nullptr;SIZE_T tokenLength=0;
+    if(doc->intSubset||doc->extSubset||!root||root->ns||root->properties||xmlStrcmp(root->name,BAD_CAST "StoreLicenseTokenResponse"))goto done;
+    for(xmlNode *node=root->children;node;node=node->next){
+        if(node->type==XML_TEXT_NODE&&blank(node->content))continue;
+        if(node->type!=XML_ELEMENT_NODE)goto done;
+        if(!xmlStrcmp(node->name,BAD_CAST "Status")){if(status||!(status=text_value(node)))goto done;}
+        else if(!xmlStrcmp(node->name,BAD_CAST "Token")){if(token||!(token=text_value(node)))goto done;}
+        else goto done;
+    }
+    if(!status)goto done;
+    if(strcmp(status,"Available")){if(!token)hr=status_error(status);goto done;}
+    if(!token||(tokenLength=strlen(token))>60000||!compact_jwt(token,tokenLength))goto done;
+    *out=static_cast<char*>(CoTaskMemAlloc(tokenLength+1));
+    if(!*out){hr=E_OUTOFMEMORY;goto done;}
+    memcpy(*out,token,tokenLength+1);*size=tokenLength+1;hr=S_OK;
+done:
+    xmlFreeDoc(doc);return hr;
+}
+void escape_xml(std::string &out,const char *text) {
+    for(;*text;++text)switch(*text){
+        case '&':out+="&amp;";break;case '<':out+="&lt;";break;case '>':out+="&gt;";break;
+        case '"':out+="&quot;";break;case '\'':out+="&apos;";break;
+        // Raw CR is normalized by XML parsers. A character reference preserves
+        // both standalone CR and the CR part of a CRLF caller challenge.
+        case '\r':out+="&#13;";break;default:out+=*text;
+    }
+}
+HRESULT wait_token_response(IAsyncOperation<IXodusIPCPacket*> *operation,volatile LONG *cancelled) {
+    ::IAsyncInfo *info=nullptr;HRESULT hr=operation->QueryInterface(__uuidof(::IAsyncInfo),reinterpret_cast<void**>(&info));
+    if(FAILED(hr))return hr;
+    AsyncStatus state=Started;ULONGLONG deadline=GetTickCount64()+46000;
+    while(SUCCEEDED(hr=info->get_Status(&state))&&state==Started){
+        if(InterlockedCompareExchange(cancelled,0,0)){hr=E_ABORT;break;}
+        if(GetTickCount64()>=deadline){hr=HRESULT_FROM_WIN32(ERROR_TIMEOUT);break;}
+        Sleep(10);
+    }
+    info->Release();return hr;
+}
+HRESULT exchange_token(const std::string &request,volatile LONG *cancelled,char **out,SIZE_T *size) {
+    const WCHAR *classText=RuntimeClass_Windows_Storage_Streams_Buffer;
+    IBufferFactory *factory=nullptr;IBuffer *message=nullptr,*reply=nullptr;
+    IBufferByteAccess *access=nullptr,*replyAccess=nullptr;
+    IXodusIPCPacket *packet=nullptr,*response=nullptr;
+    IAsyncOperation<IXodusIPCPacket*> *operation=nullptr;
+    BYTE *bytes=nullptr;UINT32 length=0;UINT16 kind=0;MagicHeaderType magic;
+    HSTRING_HEADER header;HSTRING className=nullptr;HRESULT hr;
+    HRESULT apartment=RoInitialize(RO_INIT_MULTITHREADED);
+    if(FAILED(apartment)&&apartment!=RPC_E_CHANGED_MODE)return apartment;
+    if(FAILED(hr=WindowsCreateStringReference(classText,wcslen(classText),&header,&className)))goto cleanup;
+    if(FAILED(hr=RoGetActivationFactory(className,__uuidof(IBufferFactory),reinterpret_cast<void**>(&factory))))goto cleanup;
+    if(FAILED(hr=factory->Create(request.size(),&message)))goto cleanup;
+    if(FAILED(hr=message->QueryInterface<IBufferByteAccess>(&access)))goto cleanup;
+    if(FAILED(hr=access->Buffer(&bytes)))goto cleanup;
+    memcpy(bytes,request.data(),request.size());
+    if(FAILED(hr=message->put_Length(request.size())))goto cleanup;
+    packet=new(std::nothrow)XodusIPCPacket(MagicHeaderType::XML,11,message);
+    if(!packet){hr=E_OUTOFMEMORY;goto cleanup;}
+    if(FAILED(hr=xodus_ipclayer->SendRequestAsync(packet,&operation)))goto cleanup;
+    if(FAILED(hr=wait_token_response(operation,cancelled)))goto cleanup;
+    if(FAILED(hr=operation->GetResults(&response)))goto cleanup;
+    if(!response){hr=E_UNEXPECTED;goto cleanup;}
+    if(FAILED(hr=response->get_Magic(&magic))||FAILED(hr=response->get_MessageType(&kind)))goto cleanup;
+    if(magic!=MagicHeaderType::XML||kind!=12){hr=HRESULT_FROM_WIN32(ERROR_INVALID_DATA);goto cleanup;}
+    if(FAILED(hr=response->get_Message(&reply)))goto cleanup;
+    if(!reply){hr=E_UNEXPECTED;goto cleanup;}
+    if(FAILED(hr=reply->get_Length(&length))||FAILED(hr=reply->QueryInterface<IBufferByteAccess>(&replyAccess))||FAILED(hr=replyAccess->Buffer(&bytes)))goto cleanup;
+    hr=parse_token(bytes,length,out,size);
+cleanup:
+    if(InterlockedCompareExchange(cancelled,0,0)){
+        if(*out){SecureZeroMemory(*out,*size);CoTaskMemFree(*out);*out=nullptr;*size=0;}
+        hr=E_ABORT;
+    }
+    if(replyAccess)replyAccess->Release();if(access)access->Release();
+    if(reply)reply->Release();if(message)message->Release();
+    if(response)response->Release();if(packet)packet->Release();if(operation)operation->Release();if(factory)factory->Release();
+    if(SUCCEEDED(apartment))RoUninitialize();return hr;
+}
+}
+extern "C" HRESULT WINAPI XodusStoreQueryLicenseToken(void *owned,const char *const *ids,SIZE_T count,
+    const char *custom,volatile LONG *cancelled,char **out,SIZE_T *size) {
+    if(out)*out=nullptr;if(size)*size=0;
+    if(!out||!size||!cancelled||(!ids&&count)||!custom)return E_POINTER;
+    if(count>100)return E_INVALIDARG;
+    SIZE_T length=strnlen(custom,8193);
+    if(!length||length>8192||!MultiByteToWideChar(CP_UTF8,MB_ERR_INVALID_CHARS,custom,length,nullptr,0))return E_INVALIDARG;
+    for(SIZE_T i=0;i<length;++i)if(static_cast<unsigned char>(custom[i])<32&&custom[i]!='\t'&&custom[i]!='\n'&&custom[i]!='\r')return E_INVALIDARG;
+    if(InterlockedCompareExchange(cancelled,0,0))return E_ABORT;
+    char storeId[13]{},account[65]{};HRESULT hr=xodus_store_copy_title_store_id(storeId);
+    if(FAILED(hr))return hr;
+    if(FAILED(hr=xodus_store_copy_account_context(owned,account)))return hr;
+    try {
+        SensitiveText request;request.value.reserve(512+length*6+count*40);
+        request.value="<StoreLicenseTokenRequest><Context>";request.value+=account;request.value+="</Context><StoreId>";
+        SecureZeroMemory(account,sizeof(account));request.value+=storeId;request.value+="</StoreId><ProductIds>";
+        for(SIZE_T i=0;i<count;++i){
+            if(!ids[i])return E_POINTER;
+            if(strnlen(ids[i],13)!=12)return E_INVALIDARG;
+            for(unsigned j=0;j<12;++j)if(!((ids[i][j]>='A'&&ids[i][j]<='Z')||(ids[i][j]>='0'&&ids[i][j]<='9')))return E_INVALIDARG;
+            request.value+="<ProductId>";request.value+=ids[i];request.value+="</ProductId>";
+        }
+        request.value+="</ProductIds><CustomDeveloperString>";escape_xml(request.value,custom);
+        request.value+="</CustomDeveloperString></StoreLicenseTokenRequest>";
+        if(request.value.size()>UINT16_MAX)return HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
+        return exchange_token(request.value,cancelled,out,size);
+    } catch(const std::bad_alloc&) {SecureZeroMemory(account,sizeof(account));return E_OUTOFMEMORY;}
+}
diff --git a/dlls/xgameruntime/GDKComponent/Xodus/StoreProvider.cpp b/dlls/xgameruntime/GDKComponent/Xodus/StoreProvider.cpp
new file mode 100644
index 0000000..fe0b7e9
--- /dev/null
+++ b/dlls/xgameruntime/GDKComponent/Xodus/StoreProvider.cpp
@@ -0,0 +1,201 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Isolated read-only Store account context provider. No purchase/license API. */
+#include "../../private.h"
+#include "Structs.h"
+#include "StoreLicenseProvider.h"
+#include "robuffer.h"
+#include <libxml/parser.h>
+#include <libxml/tree.h>
+#include <new>
+
+using namespace ABI;
+using namespace ABI::Xodus;
+using namespace ABI::Windows::Foundation;
+using namespace ABI::Windows::Storage::Streams;
+
+namespace
+{
+struct StoreAccount
+{
+    char context[65];
+    StoreAccount *next;
+};
+SRWLOCK accountsLock = SRWLOCK_INIT;
+StoreAccount *accounts;
+
+bool whitespace(const xmlChar *text)
+{
+    if (!text) return true;
+    for (; *text; ++text)
+        if (*text != ' ' && *text != '\t' && *text != '\r' && *text != '\n') return false;
+    return true;
+}
+
+const char *plain_text(xmlNode *node)
+{
+    if (!node || node->properties || node->ns || !node->children || node->children->next ||
+        node->children->type != XML_TEXT_NODE) return nullptr;
+    return reinterpret_cast<const char *>(node->children->content);
+}
+
+HRESULT parse_account(const BYTE *bytes, UINT32 length, char context[65])
+{
+    HRESULT hr = HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+    xmlNode *statusNode = nullptr, *contextNode = nullptr;
+    const char *status = nullptr, *value = nullptr;
+    xmlDoc *document = nullptr;
+    context[0] = 0;
+    if (!bytes || !length || length > 4096) return hr;
+    if (!bytes[length - 1]) --length;
+    if (!length || memchr(bytes, 0, length)) return hr;
+    document = xmlReadMemory(reinterpret_cast<const char *>(bytes), length, "store-account.xml", "UTF-8",
+        XML_PARSE_NONET | XML_PARSE_NOERROR | XML_PARSE_NOWARNING);
+    if (!document) return hr;
+    xmlNode *root = xmlDocGetRootElement(document);
+    if (document->intSubset || document->extSubset || !root || root->ns || root->properties ||
+        xmlStrcmp(root->name, BAD_CAST "StoreAccountContextResponse")) goto cleanup;
+    for (xmlNode *node = root->children; node; node = node->next)
+    {
+        if (node->type == XML_TEXT_NODE && whitespace(node->content)) continue;
+        if (node->type != XML_ELEMENT_NODE || node->ns || node->properties) goto cleanup;
+        if (!xmlStrcmp(node->name, BAD_CAST "Status") && !statusNode) statusNode = node;
+        else if (!xmlStrcmp(node->name, BAD_CAST "Context") && !contextNode) contextNode = node;
+        else goto cleanup;
+    }
+    status = plain_text(statusNode);
+    if (!status) goto cleanup;
+    if (!strcmp(status, "Available"))
+    {
+        value = plain_text(contextNode);
+        if (!value || strlen(value) != 64) goto cleanup;
+        for (unsigned i = 0; i < 64; ++i)
+            if (!((value[i] >= '0' && value[i] <= '9') || (value[i] >= 'a' && value[i] <= 'f'))) goto cleanup;
+        memcpy(context, value, 65);
+        hr = S_OK;
+    }
+    else if (!contextNode && !strcmp(status, "Unavailable")) hr = HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+    else if (!contextNode && !strcmp(status, "Expired")) hr = HRESULT_FROM_WIN32(ERROR_LOGON_FAILURE);
+cleanup:
+    xmlFreeDoc(document);
+    return hr;
+}
+
+HRESULT wait_for_response(IAsyncOperation<IXodusIPCPacket *> *operation)
+{
+    ::IAsyncInfo *info = nullptr;
+    if (!operation) return E_UNEXPECTED;
+    HRESULT hr = operation->QueryInterface(__uuidof(::IAsyncInfo), reinterpret_cast<void **>(&info));
+    if (FAILED(hr)) return hr;
+    AsyncStatus status = Started;
+    ULONGLONG deadline = GetTickCount64() + IPC_REQUEST_TIMEOUT_MS + 1000;
+    while (SUCCEEDED(hr = info->get_Status(&status)) && status == Started && GetTickCount64() < deadline) Sleep(1);
+    if (SUCCEEDED(hr) && status == Started) hr = HRESULT_FROM_WIN32(ERROR_TIMEOUT);
+    info->Release();
+    return hr;
+}
+}
+
+extern "C" HRESULT WINAPI XodusStoreAcquireAccount(void **owned)
+{
+    static const char requestXml[] = "<StoreAccountContextRequest/>";
+    IBufferByteAccess *requestAccess = nullptr, *responseAccess = nullptr;
+    IXodusIPCPacket *requestPacket = nullptr, *responsePacket = nullptr;
+    IBuffer *requestMessage = nullptr, *responseMessage = nullptr;
+    IAsyncOperation<IXodusIPCPacket *> *operation = nullptr;
+    IBufferFactory *factory = nullptr;
+    HSTRING_HEADER nameHeader;
+    HSTRING name = nullptr;
+    BYTE *buffer = nullptr;
+    UINT32 length = 0;
+    UINT16 messageType = 0;
+    MagicHeaderType magic;
+    StoreAccount *account = nullptr;
+    char context[65] = {};
+    HRESULT hr, apartment;
+    if (!owned) return E_POINTER;
+    *owned = nullptr;
+    apartment = RoInitialize(RO_INIT_MULTITHREADED);
+    if (FAILED(apartment) && apartment != RPC_E_CHANGED_MODE) return apartment;
+
+    if (FAILED(hr = WindowsCreateStringReference(RuntimeClass_Windows_Storage_Streams_Buffer,
+        wcslen(RuntimeClass_Windows_Storage_Streams_Buffer), &nameHeader, &name))) goto cleanup;
+    if (FAILED(hr = RoGetActivationFactory(name, __uuidof(IBufferFactory), reinterpret_cast<void **>(&factory)))) goto cleanup;
+    if (FAILED(hr = factory->Create(sizeof(requestXml), &requestMessage))) goto cleanup;
+    if (FAILED(hr = requestMessage->QueryInterface<IBufferByteAccess>(&requestAccess))) goto cleanup;
+    if (FAILED(hr = requestAccess->Buffer(&buffer))) goto cleanup;
+    if (FAILED(hr = requestMessage->put_Length(sizeof(requestXml)))) goto cleanup;
+    memcpy(buffer, requestXml, sizeof(requestXml));
+    requestPacket = new (std::nothrow) XodusIPCPacket(MagicHeaderType::XML, 5, requestMessage);
+    if (!requestPacket) { hr = E_OUTOFMEMORY; goto cleanup; }
+    if (FAILED(hr = xodus_ipclayer->SendRequestAsync(requestPacket, &operation))) goto cleanup;
+    if (FAILED(hr = wait_for_response(operation))) goto cleanup;
+    if (FAILED(hr = operation->GetResults(&responsePacket))) goto cleanup;
+    if (!responsePacket) { hr = E_UNEXPECTED; goto cleanup; }
+    if (FAILED(hr = responsePacket->get_Magic(&magic))) goto cleanup;
+    if (FAILED(hr = responsePacket->get_MessageType(&messageType))) goto cleanup;
+    if (magic != MagicHeaderType::XML || messageType != 6) { hr = HRESULT_FROM_WIN32(ERROR_INVALID_DATA); goto cleanup; }
+    if (FAILED(hr = responsePacket->get_Message(&responseMessage))) goto cleanup;
+    if (!responseMessage) { hr = E_UNEXPECTED; goto cleanup; }
+    if (FAILED(hr = responseMessage->get_Length(&length))) goto cleanup;
+    if (FAILED(hr = responseMessage->QueryInterface<IBufferByteAccess>(&responseAccess))) goto cleanup;
+    if (FAILED(hr = responseAccess->Buffer(&buffer))) goto cleanup;
+    if (FAILED(hr = parse_account(buffer, length, context))) goto cleanup;
+    account = new (std::nothrow) StoreAccount;
+    if (!account) { hr = E_OUTOFMEMORY; goto cleanup; }
+    memcpy(account->context, context, sizeof(context));
+    AcquireSRWLockExclusive(&accountsLock);
+    account->next = accounts;
+    accounts = account;
+    ReleaseSRWLockExclusive(&accountsLock);
+    *owned = account;
+    hr = S_OK;
+cleanup:
+    SecureZeroMemory(context, sizeof(context));
+    if (responseAccess) responseAccess->Release();
+    if (requestAccess) requestAccess->Release();
+    if (responseMessage) responseMessage->Release();
+    if (requestMessage) requestMessage->Release();
+    if (responsePacket) responsePacket->Release();
+    if (requestPacket) requestPacket->Release();
+    if (operation) operation->Release();
+    if (factory) factory->Release();
+    if (SUCCEEDED(apartment)) RoUninitialize();
+    return hr;
+}
+
+extern "C" void WINAPI XodusStoreReleaseAccount(void *owned)
+{
+    StoreAccount *account = nullptr;
+    if (!owned) return;
+    AcquireSRWLockExclusive(&accountsLock);
+    for (StoreAccount **cursor = &accounts; *cursor; cursor = &(*cursor)->next)
+    {
+        if (*cursor != owned) continue;
+        account = *cursor;
+        *cursor = account->next;
+        break;
+    }
+    ReleaseSRWLockExclusive(&accountsLock);
+    if (account)
+    {
+        SecureZeroMemory(account, sizeof(*account));
+        delete account;
+    }
+}
+
+extern "C" HRESULT xodus_store_copy_account_context(void *owned, char output[65])
+{
+    if (!output) return E_POINTER;
+    output[0] = 0;
+    HRESULT hr = E_HANDLE;
