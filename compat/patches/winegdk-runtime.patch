diff --git a/dlls/xgameruntime/GDKComponent/System/TitleAuthentication.inc b/dlls/xgameruntime/GDKComponent/System/TitleAuthentication.inc
new file mode 100644
index 0000000..8325f2a
--- /dev/null
+++ b/dlls/xgameruntime/GDKComponent/System/TitleAuthentication.inc
@@ -0,0 +1,202 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Private local compatibility implementation. All tokens originate at Microsoft;
+ * the existing native P-256 key signs every step of the title/device flow. */
+#include "TitleAuthHttp.h"
+
+static HRESULT auth_json_quote(const char *text, char **out)
+{
+    SIZE_T length, at = 0;
+    static const char hex[] = "0123456789abcdef";
+    *out = NULL;
+    if (!text || (length = strlen(text)) > 262144) return E_INVALIDARG;
+    if (!(*out = malloc(length * 6 + 3))) return E_OUTOFMEMORY;
+    (*out)[at++] = '"';
+    for (SIZE_T i = 0; i < length; ++i)
+    {
+        unsigned char ch = text[i];
+        if (ch == '"' || ch == '\\') { (*out)[at++] = '\\'; (*out)[at++] = ch; }
+        else if (ch < 0x20)
+        {
+            memcpy(*out + at, "\\u00", 4); at += 4;
+            (*out)[at++] = hex[ch >> 4]; (*out)[at++] = hex[ch & 15];
+        }
+        else (*out)[at++] = ch;
+    }
+    (*out)[at++] = '"'; (*out)[at] = 0;
+    return S_OK;
+}
+
+static HRESULT auth_quote_hstring(HSTRING text, char **out)
+{
+    char *utf8 = NULL;
+    HRESULT hr = HSTRINGToMultiByte(text, &utf8);
+    *out = NULL;
+    if (SUCCEEDED(hr)) hr = auth_json_quote(utf8, out);
+    free(utf8);
+    return hr;
+}
+
+/* The public default *.xboxlive.com policy specifies version 1 / ES256,
+ * 8192 body bytes, no additional headers. Only fixed bootstrap hosts use it. */
+static HRESULT user_authenticated_http(struct XUser *impl, const char *method,
+    const char *host, const char *path, const char *body, const char *authorization,
+    UCHAR **buffer, SIZE_T *size)
+{
+    const struct xodus_signing_policy bootstrap = {1, 8192, TRUE, 0, NULL};
+    struct xodus_signing_request packed = {0};
+    WCHAR whost[64], wpath[128], wmethod[8], *headers = NULL;
+    char url[256], signature[105] = {0}, *text = NULL;
+    BYTE raw[76]; FILETIME now;
+    DWORD status = 0;
+    SIZE_T bodySize = body ? strlen(body) : 0, headerSize;
+    HRESULT hr = E_INVALIDARG;
+    *buffer = NULL; *size = 0;
+    if (!impl->key || !method || !host || !path || bodySize > 1048576) return hr;
+    if (strcmp(host, "device.auth.xboxlive.com") && strcmp(host, "title.auth.xboxlive.com") &&
+        strcmp(host, "user.auth.xboxlive.com") && strcmp(host, "xsts.auth.xboxlive.com") &&
+        strcmp(host, "title.mgt.xboxlive.com")) return hr;
+    if (snprintf(url, sizeof(url), "https://%s%s", host, path) >= sizeof(url)) return hr;
+    if (!MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, host, -1, whost, ARRAY_SIZE(whost)) ||
+        !MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1, wpath, ARRAY_SIZE(wpath)) ||
+        !MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, method, -1, wmethod, ARRAY_SIZE(wmethod))) return hr;
+    GetSystemTimeAsFileTime(&now);
+    hr = xodus_pack_signing_request(&bootstrap, method, url, authorization ? authorization : "",
+        0, NULL, bodySize, body, &now, &packed);
+    if (FAILED(hr)) goto done;
+    memcpy(raw, packed.signaturePrefix, 12);
+    if (FAILED(hr = IUser_SignData(&impl->IUser_iface, packed.size, packed.bytes, 64, raw + 12))) goto done;
+    if (FAILED(hr = encode_base64(76, raw, 104, signature, TRUE))) goto done;
+    headerSize = (authorization ? strlen(authorization) : 0) + 256;
+    if (!(text = malloc(headerSize)) || !(headers = calloc(headerSize, sizeof(WCHAR)))) { hr = E_OUTOFMEMORY; goto done; }
+    snprintf(text, headerSize, "Content-Type: application/json\r\nAccept: application/json\r\nx-xbl-contract-version: 1\r\nSignature: %s\r\n%s%s%s",
+        signature, authorization ? "Authorization: " : "", authorization ? authorization : "", authorization ? "\r\n" : "");
+    if (!MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, text, -1, headers, headerSize)) goto win_error;
+    hr = xodus_title_auth_http(wmethod, whost, wpath, body, headers, buffer, size, &status);
+    if (status) fprintf(stderr, "xodus-title-auth: host=%s status=%lu\n", host, status);
+    goto done;
+win_error:
+    hr = HRESULT_FROM_WIN32(GetLastError());
+    if (SUCCEEDED(hr)) hr = E_FAIL;
+done:
+    free(packed.bytes); free(text); free(headers);
+    if (FAILED(hr)) { free(*buffer); *buffer = NULL; *size = 0; }
+    return hr;
+}
+
+static HRESULT auth_response_token(IJsonObject *object, HSTRING *token, UINT64 *expiry)
+{
+    HSTRING expiration = NULL, fresh = NULL;
+    UINT32 length;
+    const WCHAR *value;
+    HRESULT hr = get_json_string(object, L"Token", &fresh);
+    if (FAILED(hr)) goto done;
+    if (!WindowsGetStringLen(fresh)) { hr = HRESULT_FROM_WIN32(ERROR_INVALID_DATA); goto done; }
+    if (FAILED(hr = get_json_string(object, L"NotAfter", &expiration))) goto done;
+    value = WindowsGetStringRawBuffer(expiration, &length);
+    if (FAILED(hr = privilege_parse_not_after(value, length, expiry))) goto done;
+    if (*expiry <= privilege_utc_now()) { hr = HRESULT_FROM_WIN32(ERROR_LOGON_FAILURE); goto done; }
+    if (*token) WindowsDeleteString(*token);
+    *token = fresh; fresh = NULL;
+done:
+    if (fresh) WindowsDeleteString(fresh);
+    if (expiration) WindowsDeleteString(expiration);
+    return hr;
+}
+
+static HRESULT user_request_device_and_title(struct XUser *impl)
+{
+    char *quoted = NULL, *body = NULL;
+    UCHAR *buffer = NULL;
+    SIZE_T size, capacity;
+    IJsonObject *object = NULL, *claims = NULL, *title = NULL;
+    HSTRING id = NULL;
+    DOUBLE number;
+    HRESULT hr;
+    if (!titleId || !impl->deviceRps || impl->deviceRpsExpires <= privilege_utc_now())
+        return HRESULT_FROM_WIN32(ERROR_LOGON_FAILURE);
+    if (FAILED(hr = auth_quote_hstring(impl->deviceRps, &quoted))) goto done;
+    capacity = strlen(quoted) + PROOF_KEY_SIZE + 512;
+    if (!(body = malloc(capacity))) { hr = E_OUTOFMEMORY; goto done; }
+    snprintf(body, capacity, "{\"RelyingParty\":\"http://auth.xboxlive.com\",\"TokenType\":\"JWT\",\"Properties\":{\"AuthMethod\":\"RPS\",\"RpsTicket\":%s,\"SiteName\":\"user.auth.xboxlive.com\",\"Version\":\"10.0.22621\",\"ProofKey\":%.*s}}",
+        quoted, (int)PROOF_KEY_SIZE, impl->proofKey);
+    hr = user_authenticated_http(impl, "POST", "device.auth.xboxlive.com", "/device/authenticate", body, NULL, &buffer, &size);
+    if (FAILED(hr) || FAILED(hr = parse_json((char *)buffer, size, &object)) ||
+        FAILED(hr = auth_response_token(object, &impl->deviceToken, &impl->deviceTokenExpires))) goto done;
+    free(buffer); buffer = NULL; free(body); body = NULL; free(quoted); quoted = NULL;
+    IJsonObject_Release(object); object = NULL;
+    if (FAILED(hr = auth_quote_hstring(impl->deviceToken, &quoted))) goto done;
+    capacity = strlen(quoted) + PROOF_KEY_SIZE + 256;
+    if (!(body = malloc(capacity))) { hr = E_OUTOFMEMORY; goto done; }
+    snprintf(body, capacity, "{\"RelyingParty\":\"http://auth.xboxlive.com\",\"TokenType\":\"JWT\",\"Properties\":{\"DeviceToken\":%s,\"TitleId\":%u,\"ProofKey\":%.*s}}",
+        quoted, titleId, (int)PROOF_KEY_SIZE, impl->proofKey);
+    hr = user_authenticated_http(impl, "POST", "title.auth.xboxlive.com", "/title/authenticate", body, NULL, &buffer, &size);
+    if (FAILED(hr) || FAILED(hr = parse_json((char *)buffer, size, &object))) goto done;
+    if (FAILED(hr = get_json_object(object, L"DisplayClaims", &claims)) ||
+        FAILED(hr = get_json_object(claims, L"xti", &title))) goto done;
+    hr = get_json_string(title, L"tid", &id);
+    if (SUCCEEDED(hr)) hr = xuid_decimal_matches(id, titleId) ? S_OK : HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+    else if (SUCCEEDED(hr = get_json_number(title, L"tid", &number)))
+        hr = number == titleId ? S_OK : HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+    if (FAILED(hr)) goto done;
+    hr = auth_response_token(object, &impl->titleToken, &impl->titleTokenExpires);
+    if (SUCCEEDED(hr)) impl->titleAuthenticated = TRUE;
+done:
+    if (id) WindowsDeleteString(id);
+    if (title) IJsonObject_Release(title);
+    if (claims) IJsonObject_Release(claims);
+    if (object) IJsonObject_Release(object);
+    free(buffer); free(body); free(quoted);
+    fprintf(stderr, "xodus-title-auth: title_verified=%u hr=%08lx\n", impl->titleAuthenticated, (ULONG)hr);
+    return hr;
+}
+
+static HRESULT user_xsts_body(struct XUser *impl, const char *rp, char **body)
+{
+    char *relying = NULL, *user = NULL, *device = NULL, *title = NULL;
+    SIZE_T capacity;
+    HRESULT hr;
+    *body = NULL;
+    if (FAILED(hr = auth_json_quote(rp, &relying)) || FAILED(hr = auth_quote_hstring(impl->userToken, &user))) goto done;
+    if (impl->titleAuthenticated)
+    {
+        if (impl->userTokenExpires <= privilege_utc_now() || impl->deviceTokenExpires <= privilege_utc_now() || impl->titleTokenExpires <= privilege_utc_now())
+        { hr = HRESULT_FROM_WIN32(ERROR_LOGON_FAILURE); goto done; }
+        if (FAILED(hr = auth_quote_hstring(impl->deviceToken, &device)) || FAILED(hr = auth_quote_hstring(impl->titleToken, &title))) goto done;
+    }
+    capacity = strlen(relying) + strlen(user) + PROOF_KEY_SIZE + (device ? strlen(device) : 0) + (title ? strlen(title) : 0) + 256;
+    if (!(*body = malloc(capacity))) { hr = E_OUTOFMEMORY; goto done; }
+    /* The genuine Device+Title path binds the key via its signed tokens. The
+     * user-only legacy path retains its original explicit ProofKey property. */
+    if (impl->titleAuthenticated)
+        snprintf(*body, capacity, "{\"RelyingParty\":%s,\"TokenType\":\"JWT\",\"Properties\":{\"SandboxId\":\"RETAIL\",\"DeviceToken\":%s,\"TitleToken\":%s,\"UserTokens\":[%s]}}", relying, device, title, user);
+    else
+        snprintf(*body, capacity, "{\"RelyingParty\":%s,\"TokenType\":\"JWT\",\"Properties\":{\"SandboxId\":\"RETAIL\",\"ProofKey\":%.*s,\"UserTokens\":[%s]}}", relying, (int)PROOF_KEY_SIZE, impl->proofKey, user);
+    hr = S_OK;
+done:
+    free(relying); free(user); free(device); free(title);
+    return hr;
+}
+
+static HRESULT user_fetch_title_policy(struct XUser *impl, UCHAR **buffer, SIZE_T *size)
+{
+    char *hash = NULL, *token = NULL, *auth = NULL;
+    HRESULT hr;
+    *buffer = NULL; *size = 0;
+    if (!impl->titleAuthenticated || !impl->xstsRelyingParty || strcmp(impl->xstsRelyingParty, "http://xboxlive.com"))
+        return E_NOTIMPL;
+    if (FAILED(hr = HSTRINGToMultiByte(impl->userHash, &hash)) || FAILED(hr = HSTRINGToMultiByte(impl->xstsToken, &token))) goto done;
+    if (!(auth = malloc(strlen(hash) + strlen(token) + 16))) { hr = E_OUTOFMEMORY; goto done; }
+    sprintf(auth, "XBL3.0 x=%s;%s", hash, token);
+    hr = user_authenticated_http(impl, "GET", "title.mgt.xboxlive.com", "/titles/current/endpoints", NULL, auth, buffer, size);
+done:
+    free(hash); free(token); free(auth);
+    return hr;
+}
+
+static HRESULT user_publish_title_policy(const UCHAR *json, SIZE_T size)
+{
+    typedef HRESULT (WINAPI *publish_fn)(UINT32, const char *, SIZE_T);
+    HMODULE runtime = GetModuleHandleW(L"xgameruntime.dll");
+    publish_fn publish = runtime ? (publish_fn)GetProcAddress(runtime, "XodusPublishTitleEndpointPolicy") : NULL;
+    return publish ? publish(titleId, (const char *)json, size) : HRESULT_FROM_WIN32(ERROR_PROC_NOT_FOUND);
+}
