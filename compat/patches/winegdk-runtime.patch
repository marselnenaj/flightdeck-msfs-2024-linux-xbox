+HRESULT WINAPI InitializeApiImplEx2(ULONG gdkVer, ULONG gsVer, CHAR mode, INITIALIZE_OPTIONS *options)
+{
+    HRESULT hr;
+    NTSTATUS nts;
+    HMODULE pinned;
+    CHAR socket_suffix[108];
+    LPCSTR suffix = XODUS_SOCKET_SUFFIX;
+    DWORD length;
+    IAsyncAction *ping = NULL;
+    IAsyncInfo *info = NULL;
+    AsyncStatus status = Started;
+    ULONGLONG deadline;
+    AcquireSRWLockExclusive(&runtime_lock);
+    if (initializeCalled) { hr = S_OK; goto done; }
+    if (shutdown_called || !bound_threading) { hr = E_UNEXPECTED; goto done; }
+    if (FAILED(hr = load_game_config(options))) goto done;
+    /* Async work and retained queue callbacks can outlive title shutdown. */
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+                          (LPCWSTR)InitializeApiImplEx2, &pinned))
+    { hr = HRESULT_FROM_WIN32(GetLastError()); goto done; }
+    length = GetEnvironmentVariableA("XODUS_USER_SOCKET_SUFFIX", socket_suffix, sizeof(socket_suffix));
+    if (length >= sizeof(socket_suffix)) { hr = HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER); goto done; }
+    if (length) suffix = socket_suffix;
+    nts = __wine_init_unix_call();
+    if (FAILED(nts)) { hr = HRESULT_FROM_NT(nts); goto done; }
+    unixhandle = __wine_unixlib_handle;
+    nts = __wine_unix_call(unixhandle, conn_socket, (void *)suffix);
+    if (FAILED(nts)) { hr = HRESULT_FROM_NT(nts); goto done; }
+    if (FAILED(hr = IIPCLayer_InitializeSocket(xodus_ipclayer))) goto failed_ipc;
+    if (FAILED(hr = IXodusService_Ping(xodus_service, &ping))) goto failed_ipc;
+    if (FAILED(hr = IAsyncAction_QueryInterface(ping, &IID_IAsyncInfo, (void **)&info))) goto failed_ipc;
+    deadline = GetTickCount64() + IPC_REQUEST_TIMEOUT_MS + 1000;
+    while (SUCCEEDED(hr = IAsyncInfo_get_Status(info, &status)) && status == Started && GetTickCount64() < deadline)
+        Sleep(1);
+    if (FAILED(hr)) goto failed_ipc;
+    if (status == Started) { hr = HRESULT_FROM_WIN32(ERROR_TIMEOUT); goto failed_ipc; }
+    if (FAILED(hr = IAsyncAction_GetResults(ping))) goto failed_ipc;
+    initializeCalled = TRUE;
+    goto done;
+failed_ipc:
+    xodus_ipc_shutdown();
+done:
