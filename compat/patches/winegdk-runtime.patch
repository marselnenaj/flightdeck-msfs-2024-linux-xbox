+    if (async)
+    {
+        hr = FAILED((HRESULT)async) ? (HRESULT)async : HRESULT_FROM_WIN32(async == WAIT_TIMEOUT ? ERROR_TIMEOUT : ERROR_OPERATION_ABORTED);
+        goto load_failed;
