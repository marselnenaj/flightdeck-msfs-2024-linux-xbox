+    stage = "msa_result";
+    if (FAILED(hr = IAsyncOperation_IMsaTokenResponse_GetResults(operation, &response))) goto load_failed;
+    stage = "msa_token_property";
+    if (FAILED(hr = IMsaTokenResponse_get_Token(response, &access_token))) goto load_failed;
+    stage = "msa_device_property";
+    hr = IMsaTokenResponse_get_DeviceRps(response, &device_rps);
+    if (FAILED(hr) && hr != HRESULT_FROM_WIN32(ERROR_NOT_FOUND)) goto load_failed;
