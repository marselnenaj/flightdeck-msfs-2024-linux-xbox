+    if(count<5||count>8193)return E_INVALIDARG;
+    WCHAR *wide=new(std::nothrow)WCHAR[count];if(!wide)return E_OUTOFMEMORY;
+    if(!MultiByteToWideChar(CP_UTF8,MB_ERR_INVALID_CHARS,publisher,-1,wide,count)){delete[]wide;return E_INVALIDARG;}
+    NTSTATUS status=BCryptOpenAlgorithmProvider(&algorithm,BCRYPT_SHA256_ALGORITHM,nullptr,0);
+    if(SUCCEEDED(status))status=BCryptHash(algorithm,nullptr,0,reinterpret_cast<BYTE*>(wide),(count-1)*sizeof(WCHAR),digest,sizeof(digest));
+    delete[]wide;if(algorithm)BCryptCloseAlgorithmProvider(algorithm,0);
+    if(FAILED(status))return HRESULT_FROM_NT(status);
+    SIZE_T offset=strlen(name);memcpy(family,name,offset);family[offset++]='_';
+    for(unsigned group=0;group<13;++group){unsigned index=0;for(unsigned bit=0;bit<5;++bit){unsigned at=group*5+bit;index=(index<<1)|(at<64?((digest[at/8]>>(7-at%8))&1):0);}family[offset++]=alphabet[index];}
+    family[offset]=0;return S_OK;
+}
+HRESULT wait_response(IAsyncOperation<IXodusIPCPacket*> *operation,volatile LONG *cancelled) {
+    ::IAsyncInfo *info=nullptr;HRESULT hr=operation->QueryInterface(__uuidof(::IAsyncInfo),reinterpret_cast<void**>(&info));
+    if(FAILED(hr))return hr;
+    AsyncStatus state=Started;ULONGLONG deadline=GetTickCount64()+46000;
+    while(SUCCEEDED(hr=info->get_Status(&state))&&state==Started){
+        if(InterlockedCompareExchange(cancelled,0,0)){hr=E_ABORT;break;}
+        if(GetTickCount64()>=deadline){hr=HRESULT_FROM_WIN32(ERROR_TIMEOUT);break;}
+        Sleep(10);
+    }
+    info->Release();return hr;
+}
+}
+
+extern "C" HRESULT xodus_store_configure_title_xml(void *opaque) {
+    xmlDoc *doc=static_cast<xmlDoc*>(opaque);xmlNode *root=xmlDocGetRootElement(doc);
+    const char *storeId=nullptr;xmlChar *name=nullptr,*publisher=nullptr,*version=nullptr;TitleBinding parsed{};
+    bool sawStoreId=false,sawIdentity=false;
+    HRESULT hr=S_FALSE;
+    for(xmlNode *node=root?root->children:nullptr;node;node=node->next){
+        if(node->type!=XML_ELEMENT_NODE)continue;
+        if(!xmlStrcmp(node->name,BAD_CAST "StoreId")){
+            if(sawStoreId){hr=E_INVALIDARG;goto done;}
+            sawStoreId=true;storeId=text_of(node);
+            if(!storeId){hr=E_INVALIDARG;goto done;}
+        }
+        if(!xmlStrcmp(node->name,BAD_CAST "Identity")){
+            if(sawIdentity){hr=E_INVALIDARG;goto done;}
+            sawIdentity=true;
+            name=xmlGetProp(node,BAD_CAST "Name");publisher=xmlGetProp(node,BAD_CAST "Publisher");
+            version=xmlGetProp(node,BAD_CAST "Version");
+        }
+    }
+    if(!storeId||!name||!publisher)goto done;
+    if(!upper_alnum(storeId,12)){hr=E_INVALIDARG;goto done;}
+    hr=publisher_family(reinterpret_cast<const char*>(name),reinterpret_cast<const char*>(publisher),parsed.family);
+    if(SUCCEEDED(hr)) {
+        memcpy(parsed.storeId,storeId,13);
+        if(version&&strlen(reinterpret_cast<const char*>(version))<sizeof(parsed.version)) {
+            const char *v=reinterpret_cast<const char*>(version);unsigned fields=0;bool valid=true;
+            while(*v&&valid) {
+                unsigned value=0,digits=0;
+                while(*v>='0'&&*v<='9'){value=value*10+(*v++-'0');if(++digits>5||value>65535){valid=false;break;}}
+                if(!digits||++fields>4)valid=false;
+                if(*v=='.'){++v;if(!*v)valid=false;}else if(*v)valid=false;
+            }
+            if(valid&&fields==4)strcpy(parsed.version,reinterpret_cast<const char*>(version));
+        }
+    }
+done:
+    if(name)xmlFree(name);if(publisher)xmlFree(publisher);if(version)xmlFree(version);
+    AcquireSRWLockExclusive(&titleLock);title=SUCCEEDED(hr)&&hr!=S_FALSE?parsed:TitleBinding{};ReleaseSRWLockExclusive(&titleLock);
+    return hr;
+}
+
+extern "C" HRESULT xodus_store_copy_title_store_id(char output[13]) {
+    if(!output)return E_POINTER;
+    AcquireSRWLockShared(&titleLock);memcpy(output,title.storeId,13);ReleaseSRWLockShared(&titleLock);
+    return *output?S_OK:E_NOTIMPL;
+}
+
+static HRESULT query_license(void *owned,const char *durable,volatile LONG *cancelled,void *output,bool updates=false) {
+    const WCHAR *classText=RuntimeClass_Windows_Storage_Streams_Buffer;
+    auto out=static_cast<GameLicense*>(output);
+    if(out)memset(out,0,sizeof(*out));
+    if(!out||!cancelled)return E_POINTER;
+    if(durable&&!upper_alnum(durable,12))return E_INVALIDARG;
