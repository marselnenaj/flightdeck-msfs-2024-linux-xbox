+        goto done;
+    }
+    if (InterlockedCompareExchange(&context->cancelled, 0, 0)) { hr = E_ABORT; goto done; }
+    stage = "default_cache_store";
+    stored = xodus_default_user_store((IUnknown *)&loaded->IUser_iface);
+    if (FAILED(stored)) { hr = stored; goto done; }
+    if (stored == S_FALSE)
+    {
+        hr = xodus_default_user_get(&cached);
