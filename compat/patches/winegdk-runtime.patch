+        if(seen==1)hr=failure_status(values[0]);
+        goto done;
+    }
+    if(seen!=1023||!expectedStoreId||strlen(values[1])!=17||strncmp(values[1],expectedStoreId,12)||values[1][12]!='/'||
+        !upper_alnum(values[1]+13,4)||strlen(values[7])>=sizeof(result.trialUniqueId)||!lower_hex(values[9])||
+        !boolean_value(values[2],&result.isActive)||!boolean_value(values[3],&result.isTrialOwnedByThisUser)||
+        !boolean_value(values[4],&result.isDiscLicense)||!boolean_value(values[5],&result.isTrial)||
+        !decimal(values[6],UINT32_MAX,&seconds)||!decimal(values[8],INT64_MAX,&expiration))goto done;
