+    { hr = E_INVALIDARG; goto cleanup; }
+    merged.endpointCount = defaults.endpointCount + title.endpointCount;
+    merged.policyCount = defaults.policyCount + title.policyCount;
+    if ((merged.endpointCount && !(merged.endpoints = calloc(merged.endpointCount, sizeof(*merged.endpoints)))) ||
+        (merged.policyCount && !(merged.policies = calloc(merged.policyCount, sizeof(*merged.policies)))))
+    { hr = E_OUTOFMEMORY; goto cleanup; }
+    if (defaults.endpointCount) memcpy(merged.endpoints, defaults.endpoints, defaults.endpointCount * sizeof(*merged.endpoints));
+    if (title.endpointCount) memcpy(merged.endpoints + defaults.endpointCount, title.endpoints, title.endpointCount * sizeof(*merged.endpoints));
+    if (defaults.policyCount) memcpy(merged.policies, defaults.policies, defaults.policyCount * sizeof(*merged.policies));
+    if (title.policyCount) memcpy(merged.policies + defaults.policyCount, title.policies, title.policyCount * sizeof(*merged.policies));
