+static HRESULT privilege_parse_not_after(const WCHAR *text, UINT32 length, UINT64 *expiry)
+{
+    SYSTEMTIME date = {0}, roundtrip;
+    FILETIME filetime;
+    UINT32 values[6] = {0}, at = 0;
+    static const UINT32 widths[] = {4, 2, 2, 2, 2, 2};
+    static const WCHAR separators[] = {'-', '-', 'T', ':', ':'};
+    *expiry = 0;
+    if (!text || length < 20 || length > 28) return HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+    for (UINT32 field = 0; field < 6; ++field)
+    {
+        for (UINT32 digit = 0; digit < widths[field]; ++digit)
+        {
+            if (at >= length || text[at] < '0' || text[at] > '9') return HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+            values[field] = values[field] * 10 + text[at++] - '0';
+        }
+        if (field < 5 && (at >= length || text[at++] != separators[field])) return HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+    }
+    if (at < length && text[at] == '.')
+    {
+        UINT32 start = ++at;
+        while (at < length && text[at] >= '0' && text[at] <= '9') ++at;
+        if (at == start || at - start > 7) return HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+        /* Round down fractional seconds so authorization never outlives expiry. */
+    }
+    if (at + 1 != length || text[at] != 'Z') return HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+    date.wYear = values[0]; date.wMonth = values[1]; date.wDay = values[2];
+    date.wHour = values[3]; date.wMinute = values[4]; date.wSecond = values[5];
+    if (!SystemTimeToFileTime(&date, &filetime) || !FileTimeToSystemTime(&filetime, &roundtrip) ||
+        roundtrip.wYear != date.wYear || roundtrip.wMonth != date.wMonth || roundtrip.wDay != date.wDay ||
+        roundtrip.wHour != date.wHour || roundtrip.wMinute != date.wMinute || roundtrip.wSecond != date.wSecond)
+        return HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+    *expiry = ((UINT64)filetime.dwHighDateTime << 32) | filetime.dwLowDateTime;
+    return S_OK;
+}
+
+static UINT64 privilege_utc_now(void)
+{
+    FILETIME now;
+    GetSystemTimeAsFileTime(&now);
+    return ((UINT64)now.dwHighDateTime << 32) | now.dwLowDateTime;
+}
+
+static HRESULT user_publish_privileges(struct XUser *user, HRESULT status, const UINT64 bits[4], UINT64 expiry)
+{
+    UINT64 now = privilege_utc_now(), ticks = GetTickCount64();
+    if (SUCCEEDED(status) && expiry <= now) status = HRESULT_FROM_WIN32(ERROR_LOGON_FAILURE);
+    AcquireSRWLockExclusive(&user->privilegeLock);
+    user->privilegesKnown = SUCCEEDED(status);
+    user->privilegesStatus = status;
+    memset(user->privilegeBits, 0, sizeof(user->privilegeBits));
+    user->privilegesNotAfter = user->privilegesDeadline = 0;
+    if (SUCCEEDED(status))
+    {
+        memcpy(user->privilegeBits, bits, sizeof(user->privilegeBits));
+        user->privilegesNotAfter = expiry;
+        user->privilegesDeadline = ticks + (expiry - now) / 10000;
+    }
+    ReleaseSRWLockExclusive(&user->privilegeLock);
+    return status;
+}
+
+static void user_capture_privileges(struct XUser *user, IJsonObject *response, IJsonObject *identity,
+        HSTRING identity_xuid, UINT64 expected_xuid, UINT32 identity_count)
+{
+    HSTRING privileges = NULL, not_after = NULL;
+    UINT64 bits[4] = {0}, expiry = 0;
+    UINT32 length;
+    const WCHAR *text;
+    HRESULT hr = HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+    if (identity_count != 1 || !identity_xuid || !xuid_decimal_matches(identity_xuid, expected_xuid)) goto done;
+    hr = get_json_string(identity, L"prv", &privileges);
+    if (FAILED(hr)) goto done;
+    text = WindowsGetStringRawBuffer(privileges, &length);
+    if (FAILED(hr = privilege_parse_list(text, length, bits))) goto done;
+    if (FAILED(hr = get_json_string(response, L"NotAfter", &not_after))) goto done;
+    text = WindowsGetStringRawBuffer(not_after, &length);
+    hr = privilege_parse_not_after(text, length, &expiry);
+done:
+    hr = user_publish_privileges(user, hr, bits, expiry);
+    if (privileges) WindowsDeleteString(privileges);
+    if (not_after) WindowsDeleteString(not_after);
+    /* Only evidence presence/status, never claims, identity, or their contents. */
+    fprintf(stderr, "xodus-user-privileges: snapshot_known=%u hr=%08lx\n", SUCCEEDED(hr), (ULONG)hr);
+}
