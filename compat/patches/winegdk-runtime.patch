+static HRESULT parse_signing_policy(IJsonObject *object, struct xodus_signing_policy *policy)
+{
+    DOUBLE version, maximum;
+    char **algorithms = NULL, **types = NULL;
+    SIZE_T algorithmCount = 0, typeCount = 0;
+    BOOL es256 = FALSE, xbl = TRUE;
+    HRESULT hr;
+    if (FAILED(hr = get_json_number(object, L"Version", &version))) return hr;
+    if (FAILED(hr = get_json_number(object, L"MaxBodyBytes", &maximum))) return hr;
+    if (!(version >= 0) || version > UINT32_MAX || version != (UINT32)version ||
+        !(maximum >= 0)) return E_INVALIDARG;
+    policy->version = version;
+    /* The signer takes ULONG bytes. Higher policy limits are equivalent for
+     * all representable requests; totals beyond ULONG are rejected by packing. */
+    if (maximum >= UINT32_MAX) policy->maxBodyBytes = UINT32_MAX;
+    else if (maximum != (UINT32)maximum) return E_INVALIDARG;
+    else policy->maxBodyBytes = maximum;
+    if (FAILED(hr = get_json_strings(object, L"ExtraHeaders", TRUE, &policy->extraHeaders, &policy->headerCount))) goto cleanup;
+    if (FAILED(hr = get_json_strings(object, L"SupportedAlgorithms", FALSE, &algorithms, &algorithmCount))) goto cleanup;
+    for (SIZE_T i = 0; i < algorithmCount; ++i) if (!strcmp(algorithms[i], "ES256")) es256 = TRUE;
+    hr = get_json_strings(object, L"SupportedSignatureTypes", FALSE, &types, &typeCount);
+    if (hr == WEB_E_JSON_VALUE_NOT_FOUND) hr = S_OK; /* Version-1 XBL predates this optional field. */
+    else if (SUCCEEDED(hr))
+    {
+        xbl = FALSE;
+        for (SIZE_T i = 0; i < typeCount; ++i) if (!strcmp(types[i], "XBL")) xbl = TRUE;
+    }
+    if (FAILED(hr)) goto cleanup;
+    policy->supported = policy->version == 1 && es256 && xbl;
+cleanup:
+    free_json_strings(algorithms, algorithmCount);
+    free_json_strings(types, typeCount);
+    return hr;
+}
