diff --git a/dlls/xgameruntime/GDKComponent/System/ConnectedStorageAuth.inc b/dlls/xgameruntime/GDKComponent/System/ConnectedStorageAuth.inc
new file mode 100644
index 0000000..865c1cc
--- /dev/null
+++ b/dlls/xgameruntime/GDKComponent/System/ConnectedStorageAuth.inc
@@ -0,0 +1,206 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* ConnectedStorage's independently observed User+Device XSTS contract.
+ * This separate cache never replaces normal title tokens or publishes prv.
+ * The already authenticated game user, device and native PoP key are reused. */
+static HRESULT user_cloud_xsts_body(struct XUser *impl, char **body)
+{
+    char *user = NULL, *device = NULL;
+    SIZE_T capacity;
+    UINT64 now = privilege_utc_now();
+    HRESULT hr;
+    *body = NULL;
+    if (!impl->titleAuthenticated || !impl->key || !impl->xuid || !impl->xuid_syntax_valid ||
+        (impl->profile_xuid_known && !impl->profile_xuid_matches) ||
+        !WindowsGetStringLen(impl->userToken) || !WindowsGetStringLen(impl->deviceToken) ||
+        impl->userTokenExpires <= now || impl->deviceTokenExpires <= now)
+        return HRESULT_FROM_WIN32(ERROR_LOGON_FAILURE);
+    if (FAILED(hr = auth_quote_hstring(impl->userToken, &user)) ||
+        FAILED(hr = auth_quote_hstring(impl->deviceToken, &device))) goto done;
+    capacity = strlen(user) + strlen(device) + 256;
+    if (!(*body = malloc(capacity))) { hr = E_OUTOFMEMORY; goto done; }
+    snprintf(*body, capacity, "{\"RelyingParty\":\"http://xboxlive.com\",\"TokenType\":\"JWT\",\"Properties\":{\"SandboxId\":\"RETAIL\",\"DeviceToken\":%s,\"UserTokens\":[%s]}}", device, user);
+    hr = S_OK;
+done:
+    if (user) { SecureZeroMemory(user, strlen(user)); free(user); }
+    if (device) { SecureZeroMemory(device, strlen(device)); free(device); }
+    return hr;
+}
+
+static void user_cloud_clear(struct XUser *impl)
+{
+    if (impl->cloudToken) WindowsDeleteString(impl->cloudToken);
+    if (impl->cloudUserHash) WindowsDeleteString(impl->cloudUserHash);
+    if (impl->cloudUserInput) WindowsDeleteString(impl->cloudUserInput);
+    if (impl->cloudDeviceInput) WindowsDeleteString(impl->cloudDeviceInput);
+    impl->cloudToken = impl->cloudUserHash = NULL;
+    impl->cloudUserInput = impl->cloudDeviceInput = NULL;
+    impl->cloudKey = NULL;
+    SecureZeroMemory(impl->cloudProofKey, sizeof(impl->cloudProofKey));
+    impl->cloudExpires = impl->cloudDeadline = impl->cloudXuid = 0;
+}
+
+static BOOL user_cloud_string_equal(HSTRING left, HSTRING right)
+{
+    INT32 order;
+    return left && right && SUCCEEDED(WindowsCompareStringOrdinal(left, right, &order)) && !order;
+}
+
+/* Exact input snapshots avoid pointer-reuse assumptions and leave the ordinary
+ * auth mutators alone. Every hit still validates identity and input lifetimes. */
+static BOOL user_cloud_cache_valid(struct XUser *impl)
+{
+    UINT64 now = privilege_utc_now();
+    return impl->titleAuthenticated && impl->key && impl->xuid && impl->xuid_syntax_valid &&
+        (!impl->profile_xuid_known || impl->profile_xuid_matches) &&
+        impl->cloudToken && impl->cloudUserHash && impl->cloudXuid == impl->xuid &&
+        impl->cloudExpires > now && impl->cloudDeadline > GetTickCount64() &&
+        impl->userTokenExpires > now && impl->deviceTokenExpires > now &&
+        impl->cloudKey == impl->key && !memcmp(impl->cloudProofKey, impl->proofKey, PROOF_KEY_SIZE) &&
+        user_cloud_string_equal(impl->cloudUserInput, impl->userToken) &&
+        user_cloud_string_equal(impl->cloudDeviceInput, impl->deviceToken);
+}
+
+/* Caller holds xstsLock, covering source credentials, key and both caches. */
+static HRESULT user_request_cloud_token(struct XUser *impl)
+{
+    IJsonObject *object = NULL, *claims = NULL, *user = NULL;
+    IJsonArray *users = NULL;
+    IVector_IJsonValue *vector = NULL;
+    HSTRING token = NULL, hash = NULL, xuid = NULL;
+    HSTRING inputUser = NULL, inputDevice = NULL;
+    BCRYPT_KEY_HANDLE inputKey = impl->key;
+    char inputProof[PROOF_KEY_SIZE];
+    UINT32 count = 0, length = 0;
+    UINT64 expiry = 0, now, originalXuid = impl->xuid;
+    UCHAR *buffer = NULL;
+    char *body = NULL;
+    SIZE_T size = 0;
+    const WCHAR *text;
+    HRESULT hr;
+    memcpy(inputProof, impl->proofKey, sizeof(inputProof));
+    if (FAILED(hr = WindowsDuplicateString(impl->userToken, &inputUser)) ||
+        FAILED(hr = WindowsDuplicateString(impl->deviceToken, &inputDevice))) goto done;
+    if (FAILED(hr = user_cloud_xsts_body(impl, &body))) goto done;
+    if (FAILED(hr = user_authenticated_http(impl, "POST", "xsts.auth.xboxlive.com", "/xsts/authorize", body, NULL, &buffer, &size)) ||
+        FAILED(hr = parse_json((char *)buffer, size, &object)) ||
+        FAILED(hr = auth_response_token(object, &token, &expiry)) ||
+        FAILED(hr = get_json_object(object, L"DisplayClaims", &claims)) ||
+        FAILED(hr = get_json_array(claims, L"xui", &users)) ||
+        FAILED(hr = IJsonArray_QueryInterface(users, &IID_IVector_IJsonValue, (void **)&vector)) ||
+        FAILED(hr = IVector_IJsonValue_get_Size(vector, &count))) goto done;
+    hr = HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+    if (count != 1 || WindowsGetStringLen(token) > 65536) goto done;
+    if (FAILED(hr = IJsonArray_GetObjectAt(users, 0, &user)) ||
+        FAILED(hr = get_json_string(user, L"xid", &xuid)) ||
+        FAILED(hr = get_json_string(user, L"uhs", &hash))) goto done;
+    hr = HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+    if (!xuid_decimal_matches(xuid, originalXuid) || !originalXuid || originalXuid != impl->xuid) goto done;
+    if (inputKey != impl->key || memcmp(inputProof, impl->proofKey, sizeof(inputProof)) ||
+        !user_cloud_string_equal(inputUser, impl->userToken) || !user_cloud_string_equal(inputDevice, impl->deviceToken)) goto done;
+    text = WindowsGetStringRawBuffer(hash, &length);
+    if (!length || length > 64) goto done;
+    for (UINT32 i = 0; i < length; ++i) if (text[i] < '0' || text[i] > '9') goto done;
+    now = privilege_utc_now();
+    if (expiry > impl->userTokenExpires) expiry = impl->userTokenExpires;
+    if (expiry > impl->deviceTokenExpires) expiry = impl->deviceTokenExpires;
+    if (expiry <= now) { hr = HRESULT_FROM_WIN32(ERROR_LOGON_FAILURE); goto done; }
+    /* UTC and monotonic limits both apply; no cache can live beyond inputs. */
+    if (expiry - now > (UINT64)300 * 10000000) expiry = now + (UINT64)300 * 10000000;
+    user_cloud_clear(impl);
+    impl->cloudToken = token; token = NULL;
+    impl->cloudUserHash = hash; hash = NULL;
+    impl->cloudExpires = expiry;
+    impl->cloudDeadline = GetTickCount64() + (expiry - now) / 10000;
+    impl->cloudXuid = originalXuid;
+    impl->cloudUserInput = inputUser; inputUser = NULL;
+    impl->cloudDeviceInput = inputDevice; inputDevice = NULL;
+    impl->cloudKey = inputKey;
+    memcpy(impl->cloudProofKey, inputProof, sizeof(inputProof));
+    hr = S_OK;
+done:
+    if (body) { SecureZeroMemory(body, strlen(body)); free(body); }
+    if (buffer) { SecureZeroMemory(buffer, size); free(buffer); }
+    if (token) WindowsDeleteString(token);
+    if (hash) WindowsDeleteString(hash);
+    if (xuid) WindowsDeleteString(xuid);
+    if (inputUser) WindowsDeleteString(inputUser);
+    if (inputDevice) WindowsDeleteString(inputDevice);
+    if (vector) IVector_IJsonValue_Release(vector);
+    if (users) IJsonArray_Release(users);
+    if (user) IJsonObject_Release(user);
+    if (claims) IJsonObject_Release(claims);
+    if (object) IJsonObject_Release(object);
+    if (FAILED(hr)) user_cloud_clear(impl);
+    return hr;
+}
+
+static BOOL user_cloud_url_allowed(struct XUser *user, const char *url)
+{
+    char prefix[128]; SIZE_T n, size;
+    if (!user || !user->xuid || !url || (size = strnlen(url, 16385)) > 16384) return FALSE;
+    n = snprintf(prefix, sizeof(prefix), "https://titlestorage.xboxlive.com/connectedstorage/users/xuid(%llu)/scids/", (unsigned long long)user->xuid);
+    if (n >= sizeof(prefix) || strncmp(url, prefix, n) || size < n + 36) return FALSE;
+    for (unsigned i = 0; i < 36; ++i)
+    {
+        char c = url[n + i];
+        if (i == 8 || i == 13 || i == 18 || i == 23) { if (c != '-') return FALSE; }
+        else if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return FALSE;
+    }
+    if (url[n + 36] && url[n + 36] != '/' && url[n + 36] != '?') return FALSE;
+    for (SIZE_T i = n + 36; i < size; ++i)
+        if ((unsigned char)url[i] <= 32 || (unsigned char)url[i] >= 127 || url[i] == '#' || url[i] == '\\') return FALSE;
+    return TRUE;
+}
+
+#include <ctype.h>
+
+/* Write requests use the existing independent UD cache and PoP signer. The
+ * helper owns schemas/lease state; this boundary additionally rejects arbitrary
+ * services, methods, forced locks and unbounded request bodies. */
+static BOOL user_cloud_write_allowed(struct XUser *user, const char *method, const char *url,
+    SIZE_T bodySize, const void *body)
+{
+    const char *tail, *p, *query;
+    if (!method || !user_cloud_url_allowed(user, url) || bodySize > 4 * 1024 * 1024 || (bodySize && !body)) return FALSE;
+    tail = strstr(url, "/scids/") + 7 + 36;
+    if (!strcmp(method, "PUT") && !strcmp(tail, "/lock?friendlyName=Flightdeck")) return !bodySize;
+    if (!strcmp(method, "DELETE") && !strcmp(tail, "/lock")) return !bodySize;
+    if (!strncmp(tail, "/atoms/", 7) && !strcmp(method, "POST"))
+    {
+        p = tail + 7;
+        if (strlen(p) < 36 || !bodySize) return FALSE;
+        for (unsigned i = 0; i < 36; ++i)
+        {
+            char c = p[i];
+            if (i == 8 || i == 13 || i == 18 || i == 23) { if (c != '-') return FALSE; }
+            else if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'))) return FALSE;
+        }
+        return !p[36] || !strcmp(p + 36, "?commit=true");
+    }
+    if (strncmp(tail, "/savedgames/", 12)) return FALSE;
+    p = tail + 12; query = strchr(p, '?');
+    if (query == p || !*p) return FALSE;
+    for (; *p && *p != '?'; ++p)
+    {
+        unsigned char c = *p;
+        if (c == '%')
+        {
+            if (!p[1] || !p[2] || !isxdigit((unsigned char)p[1]) || !isxdigit((unsigned char)p[2])) return FALSE;
+            p += 2;
+        }
+        else if (!(isalnum(c) || c == '-' || c == '_' || c == '.' || c == '~')) return FALSE;
+    }
+    if (!strcmp(method, "DELETE")) return !query && !bodySize;
+    if (strcmp(method, "PUT") || !query || !bodySize || strncmp(query, "?clientFileTime=", 16)) return FALSE;
+    p = query + 16;
+    if (!*p) return FALSE;
+    for (; *p && *p != '&'; ++p)
+        if (!(isalnum((unsigned char)*p) || *p == '%' || *p == '-')) return FALSE;
+    if (*p)
+    {
+        if (strncmp(p, "&displayName=", 13)) return FALSE;
+        p += 13;
+        for (; *p; ++p) if (!(isalnum((unsigned char)*p) || *p == '%' || *p == '-' || *p == '_' || *p == '.' || *p == '~')) return FALSE;
+    }
+    return TRUE;
+}
diff --git a/dlls/xgameruntime/GDKComponent/System/ExistingUserPicker.c b/dlls/xgameruntime/GDKComponent/System/ExistingUserPicker.c
new file mode 100644
index 0000000..69ed0b3
--- /dev/null
+++ b/dlls/xgameruntime/GDKComponent/System/ExistingUserPicker.c
@@ -0,0 +1,176 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "ExistingUserPicker.h"
+
+static SRWLOCK picker_lock = SRWLOCK_INIT;
+static BOOL picker_shutdown;
+static volatile LONG *picker_cancelled;
+static HWND picker_window;
+
+struct picker_context
+{
+    const WCHAR *text;
+    volatile LONG *cancelled;
+    DWORD failure;
+};
+
+/* All cancellation sends are asynchronous while holding the state lock. Window
+ * destruction runs on its creating thread; WM_DESTROY clears the exact HWND. */
+void xodus_existing_user_picker_cancel(volatile LONG *cancelled)
+{
+    if (!cancelled) return;
+    InterlockedExchange(cancelled, 1);
+    AcquireSRWLockExclusive(&picker_lock);
+    if (picker_cancelled == cancelled && picker_window)
+        PostMessageW(picker_window, WM_CLOSE, 0, 0);
+    ReleaseSRWLockExclusive(&picker_lock);
+}
+
+void xodus_existing_user_picker_shutdown(void)
+{
+    AcquireSRWLockExclusive(&picker_lock);
+    picker_shutdown = TRUE;
+    if (picker_window) PostMessageW(picker_window, WM_CLOSE, 0, 0);
+    ReleaseSRWLockExclusive(&picker_lock);
+}
+
+static HWND create_control(HWND dialog, const WCHAR *class_name, const WCHAR *text,
+                           DWORD style, int id, int x, int y, int width, int height)
+{
+    RECT position = {x, y, x + width, y + height};
+    HWND control;
+    MapDialogRect(dialog, &position);
+    control = CreateWindowExW(0, class_name, text, WS_CHILD | WS_VISIBLE | style,
+                             position.left, position.top,
+                             position.right - position.left, position.bottom - position.top,
+                             dialog, (HMENU)(INT_PTR)id, GetModuleHandleW(NULL), NULL);
+    if (control)
+        SendMessageW(control, WM_SETFONT, SendMessageW(dialog, WM_GETFONT, 0, 0), FALSE);
+    return control;
+}
+
+static INT_PTR CALLBACK picker_proc(HWND dialog, UINT message, WPARAM wparam, LPARAM lparam)
+{
+    struct picker_context *context;
+    if (message == WM_INITDIALOG)
+    {
+        BOOL aborted;
+        HWND label, confirm, cancel;
+        context = (struct picker_context *)lparam;
+        SetWindowLongPtrW(dialog, GWLP_USERDATA, (LONG_PTR)context);
+        AcquireSRWLockExclusive(&picker_lock);
+        picker_window = dialog;
+        aborted = picker_shutdown || InterlockedCompareExchange(context->cancelled, 0, 0);
+        ReleaseSRWLockExclusive(&picker_lock);
+        if (aborted)
+        {
+            EndDialog(dialog, IDCANCEL);
+            return TRUE;
+        }
+        SetLastError(ERROR_SUCCESS);
+        label = create_control(dialog, L"STATIC", context->text, SS_LEFT, 100,
+                               12, 10, 236, 55);
+        confirm = create_control(dialog, L"BUTTON", L"Dieses Konto verwenden", WS_TABSTOP | BS_PUSHBUTTON,
+                                 IDOK, 12, 76, 140, 18);
+        cancel = create_control(dialog, L"BUTTON", L"Abbrechen", WS_TABSTOP | BS_DEFPUSHBUTTON,
+                                IDCANCEL, 168, 76, 80, 18);
+        if (!label || !confirm || !cancel)
+        {
+            context->failure = GetLastError();
+            if (!context->failure) context->failure = ERROR_NOT_ENOUGH_MEMORY;
+            EndDialog(dialog, -1);
+            return TRUE;
+        }
+        SendMessageW(dialog, DM_SETDEFID, IDCANCEL, 0);
+        SetFocus(cancel);
+        return FALSE;
+    }
+    context = (struct picker_context *)GetWindowLongPtrW(dialog, GWLP_USERDATA);
+    switch (message)
+    {
+        case WM_COMMAND:
+            if (LOWORD(wparam) == IDOK || LOWORD(wparam) == IDCANCEL)
+            {
+                EndDialog(dialog, LOWORD(wparam));
+                return TRUE;
+            }
+            break;
+        case WM_CLOSE:
+            EndDialog(dialog, IDCANCEL);
+            return TRUE;
+        case WM_DESTROY:
+            AcquireSRWLockExclusive(&picker_lock);
+            if (picker_window == dialog) picker_window = NULL;
+            ReleaseSRWLockExclusive(&picker_lock);
+            break;
+    }
+    (void)context;
+    return FALSE;
+}
+
+HRESULT WINAPI xodus_choose_existing_user(const WCHAR *gamertag, volatile LONG *cancelled)
+{
+    static const WCHAR title[] = L"Xbox-Konto ausw\u00e4hlen";
+    static const WCHAR prefix[] = L"Bereits angemeldetes Xbox-Konto:\n\n";
+    static const WCHAR suffix[] = L"\n\nDieses Konto f\u00fcr Microsoft Flight Simulator verwenden?";
+    union { DWORD alignment; BYTE bytes[256]; } template_storage;
+    DLGTEMPLATE *dialog = (DLGTEMPLATE *)template_storage.bytes;
+    WORD *extra;
+    struct picker_context context;
+    WCHAR *text;
+    SIZE_T text_bytes;
+    INT_PTR result;
+    DWORD error;
+    BOOL aborted;
+
+    if (!gamertag || !*gamertag || !cancelled) return E_INVALIDARG;
+    AcquireSRWLockExclusive(&picker_lock);
+    if (picker_shutdown || InterlockedCompareExchange(cancelled, 0, 0))
+    {
+        ReleaseSRWLockExclusive(&picker_lock);
+        return E_ABORT;
+    }
+    if (picker_cancelled)
+    {
+        ReleaseSRWLockExclusive(&picker_lock);
+        return HRESULT_FROM_WIN32(ERROR_BUSY);
+    }
+    picker_cancelled = cancelled;
+    ReleaseSRWLockExclusive(&picker_lock);
+
+    text_bytes = sizeof(prefix) + sizeof(suffix) + (SIZE_T)lstrlenW(gamertag) * sizeof(WCHAR);
+    text = HeapAlloc(GetProcessHeap(), 0, text_bytes);
+    if (!text)
+    {
+        AcquireSRWLockExclusive(&picker_lock);
+        picker_cancelled = NULL;
+        ReleaseSRWLockExclusive(&picker_lock);
+        return E_OUTOFMEMORY;
+    }
+    lstrcpyW(text, prefix);
+    lstrcatW(text, gamertag);
+    lstrcatW(text, suffix);
+    ZeroMemory(&template_storage, sizeof(template_storage));
+    dialog->style = WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | DS_CENTER;
+    dialog->cx = 260;
+    dialog->cy = 106;
+    extra = (WORD *)(dialog + 1);
+    *extra++ = 0; /* no menu */
+    *extra++ = 0; /* standard dialog class */
+    CopyMemory(extra, title, sizeof(title));
+    context.text = text;
+    context.cancelled = cancelled;
+    context.failure = ERROR_SUCCESS;
+    SetLastError(ERROR_SUCCESS);
+    result = DialogBoxIndirectParamW(GetModuleHandleW(NULL), dialog, NULL, picker_proc, (LPARAM)&context);
+    error = context.failure ? context.failure : GetLastError();
+    AcquireSRWLockExclusive(&picker_lock);
+    aborted = picker_shutdown || InterlockedCompareExchange(cancelled, 0, 0);
+    picker_window = NULL;
+    picker_cancelled = NULL;
+    ReleaseSRWLockExclusive(&picker_lock);
+    HeapFree(GetProcessHeap(), 0, text);
+    if (aborted) return E_ABORT;
+    if (result == IDOK) return S_OK;
+    if (result == IDCANCEL) return E_ABORT;
+    return HRESULT_FROM_WIN32(error ? error : ERROR_GEN_FAILURE);
+}
diff --git a/dlls/xgameruntime/GDKComponent/System/ExistingUserPicker.h b/dlls/xgameruntime/GDKComponent/System/ExistingUserPicker.h
