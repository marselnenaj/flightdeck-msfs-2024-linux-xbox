+static BOOL xuid_decimal_matches(HSTRING text, UINT64 expected)
+{
+    UINT32 length;
+    const WCHAR *value = WindowsGetStringRawBuffer(text, &length);
+    UINT64 parsed = 0;
+    if (!length || length > 20) return FALSE;
+    for (UINT32 i = 0; i < length; ++i)
+    {
+        unsigned digit;
+        if (value[i] < '0' || value[i] > '9') return FALSE;
+        digit = value[i] - '0';
+        if (parsed > (UINT64_MAX - digit) / 10) return FALSE;
+        parsed = parsed * 10 + digit;
+    }
+    return parsed != 0 && parsed == expected;
+}
