+static HRESULT user_check_privilege(struct XUser *user, XUserPrivilegeOptions options,
+        XUserPrivilege privilege, BOOLEAN *has_privilege, XUserPrivilegeDenyReason *reason)
+{
+    HRESULT hr;
+    if (reason) *reason = XUserPrivilegeDenyReason_Unknown;
+    if (!has_privilege) return E_POINTER;
+    *has_privilege = FALSE;
+    if (!user) return E_POINTER;
+    if (!privilege_id_supported(privilege) || (options != XUserPrivilegeOptions_None && options != XUserPrivilegeOptions_AllUsers))
+        return E_INVALIDARG;
+    if (options == XUserPrivilegeOptions_AllUsers) return E_NOTIMPL;
+    AcquireSRWLockShared(&user->privilegeLock);
+    if (!user->privilegesKnown)
+        hr = FAILED(user->privilegesStatus) ? user->privilegesStatus : E_NOTIMPL;
+    else if (privilege_utc_now() >= user->privilegesNotAfter || GetTickCount64() >= user->privilegesDeadline)
+        hr = HRESULT_FROM_WIN32(ERROR_LOGON_FAILURE);
+    else
+    {
+        *has_privilege = !!(user->privilegeBits[(UINT32)privilege / 64] & ((UINT64)1 << ((UINT32)privilege % 64)));
+        if (reason && *has_privilege) *reason = XUserPrivilegeDenyReason_None;
+        hr = S_OK;
+    }
+    ReleaseSRWLockShared(&user->privilegeLock);
+    return hr;
+}
