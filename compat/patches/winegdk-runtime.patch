+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef XODUS_EXISTING_USER_PICKER_H
+#define XODUS_EXISTING_USER_PICKER_H
+
+#include <windows.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The caller keeps cancelled alive through this synchronous modal operation.
+ * Only an explicit confirmation returns S_OK. No account is authenticated here. */
+HRESULT WINAPI xodus_choose_existing_user(const WCHAR *gamertag, volatile LONG *cancelled);
+void xodus_existing_user_picker_cancel(volatile LONG *cancelled);
+/* Terminal: close the owned dialog and reject any later picker calls. */
+void xodus_existing_user_picker_shutdown(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/dlls/xgameruntime/GDKComponent/System/SignatureRequest.c b/dlls/xgameruntime/GDKComponent/System/SignatureRequest.c
new file mode 100644
index 0000000..fa74e19
--- /dev/null
+++ b/dlls/xgameruntime/GDKComponent/System/SignatureRequest.c
@@ -0,0 +1,327 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "SignatureRequest.h"
+#include <wininet.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+BOOL xodus_signing_size_add(SIZE_T *size, SIZE_T amount)
+{
+    if (amount > SIZE_MAX - *size) return FALSE;
+    *size += amount;
+    return TRUE;
+}
+
+BOOL xodus_is_playfab_token_only_request(const struct xodus_signing_endpoint *endpoint,
+    const char *method, const char *url, SIZE_T bodySize)
+{
+    /* Microsoft PlayFab explicitly specifies this exact token-acquisition
+     * request. Missing policies for arbitrary routes are not inferred safe. */
+    return endpoint && !endpoint->hasPolicy && endpoint->protocol && endpoint->hostType &&
+        endpoint->host && endpoint->relyingParty && method && url && !bodySize &&
+        !strcmp(method, "POST") && !strcmp(url, "https://playfabapi.com/") &&
+        !strcmp(endpoint->protocol, "https") && !strcmp(endpoint->hostType, "fqdn") &&
+        !strcmp(endpoint->host, "playfabapi.com") &&
+        (!endpoint->path || !strcmp(endpoint->path, "/")) &&
+        !strcmp(endpoint->relyingParty, "http://playfab.xboxlive.com/");
+}
+
+static unsigned char ascii_lower(unsigned char ch)
+{
+    return ch >= 'A' && ch <= 'Z' ? ch + ('a' - 'A') : ch;
+}
+
+static BOOL header_equal(const char *left, const char *right)
+{
+    while (*left && *right)
+        if (ascii_lower(*left++) != ascii_lower(*right++)) return FALSE;
+    return !*left && !*right;
+}
+
+static BOOL equal_n(const char *left, const char *right, SIZE_T length)
+{
+    for (SIZE_T i = 0; i < length; ++i)
+        if (ascii_lower(left[i]) != ascii_lower(right[i])) return FALSE;
+    return TRUE;
+}
+
+static BOOL nullable_equal(const char *left, const char *right)
+{
+    return (!left && !right) || (left && right && !strcmp(left, right));
+}
+
+static BOOL valid_dns_host(const char *host, SIZE_T length)
+{
+    SIZE_T label = 0;
+    if (!length || length > 253) return FALSE;
+    for (SIZE_T i = 0; i < length; ++i)
+    {
+        unsigned char ch = ascii_lower(host[i]);
+        if (ch == '.')
+        {
+            if (!label || host[i - 1] == '-') return FALSE;
+            label = 0;
+        }
+        else
+        {
+            if (!((ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || ch == '-') ||
+                (!label && ch == '-') || ++label > 63) return FALSE;
+        }
+    }
+    return label && host[length - 1] != '-';
+}
+
+HRESULT xodus_prepare_signing_endpoint(struct xodus_signing_endpoint *endpoint,
+    BOOL authenticatedTitle, const char *tokenType, UINT32 localPolicyCount, UINT32 policyOffset)
+{
+    BOOL concreteHost = FALSE;
+    if (!endpoint || !endpoint->protocol || !endpoint->hostType || !endpoint->host) return E_POINTER;
+    endpoint->tokenOnly = FALSE;
+    endpoint->fromTitle = authenticatedTitle;
+    if (endpoint->path && endpoint->path[0] != '/') return E_INVALIDARG;
+    if (endpoint->relyingParty)
+    {
+        const char *rp = endpoint->relyingParty;
+        if (strncmp(rp, "http://", 7) && strncmp(rp, "https://", 8) && strncmp(rp, "rp://", 5)) return E_INVALIDARG;
+        for (const unsigned char *p = (const unsigned char *)rp; *p; ++p)
+            if (*p < 0x21 || *p > 0x7e || *p == '"' || *p == '\\') return E_INVALIDARG;
+    }
+    if (tokenType && strcmp(tokenType, "JWT")) return E_NOTIMPL;
+    if (endpoint->hasPolicy)
+    {
+        if (endpoint->policyIndex >= localPolicyCount || endpoint->policyIndex > UINT32_MAX - policyOffset)
+            return E_INVALIDARG;
+        endpoint->policyIndex += policyOffset;
+    }
+    if (!strcmp(endpoint->hostType, "fqdn"))
+        concreteHost = valid_dns_host(endpoint->host, strlen(endpoint->host));
+    else if (!strcmp(endpoint->hostType, "wildcard") && !strncmp(endpoint->host, "*.", 2))
+        concreteHost = valid_dns_host(endpoint->host + 2, strlen(endpoint->host + 2));
+    /* Only authenticated title NSAL can authorize a new no-signature route.
+     * Generic catchalls and HTTP never become token-bearing endpoints. */
+    endpoint->tokenOnly = authenticatedTitle && concreteHost && !strcmp(endpoint->protocol, "https") &&
+        tokenType && !strcmp(tokenType, "JWT") && endpoint->relyingParty &&
+        *endpoint->relyingParty && !endpoint->hasPolicy;
+    return S_OK;
+}
+
+/* XSAPI requests RTA authentication for wss://rta.xboxlive.com/connect.
+ * A secure WebSocket opens with an HTTPS upgrade handshake; NSAL advertises
+ * its HTTPS policy. Only normalize that secure scheme, retaining every byte
+ * of the authority, path and query for the existing validation and signer.
+ * https://github.com/microsoft/xbox-live-api/blob/main/Source/Shared/web_socket.cpp
+ */
+static HRESULT secure_handshake_url(const char *url, char **normalized)
+{
+    SIZE_T length;
+    *normalized = NULL;
+    if (!url) return E_POINTER;
+    length = strlen(url);
+    if (length < 6 || !equal_n(url, "wss://", 6)) return S_OK;
+    if (length > SIZE_MAX - 3) return E_INVALIDARG;
+    if (!(*normalized = malloc(length + 3))) return E_OUTOFMEMORY;
+    memcpy(*normalized, "https", 5);
+    memcpy(*normalized + 5, url + 3, length - 3 + 1);
+    return S_OK;
+}
+
+static HRESULT select_https_endpoint(const char *url, SIZE_T endpointCount,
+    const struct xodus_signing_endpoint *endpoints, const struct xodus_signing_endpoint **result)
+{
+    URL_COMPONENTSA parts = {.dwStructSize = sizeof(parts), .dwHostNameLength = -1,
+        .dwUrlPathLength = -1, .dwExtraInfoLength = -1,
+        .dwUserNameLength = -1, .dwPasswordLength = -1};
+    const struct xodus_signing_endpoint *best = NULL;
+    SIZE_T bestHost = 0, bestPath = 0;
+    BOOL bestExact = FALSE, ambiguous = FALSE;
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!url || (endpointCount && !endpoints)) return E_POINTER;
+    if (!InternetCrackUrlA(url, 0, 0, &parts)) return HRESULT_FROM_WIN32(GetLastError());
+    if (parts.nScheme != INTERNET_SCHEME_HTTPS || parts.nPort != INTERNET_DEFAULT_HTTPS_PORT ||
+        !valid_dns_host(parts.lpszHostName, parts.dwHostNameLength) || parts.dwUserNameLength || parts.dwPasswordLength) return E_NOTIMPL;
+    for (SIZE_T i = 0; i < endpointCount; ++i)
+    {
+        const struct xodus_signing_endpoint *entry = &endpoints[i];
+        const char *host = entry->host, *path = entry->path;
+        SIZE_T hostLength, pathLength = path ? strlen(path) : 0;
+        BOOL exact;
+        if (!host || !entry->protocol || !entry->hostType || strcmp(entry->protocol, "https")) continue;
+        hostLength = strlen(host);
+        exact = !strcmp(entry->hostType, "fqdn");
+        if (exact)
+        {
+            if (!valid_dns_host(host, hostLength) || hostLength != parts.dwHostNameLength || !equal_n(host, parts.lpszHostName, hostLength)) continue;
+        }
+        else
+        {
+            if (strcmp(entry->hostType, "wildcard") || hostLength < 3 || host[0] != '*' || host[1] != '.' ||
+                !valid_dns_host(host + 2, hostLength - 2)) continue;
+            ++host; --hostLength;
+            if (parts.dwHostNameLength <= hostLength ||
+                !equal_n(host, parts.lpszHostName + parts.dwHostNameLength - hostLength, hostLength)) continue;
+        }
+        const char *urlPath = parts.dwUrlPathLength ? parts.lpszUrlPath : "/";
+        SIZE_T urlPathLength = parts.dwUrlPathLength ? parts.dwUrlPathLength : 1;
+        if (pathLength && (urlPathLength < pathLength || memcmp(path, urlPath, pathLength) ||
+            (urlPathLength > pathLength && path[pathLength - 1] != '/' && urlPath[pathLength] != '/'))) continue;
+        BOOL sameSpecificity = best && exact == bestExact && hostLength == bestHost && pathLength == bestPath;
+        BOOL better = !best || exact > bestExact ||
+            (exact == bestExact && (hostLength > bestHost || (hostLength == bestHost && pathLength > bestPath))) ||
+            (sameSpecificity && entry->fromTitle && !best->fromTitle);
+        if (better)
+        {
+            best = entry; bestExact = exact; bestHost = hostLength; bestPath = pathLength; ambiguous = FALSE;
+        }
+        else if (sameSpecificity && entry->fromTitle == best->fromTitle &&
+            (!nullable_equal(best->relyingParty, entry->relyingParty) || best->hasPolicy != entry->hasPolicy ||
+             best->tokenOnly != entry->tokenOnly || (best->hasPolicy && best->policyIndex != entry->policyIndex))) ambiguous = TRUE;
+    }
+    if (!best || ambiguous) return E_NOTIMPL;
+    *result = best;
+    return S_OK;
+}
+
+HRESULT xodus_select_signing_endpoint(const char *url, SIZE_T endpointCount,
+    const struct xodus_signing_endpoint *endpoints, const struct xodus_signing_endpoint **result)
+{
+    char *normalized = NULL;
+    HRESULT hr;
+    if (result) *result = NULL;
+    if (FAILED(hr = secure_handshake_url(url, &normalized))) return hr;
+    hr = select_https_endpoint(normalized ? normalized : url, endpointCount, endpoints, result);
+    free(normalized);
+    return hr;
+}
+
+static BOOL ascii_value(const char *value, SIZE_T length)
+{
+    for (SIZE_T i = 0; i < length; ++i)
+        if ((unsigned char)value[i] < 0x20 || (unsigned char)value[i] > 0x7e) return FALSE;
+    return TRUE;
+}
+
+static BOOL token_name(const char *name)
+{
+    if (!*name) return FALSE;
+    for (; *name; ++name)
+    {
+        unsigned char ch = *name;
+        if ((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') ||
+            (ch >= '0' && ch <= '9') || strchr("!#$%&'*+-.^_`|~", ch)) continue;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static void network_u32(BYTE *out, UINT32 value)
+{
+    out[0] = value >> 24; out[1] = value >> 16;
+    out[2] = value >> 8; out[3] = value;
+}
+
+static HRESULT pack_https_request(const struct xodus_signing_policy *policy,
+    const char *method, const char *url, const char *authorization,
+    SIZE_T headerCount, const struct xodus_signing_header *headers,
+    SIZE_T bodySize, const void *body, const FILETIME *timestamp,
+    struct xodus_signing_request *result)
+{
+    URL_COMPONENTSA parts = {.dwStructSize = sizeof(parts), .dwHostNameLength = -1,
+        .dwUrlPathLength = -1, .dwExtraInfoLength = -1};
+    SIZE_T size = 18, methodSize, pathSize, authSize, take;
+    const char **values = NULL;
+    BYTE *out, *cursor;
+    HRESULT hr = E_INVALIDARG;
+
+    if (!result) return E_POINTER;
+    memset(result, 0, sizeof(*result));
+    if (!policy || !method || !url || !authorization || !timestamp ||
+        (headerCount && !headers) || (bodySize && !body)) return E_POINTER;
+    /* Only the documented version-1 XBL stream and ES256 are implemented. */
+    if (!policy->supported || policy->version != 1) return E_NOTIMPL;
+    if (policy->headerCount && !policy->extraHeaders) return E_INVALIDARG;
+    if (!token_name(method)) return E_INVALIDARG;
+    if (!InternetCrackUrlA(url, 0, 0, &parts)) return HRESULT_FROM_WIN32(GetLastError());
+    if (parts.nScheme != INTERNET_SCHEME_HTTPS || !parts.dwHostNameLength) return E_INVALIDARG;
+    if (parts.dwUrlPathLength && parts.lpszUrlPath[0] != '/') return E_INVALIDARG;
+    if (!ascii_value(parts.lpszUrlPath, parts.dwUrlPathLength) ||
+        !ascii_value(parts.lpszExtraInfo, parts.dwExtraInfoLength)) return E_INVALIDARG;
+
+    methodSize = strlen(method);
+    pathSize = (parts.dwUrlPathLength ? parts.dwUrlPathLength : 1);
+    authSize = strlen(authorization);
+    take = bodySize < policy->maxBodyBytes ? bodySize : policy->maxBodyBytes;
+    if (!ascii_value(authorization, authSize) ||
+        !xodus_signing_size_add(&pathSize, parts.dwExtraInfoLength) ||
+        !xodus_signing_size_add(&size, methodSize) ||
+        !xodus_signing_size_add(&size, pathSize) ||
+        !xodus_signing_size_add(&size, authSize) ||
+        !xodus_signing_size_add(&size, take) || size > UINT32_MAX) return E_INVALIDARG;
+    if (policy->headerCount > SIZE_MAX / sizeof(*values)) return E_INVALIDARG;
+    if (policy->headerCount && !(values = calloc(policy->headerCount, sizeof(*values)))) return E_OUTOFMEMORY;
+    for (SIZE_T i = 0; i < headerCount; ++i)
+        if (!headers[i].name || !headers[i].value) { hr = E_POINTER; goto cleanup; }
+    for (SIZE_T i = 0; i < policy->headerCount; ++i)
+    {
+        if (!policy->extraHeaders[i] || !token_name(policy->extraHeaders[i]) ||
+            header_equal(policy->extraHeaders[i], "Authorization")) goto cleanup;
+        for (SIZE_T j = 0; j < i; ++j)
+            if (header_equal(policy->extraHeaders[i], policy->extraHeaders[j])) goto cleanup;
+        values[i] = "";
+        BOOL found = FALSE;
+        for (SIZE_T j = 0; j < headerCount; ++j)
+        {
+            if (!header_equal(policy->extraHeaders[i], headers[j].name)) continue;
+            /* Combining duplicate fields has no documented Xbox rule here. */
+            if (found) goto cleanup;
+            found = TRUE;
+            values[i] = headers[j].value;
+        }
+        SIZE_T length = strlen(values[i]);
+        if (!ascii_value(values[i], length) || !xodus_signing_size_add(&size, length) ||
+            !xodus_signing_size_add(&size, 1) || size > UINT32_MAX) goto cleanup;
+    }
+    if (!(out = calloc(1, size))) { hr = E_OUTOFMEMORY; goto cleanup; }
+    network_u32(out, policy->version);
+    network_u32(out + 5, timestamp->dwHighDateTime);
+    network_u32(out + 9, timestamp->dwLowDateTime);
+    memcpy(result->signaturePrefix, out, 4);
+    memcpy(result->signaturePrefix + 4, out + 5, 8);
+    cursor = out + 14;
+    for (SIZE_T i = 0; i < methodSize; ++i)
+        *cursor++ = method[i] >= 'a' && method[i] <= 'z' ? method[i] - ('a' - 'A') : method[i];
+    ++cursor;
+    if (parts.dwUrlPathLength) { memcpy(cursor, parts.lpszUrlPath, parts.dwUrlPathLength); cursor += parts.dwUrlPathLength; }
+    else *cursor++ = '/';
+    if (parts.dwExtraInfoLength) { memcpy(cursor, parts.lpszExtraInfo, parts.dwExtraInfoLength); cursor += parts.dwExtraInfoLength; }
+    ++cursor;
+    memcpy(cursor, authorization, authSize); cursor += authSize + 1;
+    for (SIZE_T i = 0; i < policy->headerCount; ++i)
+    {
+        SIZE_T length = strlen(values[i]);
+        memcpy(cursor, values[i], length); cursor += length + 1;
+    }
+    if (take) memcpy(cursor, body, take);
+    result->bytes = out;
+    result->size = size;
+    hr = S_OK;
+cleanup:
+    free(values);
+    return hr;
+}
+
+HRESULT xodus_pack_signing_request(const struct xodus_signing_policy *policy,
+    const char *method, const char *url, const char *authorization,
+    SIZE_T headerCount, const struct xodus_signing_header *headers,
+    SIZE_T bodySize, const void *body, const FILETIME *timestamp,
+    struct xodus_signing_request *result)
+{
+    char *normalized = NULL;
+    HRESULT hr;
+    if (result) memset(result, 0, sizeof(*result));
+    if (FAILED(hr = secure_handshake_url(url, &normalized))) return hr;
+    hr = pack_https_request(policy, method, normalized ? normalized : url, authorization,
+        headerCount, headers, bodySize, body, timestamp, result);
+    free(normalized);
+    return hr;
+}
