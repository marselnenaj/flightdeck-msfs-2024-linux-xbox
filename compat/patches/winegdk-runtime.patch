+namespace {
+struct GameLicense {
+    char skuStoreId[18];
+    BYTE isActive,isTrialOwnedByThisUser,isDiscLicense,isTrial;
+    UINT32 trialTimeRemainingInSeconds;
+    char trialUniqueId[64];
