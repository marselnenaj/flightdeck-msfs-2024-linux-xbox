+static_assert(sizeof(GameLicense)==104 && offsetof(GameLicense,expirationDate)==96,"XStoreGameLicense x64 ABI");
+struct TitleBinding {char storeId[13];char family[65];char version[24];};
+TitleBinding title{};
+SRWLOCK titleLock=SRWLOCK_INIT;
+
+bool whitespace(const xmlChar *text) {
+    if(!text)return true;
+    for(;*text;++text)if(*text!=' '&&*text!='\t'&&*text!='\r'&&*text!='\n')return false;
+    return true;
+}
+const char *text_of(xmlNode *node,bool empty=false) {
+    if(!node||node->properties||node->ns)return nullptr;
+    if(!node->children)return empty?"":nullptr;
+    if(node->children->next||node->children->type!=XML_TEXT_NODE)return nullptr;
+    return reinterpret_cast<const char*>(node->children->content);
+}
+bool decimal(const char *text,UINT64 maximum,UINT64 *out) {
+    if(!text||!*text)return false;
+    UINT64 value=0;
+    for(;*text;++text){if(*text<'0'||*text>'9')return false;UINT64 digit=*text-'0';if(value>(maximum-digit)/10)return false;value=value*10+digit;}
+    *out=value;return true;
+}
+bool boolean_value(const char *text,BYTE *out) {
+    if(!text)return false;
+    if(!strcmp(text,"true")){*out=1;return true;}
+    if(!strcmp(text,"false")){*out=0;return true;}
+    return false;
+}
+bool upper_alnum(const char *text,SIZE_T size) {
+    if(!text||strlen(text)!=size)return false;
+    for(SIZE_T i=0;i<size;++i)if(!((text[i]>='A'&&text[i]<='Z')||(text[i]>='0'&&text[i]<='9')))return false;
+    return true;
+}
+bool lower_hex(const char *text) {
+    if(!text||strlen(text)!=64)return false;
+    for(unsigned i=0;i<64;++i)if(!((text[i]>='0'&&text[i]<='9')||(text[i]>='a'&&text[i]<='f')))return false;
+    return true;
+}
+HRESULT failure_status(const char *status) {
+    if(!strcmp(status,"Unavailable"))return HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+    if(!strcmp(status,"Expired"))return HRESULT_FROM_WIN32(ERROR_LOGON_FAILURE);
+    if(!strcmp(status,"NotLicensed"))return E_ACCESSDENIED;
+    if(!strcmp(status,"Unsupported"))return E_NOTIMPL;
+    if(!strcmp(status,"InvalidRequest"))return E_INVALIDARG;
+    if(!strcmp(status,"Error"))return E_FAIL;
+    if(!strcmp(status,"Timeout"))return HRESULT_FROM_WIN32(ERROR_TIMEOUT);
+    return HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+}
+HRESULT parse_license(const BYTE *bytes,UINT32 length,const char *expectedStoreId,GameLicense *out) {
+    static const char *names[]={"Status","SkuStoreId","IsActive","IsTrialOwnedByThisUser","IsDiscLicense","IsTrial","TrialTimeRemainingInSeconds","TrialUniqueId","ExpirationDate","Revision"};
+    const char *values[10]{};unsigned seen=0;
+    HRESULT hr=HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
