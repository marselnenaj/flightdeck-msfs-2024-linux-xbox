+    free((void *)device_rps);
+    if (response) IMsaTokenResponse_Release(response);
+    if (operation) IAsyncOperation_IMsaTokenResponse_Release(operation);
+    ReleaseSRWLockExclusive(&default_user_load_lock);
+    return hr;
+}
