+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Authenticated Store license query transport. The broker verifies licensing;
+ * this side validates the exact response schema and public ABI only. */
+#include "../../private.h"
+#include "Structs.h"
+#include "StoreLicenseProvider.h"
+#include "robuffer.h"
+#include <bcrypt.h>
+#include <libxml/parser.h>
