+    if(FAILED(hr=message->put_Length(size)))goto cleanup;
+    packet=new(std::nothrow)XodusIPCPacket(MagicHeaderType::XML,updates?17:7,message);
+    if(!packet){hr=E_OUTOFMEMORY;goto cleanup;}
+    if(FAILED(hr=xodus_ipclayer->SendRequestAsync(packet,&operation)))goto cleanup;
+    if(FAILED(hr=wait_response(operation,cancelled)))goto cleanup;
+    if(FAILED(hr=operation->GetResults(&response)))goto cleanup;
+    if(!response){hr=E_UNEXPECTED;goto cleanup;}
+    if(FAILED(hr=response->get_Magic(&magic))||FAILED(hr=response->get_MessageType(&kind)))goto cleanup;
+    if(magic!=MagicHeaderType::XML||kind!=(updates?18:8)){hr=HRESULT_FROM_WIN32(ERROR_INVALID_DATA);goto cleanup;}
+    if(FAILED(hr=response->get_Message(&reply)))goto cleanup;
+    if(!reply){hr=E_UNEXPECTED;goto cleanup;}
+    if(FAILED(hr=reply->get_Length(&length))||FAILED(hr=reply->QueryInterface<IBufferByteAccess>(&replyAccess))||FAILED(hr=replyAccess->Buffer(&bytes)))goto cleanup;
+    if(updates) {
+        hr=HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+        xmlDoc *doc=(bytes&&length&&length<=1024&&!memchr(bytes,0,length))?xmlReadMemory(reinterpret_cast<const char*>(bytes),length,"store-updates.xml","UTF-8",XML_PARSE_NONET|XML_PARSE_NOERROR|XML_PARSE_NOWARNING):nullptr;
+        xmlNode *root=doc?xmlDocGetRootElement(doc):nullptr;
+        if(doc&&!doc->intSubset&&!doc->extSubset&&root&&!root->properties&&!root->ns&&!xmlStrcmp(root->name,BAD_CAST "StorePackageUpdatesResponse")) {
+            xmlNode *status=nullptr;bool valid=true;
+            for(xmlNode *n=root->children;n;n=n->next) {
+                if(n->type==XML_TEXT_NODE&&whitespace(n->content))continue;
+                if(n->type!=XML_ELEMENT_NODE||status||xmlStrcmp(n->name,BAD_CAST "Status")){valid=false;break;}status=n;
+            }
+            const char *value=valid?text_of(status):nullptr;
+            if(value)hr=!strcmp(value,"Current")?S_OK:!strcmp(value,"DifferentRevision")?HRESULT_FROM_WIN32(ERROR_REVISION_MISMATCH):failure_status(value);
+        }
+        if(doc)xmlFreeDoc(doc);
+    } else hr=parse_license(bytes,length,durable?durable:binding.storeId,out);
+    if(!updates&&SUCCEEDED(hr)){
+        FILETIME now;GetSystemTimeAsFileTime(&now);
+        UINT64 ticks=(static_cast<UINT64>(now.dwHighDateTime)<<32)|now.dwLowDateTime;
+        INT64 seconds=static_cast<INT64>(ticks/10000000)-11644473600LL;
+        if(out->expirationDate<=seconds || (durable&&out->expirationDate>seconds+60)){memset(out,0,sizeof(*out));hr=HRESULT_FROM_WIN32(ERROR_LOGON_FAILURE);}
+    }
+cleanup:
+    SecureZeroMemory(request,sizeof(request));
+    if(InterlockedCompareExchange(cancelled,0,0)){memset(out,0,sizeof(*out));hr=E_ABORT;}
+    if(replyAccess)replyAccess->Release();if(access)access->Release();
+    if(reply)reply->Release();if(message)message->Release();
+    if(response)response->Release();if(packet)packet->Release();if(operation)operation->Release();if(factory)factory->Release();
+    if(SUCCEEDED(apartment))RoUninitialize();return hr;
+}
+
+extern "C" HRESULT WINAPI XodusStoreQueryGameLicense(void *owned,volatile LONG *cancelled,void *output) {
+    return query_license(owned,nullptr,cancelled,output);
+}
+extern "C" HRESULT WINAPI XodusStoreQueryDurableLicense(void *owned,const char *store_id,volatile LONG *cancelled,void *output) {
+    if(!store_id)return E_POINTER;
+    return query_license(owned,store_id,cancelled,output);
+}
+
+extern "C" HRESULT WINAPI XodusStoreCheckPackageUpdates(void *owned,volatile LONG *cancelled) {
+    GameLicense unused{};
+    return query_license(owned,nullptr,cancelled,&unused,true);
+}
