+    IBufferFactory *factory=nullptr;IBuffer *message=nullptr,*reply=nullptr;
+    IBufferByteAccess *access=nullptr,*replyAccess=nullptr;
+    IXodusIPCPacket *packet=nullptr,*response=nullptr;
+    IAsyncOperation<IXodusIPCPacket*> *operation=nullptr;
+    BYTE *bytes=nullptr;UINT32 length=0;UINT16 kind=0;MagicHeaderType magic;
+    HSTRING_HEADER header;HSTRING className=nullptr;
+    HRESULT apartment=RoInitialize(RO_INIT_MULTITHREADED);
