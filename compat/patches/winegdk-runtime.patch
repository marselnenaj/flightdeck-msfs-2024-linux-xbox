+        if(!*binding.version||GetEnvironmentVariableA("XODUS_STORE_PACKAGE_SCOPE",scope,sizeof(scope))!=24||strcmp(scope,"FlightdeckBaseGameOnlyV1"))return E_NOTIMPL;
+    }
+    char market[3]={};
+    SetLastError(ERROR_SUCCESS);
+    DWORD market_length=GetEnvironmentVariableA("XODUS_STORE_MARKET",market,sizeof(market));
+    if(!market_length&&GetLastError()==ERROR_ENVVAR_NOT_FOUND){
