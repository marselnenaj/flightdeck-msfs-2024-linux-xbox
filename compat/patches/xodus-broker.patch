+++ w/crates/xodus-service/src/store_health.rs
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! Explicit read-only check using the same Store brokers as the game. No
+//! checkout credentials, purchase endpoints or device provisioning. Expiring
+//! credentials are silently renewed through the same broker path as the game.
+use crate::{store_account::BrokerStoreAccount, store_collections::model,
+    store_inventory, store_license::{self, Status}};
+use serde::Deserialize;
+use serde_json::json;
+use std::{io::{Read, Write}, sync::Arc, time::Duration};
+use xodus::tokens::TokenManager;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Config { store_id: String, title_id: u32, msa_app_id: String, package_family_name: String, market: String }
+fn parse(bytes: &[u8]) -> Result<Config, ()> {
+    if bytes.len() > 2048 { return Err(()); }
+    let c: Config = serde_json::from_slice(bytes).map_err(|_| ())?;
+    if !model::valid_id(&c.store_id, 12) || c.title_id == 0 || !model::valid_app_id(&c.msa_app_id)
+        || c.market.len()!=2 || !c.market.bytes().all(|b| b.is_ascii_uppercase())
+        || c.package_family_name.is_empty() || c.package_family_name.len()>255
+        || !c.package_family_name.bytes().all(|b| b.is_ascii_alphanumeric() || b"_.-".contains(&b)) { return Err(()); }
+    Ok(c)
+}
+fn emit(stage: &str, state: &str, code: &str) {
+    let value = json!({"stage":stage,"state":state,"code":code});
+    let _ = writeln!(std::io::stdout(), "{value}"); let _ = std::io::stdout().flush();
+}
+fn code(s: Status) -> &'static str { match s {
+    Status::Unavailable=>"sign_in_required", Status::Expired=>"expired", Status::NotLicensed=>"not_licensed",
+    Status::Unsupported=>"unsupported", Status::InvalidRequest=>"invalid_config", Status::Error=>"connection", Status::Timeout=>"timeout",
+} }
+#[derive(Deserialize)]
+#[serde(rename_all="PascalCase")]
+struct Account { status: String, context: Option<String> }
+fn account(state: &mut BrokerStoreAccount, tokens: &TokenManager) -> Result<String, &'static str> {
+    let bytes=state.response(b"<StoreAccountContextRequest/>", tokens).map_err(|_| "sign_in_required")?;
+    let r: Account=quick_xml::de::from_reader(bytes.as_slice()).map_err(|_| "sign_in_required")?;
+    match r.status.as_str() {
+        "Available" => r.context.filter(|s| s.len()==64).ok_or("sign_in_required"),
+        "Expired" => Err("expired"), _=>Err("sign_in_required"),
+    }
+}
+async fn check(c: Config, tokens: Arc<TokenManager>) {
+    let mut state=BrokerStoreAccount::default();
+    emit("account","running","checking");
+    let context=match xodus::tokens::session::ensure_session(&tokens).await {
+        Ok(())=>account(&mut state, &tokens), Err(e)=>Err(e.code()),
+    };
+    emit("account",if context.is_ok(){"passed"}else{"failed"},context.as_ref().err().copied().unwrap_or("local_session"));
+    emit("catalog","running","checking");
+    let catalog = async {
+        let client=reqwest::Client::builder().timeout(Duration::from_secs(15)).redirect(reqwest::redirect::Policy::none()).build().map_err(|_|Status::Error)?;
+        let v=store_license::fetch_catalogue(&client,&c.store_id,&c.market).await?;
+        if v["Product"]["ProductId"]!=c.store_id {return Err(Status::Error);} Ok(())
+    }.await;
+    emit("catalog",if catalog.is_ok(){"passed"}else{"failed"},catalog.err().map(code).unwrap_or("available"));
+    let context=match context { Ok(context)=>context, Err(code)=>{for stage in ["license","library"]{emit(stage,"skipped",code);}return;} };
+    emit("license","running","checking");
+    let r=store_license::Request {context:context.clone(),store_id:c.store_id.clone(),package_family_name:c.package_family_name,market:c.market.clone(),durable_store_id:None};
+    let license=store_license::LicenseCache::default().query(&r,tokens.clone()).await;
+    if !state.validate_context(&context,&tokens) {for stage in ["license","library"]{emit(stage,"failed","account_changed");}return;}
+    let license=license.and_then(|v|if v.is_active {Ok(())}else{Err(Status::NotLicensed)});
+    emit("license",if license.is_ok(){"passed"}else{"failed"},license.err().map(code).unwrap_or("verified"));
+    emit("library","running","checking");
+    let mut r=store_inventory::Request{context:context.clone(),store_id:c.store_id,title_id:c.title_id,msa_app_id:c.msa_app_id,market:c.market,kinds:31,page_size:100,continuation:String::new()};
+    let mut broker=store_inventory::Broker::default();
+    let library=async {
+        for _ in 0..200 {
+            let page=broker.query(&r,tokens.clone()).await?;
+            if !page.snapshot.unknown.is_empty() {return Err(Status::Unsupported);}
+            if page.continuation.is_empty(){return Ok(());}
+            r.continuation=page.continuation;
+        }
+        Err(Status::Unsupported)
+    }.await;
+    if !state.validate_context(&context,&tokens) {emit("library","failed","account_changed");return;}
+    emit("library",if library.is_ok(){"passed"}else{"failed"},library.err().map(code).unwrap_or("available"));
+}
+pub async fn run() {
+    let mut bytes=Vec::new();
+    let config=std::io::stdin().take(2049).read_to_end(&mut bytes).map_err(|_|()).and_then(|_|parse(&bytes));
+    let Ok(config)=config else {emit("account","failed","invalid_config");return;};
+    if xodus::secrets::init_secrets().is_err(){emit("account","failed","keyring");return;}
+    let tokens=Arc::new(TokenManager::with_keychain_and_memory());
+    // Isolate dependency panics; no raw error text reaches the launcher.
+    let mut work=tokio::spawn(check(config,tokens));
+    match tokio::time::timeout(Duration::from_secs(115),&mut work).await {
+        Ok(Ok(()))=>(),
+        Ok(Err(_))=>emit("check","failed","error"),
+        Err(_)=>{work.abort();let _=work.await;emit("check","failed","timeout");},
+    }
+    xodus::secrets::destroy_secrets();
+}
+#[cfg(test)] mod tests {
+    use super::*;
+    #[test] fn input_is_public_and_bounded() {
+        let good=json!({"store_id":"ABCD1234EFGH","title_id":1,"msa_app_id":"0000000012345678","package_family_name":"Game_publisher","market":"AT"});
+        assert!(parse(&serde_json::to_vec(&good).unwrap()).is_ok());
+        for (key,value) in [("market",json!("<xml>")),("store_id",json!("bad")),("title_id",json!(0)),("package_family_name",json!("../secret")),("token",json!("private"))] {
+            let mut bad=good.clone();bad[key]=value;assert!(parse(&serde_json::to_vec(&bad).unwrap()).is_err());
+        }
+    }
+    #[tokio::test] async fn missing_account_does_not_create_credentials() {
+        let tokens=TokenManager::with_memory(); let mut state=BrokerStoreAccount::default();
+        assert_eq!(account(&mut state,&tokens).unwrap_err(),"sign_in_required");
+        assert!(tokens.get_user_sts_token().is_err());assert!(tokens.get_device_sts_token().is_err());
+    }
+}
diff --git c/crates/xodus-service/src/store_inventory.rs w/crates/xodus-service/src/store_inventory.rs
new file mode 100644
index 0000000..b7ce1e2
--- /dev/null
+++ w/crates/xodus-service/src/store_inventory.rs
@@ -0,0 +1,533 @@
+//! Current Store account's direct and satisfying entitlements for this title.
+//! Exhaust the authenticated library before filtering; catalog visibility is
+//! never evidence of ownership. Device-shared entitlements are not covered.
+use crate::store_collections::{
+    auth,
+    model::{self, Item, Record, Snapshot},
+};
+use crate::store_license::{self, Status};
+use quick_xml::{Reader, events::Event};
+use serde::Deserialize;
+use serde_json::{Value, json};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    sync::Arc,
+    time::{Duration, Instant},
+};
+use xodus::tokens::TokenManager;
+
+#[derive(Clone, Deserialize, PartialEq, Eq)]
+#[serde(
+    rename = "StoreInventoryRequest",
+    rename_all = "PascalCase",
+    deny_unknown_fields
+)]
+pub struct Request {
+    pub context: String,
+    pub store_id: String,
+    pub title_id: u32,
+    pub msa_app_id: String,
+    pub market: String,
+    pub kinds: u32,
+    pub page_size: usize,
+    #[serde(default)]
+    pub continuation: String,
+}
+fn context_id(s: &str) -> bool {
+    s.len() == 64
+        && s.bytes()
+            .all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c))
+}
+pub fn parse_request(bytes: &[u8]) -> Result<Request, Status> {
+    let bytes = bytes.strip_suffix(&[0]).unwrap_or(bytes);
+    if bytes.is_empty() || bytes.len() > 2048 || bytes.contains(&0) {
+        return Err(Status::InvalidRequest);
+    }
+    let mut reader = Reader::from_reader(bytes);
+    let mut depth = 0;
+    let mut root = false;
+    loop {
+        match reader.read_event().map_err(|_| Status::InvalidRequest)? {
+            Event::Start(e) => {
+                if e.attributes().next().is_some() || depth > 1 {
+                    return Err(Status::InvalidRequest);
+                }
+                if depth == 0 {
+                    if root || e.name().as_ref() != "StoreInventoryRequest" {
+                        return Err(Status::InvalidRequest);
+                    }
+                    root = true;
+                } else if ![
+                    "Context",
+                    "StoreId",
+                    "TitleId",
+                    "MsaAppId",
+                    "Market",
+                    "Kinds",
+                    "PageSize",
+                    "Continuation",
+                ]
+                .contains(&e.name().as_ref())
+                {
+                    return Err(Status::InvalidRequest);
+                }
+                depth += 1;
+            }
+            Event::End(_) => {
+                if depth == 0 {
+                    return Err(Status::InvalidRequest);
+                }
+                depth -= 1;
+            }
+            Event::Text(t) if depth == 2 || t.as_ref().chars().all(|c| c.is_ascii_whitespace()) => {
+                ()
+            }
+            Event::Eof => break,
+            _ => return Err(Status::InvalidRequest),
+        }
+    }
+    if !root || depth != 0 {
+        return Err(Status::InvalidRequest);
+    }
+    let r: Request = quick_xml::de::from_reader(bytes).map_err(|_| Status::InvalidRequest)?;
+    if !context_id(&r.context)
+        || !model::valid_id(&r.store_id, 12)
+        || r.title_id == 0
+        || !model::valid_app_id(&r.msa_app_id)
+        || r.market.len() != 2
+        || !r.market.bytes().all(|c| c.is_ascii_uppercase())
+        || r.kinds == 0
+        || r.kinds & !31 != 0
+        || !(1..=100).contains(&r.page_size)
+        || (!r.continuation.is_empty() && !context_id(&r.continuation))
+    {
+        return Err(Status::InvalidRequest);
+    }
+    Ok(r)
+}
+pub struct Page {
+    pub snapshot: Snapshot,
+    pub continuation: String,
+}
+struct Pending {
+    request: Request,
+    items: Vec<Item>,
+    observed_at: i64,
+    expires_at: i64,
+    created: Instant,
+    cursor: String,
+    offset: usize,
+}
+#[derive(Default)]
+pub struct Broker {
+    pending: Vec<Pending>,
+}
+impl Broker {
+    pub fn clear(&mut self) {
+        self.pending.clear();
+    }
+    pub async fn query(&mut self, r: &Request, tokens: Arc<TokenManager>) -> Result<Page, Status> {
+        self.pending.retain(|p| {
+            p.created.elapsed() < Duration::from_secs(30)
+                && p.expires_at > chrono::Utc::now().timestamp()
+        });
+        if !r.continuation.is_empty() {
+            let index = self
+                .pending
+                .iter()
+                .position(|p| p.cursor == r.continuation && same_query(&p.request, r))
+                .ok_or(Status::Expired)?;
+            let result = take_page(&mut self.pending[index]);
+            self.pending.retain(|p| p.offset < p.items.len());
+            return result;
+        }
+        let pending = tokio::time::timeout(Duration::from_secs(35), collect(r, tokens))
+            .await
+            .map_err(|_| Status::Timeout)??;
+        if self.pending.len() >= 8 {
+            return Err(Status::Unavailable);
+        }
+        self.pending.push(pending);
+        let result = take_page(self.pending.last_mut().ok_or(Status::Error)?);
+        self.pending.retain(|p| p.offset < p.items.len());
+        result
+    }
+}
+fn same_query(a: &Request, b: &Request) -> bool {
+    a.context == b.context
+        && a.store_id == b.store_id
+        && a.title_id == b.title_id
+        && a.msa_app_id == b.msa_app_id
+        && a.market == b.market
+        && a.kinds == b.kinds
+        && a.page_size == b.page_size
+}
+fn token() -> String {
+    rand::random::<[u8; 32]>()
+        .iter()
+        .map(|b| format!("{b:02x}"))
+        .collect()
+}
+fn take_page(p: &mut Pending) -> Result<Page, Status> {
+    let now = chrono::Utc::now().timestamp();
+    if p.expires_at <= now || p.observed_at > now || p.created.elapsed() >= Duration::from_secs(30)
+    {
+        return Err(Status::Expired);
+    }
+    let start = p.offset;
+    let mut end = start;
+    let mut products = BTreeSet::new();
+    while end < p.items.len() {
+        let id = &p.items[end].store_id[..12];
+        let mut group_end = end + 1;
+        while group_end < p.items.len() && &p.items[group_end].store_id[..12] == id { group_end += 1; }
+        if products.len() == p.request.page_size || group_end - start > 100 { break; }
+        products.insert(id.to_owned());
+        end = group_end;
+    }
+    if end == start && start < p.items.len() { return Err(Status::Unsupported); }
+    let continuation = if end < p.items.len() {
+        token()
+    } else {
+        String::new()
+    };
+    let page = Page {
+        snapshot: Snapshot {
+            items: p.items[start..end].to_vec(),
+            absent: vec![],
+            unknown: vec![],
+            observed_at: p.observed_at,
+            expires_at: p.expires_at,
+        },
+        continuation: continuation.clone(),
+    };
+    // Only advance after proving that the complete frame fits the IPC contract.
+    encode_page(&page)?;
+    p.offset = end;
+    p.cursor = continuation;
+    Ok(page)
+}
+fn active_items(records: Vec<Record>, kinds: u32, now: i64) -> Result<Vec<Item>, Status> {
+    let mut items = BTreeMap::<String, Item>::new();
+    for r in records {
+        if !r.active
+            || r.item.end_date <= now
+            || r.item.start_date > now
+            || r.item.kind & kinds == 0
+        {
+            continue;
+        }
+        if r.item.acquired_date > now {
+            return Err(Status::Unsupported);
+        }
+        if let Some(old) = items.get(&r.item.store_id) {
+            if old != &r.item {
+                return Err(Status::Unsupported);
+            }
+        } else {
+            items.insert(r.item.store_id.clone(), r.item);
+        }
+    }
+    Ok(items.into_values().collect())
+}
+fn associated(value: &Value, product: &str, parent: &str) -> Result<bool, Status> {
+    let p = &value["Product"];
+    if p["ProductId"].as_str() != Some(product) {
+        return Err(Status::Unsupported);
+    }
+    if product == parent {
+        return Ok(true);
+    }
+    let markets = p["MarketProperties"]
+        .as_array()
+        .ok_or(Status::Unsupported)?;
+    for market in markets {
+        let related = market["RelatedProducts"]
+            .as_array()
+            .ok_or(Status::Unsupported)?;
+        for r in related {
+            if r["RelatedProductId"].as_str() == Some(parent)
+                && r["RelationshipType"].as_str() == Some("addOnParent")
+            {
+                return Ok(true);
+            }
+        }
+    }
+    Ok(false)
+}
+fn page_envelope(raw: &Value) -> Result<(BTreeSet<String>, Option<String>, usize), Status> {
+    let rows = raw["items"].as_array().filter(|v| v.len() <= 100).ok_or(Status::Unsupported)?;
+    let mut ids = BTreeSet::new();
+    for row in rows {
+        let id = row["productId"].as_str().filter(|s| model::valid_id(s, 12)).ok_or(Status::Unsupported)?;
+        ids.insert(id.to_owned());
+    }
+    // Reuse the strict page-envelope parser, with no rights interpreted yet.
+    let mut envelope = raw.clone(); envelope["items"] = json!([]);
+    let continuation = model::parse_page(&envelope)?.continuation;
+    Ok((ids, continuation, rows.len()))
+}
+fn scoped_page(mut raw: Value, allowed: &BTreeSet<String>) -> Result<model::Page, Status> {
+    page_envelope(&raw)?;
+    raw["items"].as_array_mut().ok_or(Status::Unsupported)?.retain(|row|
+        row["productId"].as_str().is_some_and(|id| allowed.contains(id)));
+    model::parse_page(&raw)
+}
+async fn collect(r: &Request, tokens: Arc<TokenManager>) -> Result<Pending, Status> {
+    let binding = model::Request {
+        context: r.context.clone(),
+        store_id: r.store_id.clone(),
+        title_id: r.title_id,
+        msa_app_id: r.msa_app_id.clone(),
+        products: vec![],
+    };
+    let mut session = auth::Session::create(&binding, &tokens).await?;
+    let mut body = json!({"market":"neutral","validityType":"All","maxPageSize":100,"excludeDuplicates":true,"expandSatisfyingItems":true,"entitlementFilters":["*:Game","*:Durable","*:Pass","*:Consumable","*:UnmanagedConsumable"]});
+    // Establish title scope before interpreting rights. An unsupported trial or
+    // sharing record for another game must not invalidate this game's Store.
+    // All raw pages and IDs are still validated and exhausted first.
+    let mut raw_pages = Vec::new();
+    let mut roots = BTreeSet::new();
+    let mut cursors = BTreeSet::new();
+    let mut total = 0;
+    loop {
+        let raw = session.page(&body).await?;
+        let (ids, continuation, count) = page_envelope(&raw)?;
+        total += count;
+        if raw_pages.len() >= 20 || total > 1000 { return Err(Status::Unsupported); }
+        roots.extend(ids);
+        raw_pages.push(raw);
+        if let Some(cursor) = continuation {
+            if !cursors.insert(cursor.clone()) || raw_pages.len() == 20 { return Err(Status::Unsupported); }
+            body["continuationToken"] = Value::String(cursor);
+        } else { break; }
+    }
+    let client = reqwest::Client::builder()
+        .timeout(Duration::from_secs(12))
+        .redirect(reqwest::redirect::Policy::none())
+        .build()
+        .map_err(|_| Status::Error)?;
+    let mut allowed = BTreeSet::new();
+    let mut workers = tokio::task::JoinSet::new();
+    let mut roots = roots.into_iter();
+    loop {
+        while workers.len() < 4 {
+            let Some(product) = roots.next() else {
+                break;
+            };
+            let client = client.clone();
+            let market = r.market.clone();
+            let parent = r.store_id.clone();
+            workers.spawn(async move {
+                let value = store_license::fetch_catalogue(&client, &product, &market).await?;
+                Ok::<_, Status>((product.clone(), associated(&value, &product, &parent)?))
+            });
+        }
+        match workers.join_next().await {
+            Some(result) => {
+                let (id, yes) = result.map_err(|_| Status::Error)??;
+                if yes {
+                    allowed.insert(id);
+                }
+            }
+            None => break,
+        }
+    }
+    let now = chrono::Utc::now().timestamp();
+    let mut pages = model::BatchPages::default();
+    for raw in raw_pages { pages.push(scoped_page(raw, &allowed)?)?; }
+    let (records, parent_expiry) = pages.finish(&r.store_id, now)?;
+    let items = active_items(records, r.kinds, now)?;
+    let expires_at = items.iter().map(|i| i.end_date).fold(
+        session.expires_at.min(parent_expiry).min(now + 30),
+        i64::min,
+    );
+    if expires_at <= now {
+        return Err(Status::Expired);
+    }
+    Ok(Pending {
+        request: r.clone(),
+        items,
+        observed_at: now,
+        expires_at,
+        created: Instant::now(),
+        cursor: String::new(),
+        offset: 0,
+    })
+}
+fn encode_page(p: &Page) -> Result<Vec<u8>, Status> {
+    let s = Snapshot {
+        items: p.snapshot.items.clone(),
+        absent: vec![],
+        unknown: vec![],
+        observed_at: p.snapshot.observed_at,
+        expires_at: p.snapshot.expires_at,
+    };
+    let xml =
+        String::from_utf8(crate::store_collections::encode(Ok(s))).map_err(|_| Status::Error)?;
+    if !xml.contains("<Status>Available</Status>") {
+        return Err(Status::Expired);
+    }
+    let xml = xml.replace(
+        "</StoreCollectionsResponse>",
+        &format!(
+            "<Continuation>{}</Continuation></StoreCollectionsResponse>",
+            p.continuation
+        ),
+    );
+    if xml.len() > u16::MAX as usize {
+        return Err(Status::Unsupported);
+    }
+    Ok(xml.into_bytes())
+}
+pub fn encode(result: Result<Page, Status>) -> Vec<u8> {
+    match result.and_then(|p| encode_page(&p)) {
+        Ok(bytes) => bytes,
+        Err(status) => crate::store_collections::encode(Err(status)),
+    }
+}
