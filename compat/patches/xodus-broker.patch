@@ -0,0 +1,179 @@
+use super::*;
+use std::io::{Read, Write};
+use std::net::TcpListener;
+use std::time::Duration;
+
+fn fixture(
+    status: &str,
+    extra_headers: &str,
+    body: &str,
+) -> (String, std::thread::JoinHandle<String>) {
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let url = format!("http://{}/fixture", listener.local_addr().unwrap());
+    let response = format!(
+        "HTTP/1.1 {status}\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n{extra_headers}\r\n{body}",
+        body.len()
+    );
+    let thread = std::thread::spawn(move || {
+        let (mut socket, _) = listener.accept().unwrap();
+        socket
+            .set_read_timeout(Some(Duration::from_secs(3)))
+            .unwrap();
+        let mut request = Vec::new();
+        let header_end = loop {
+            let mut b = [0];
+            socket.read_exact(&mut b).unwrap();
+            request.extend(b);
+            assert!(request.len() < 16384);
+            if request.ends_with(b"\r\n\r\n") {
+                break request.len();
+            }
+        };
+        let head = String::from_utf8(request.clone())
+            .unwrap()
+            .to_ascii_lowercase();
+        let length: usize = head
+            .lines()
+            .find_map(|line| line.strip_prefix("content-length:"))
+            .unwrap()
+            .trim()
+            .parse()
+            .unwrap();
+        assert!(length < 16384);
+        request.resize(header_end + length, 0);
+        socket.read_exact(&mut request[header_end..]).unwrap();
+        socket.write_all(response.as_bytes()).unwrap();
+        String::from_utf8(request).unwrap()
+    });
+    (url, thread)
+}
+
+#[tokio::test]
+async fn all_oauth_flows_keep_request_body_auth_and_expected_fields() {
+    let device = r#"{"device_code":"synthetic-device","user_code":"fixture-code","verification_uri":"https://example.invalid/device","expires_in":600,"interval":1}"#;
+    let tokens = r#"{"access_token":"synthetic-access","token_type":"bearer","expires_in":60,"refresh_token":"synthetic-refresh","scope":"fixture-scope"}"#;
+    for flow in ["device", "poll", "code", "refresh"] {
+        let (url, recorded) = fixture("200 OK", "", if flow == "device" { device } else { tokens });
+        let mut auth = XalAuthenticator::default();
+        auth.app_params.client_secret = Some("synthetic-secret".into());
+        let client_id = auth.app_params.client_id.to_string();
+        let oauth = auth
+            .oauth_client()
+            .unwrap()
+            .set_token_uri(TokenUrl::new(url.clone()).unwrap())
+            .set_device_authorization_url(DeviceAuthorizationUrl::new(url).unwrap());
+        let http = oauth_http_client().unwrap();
+        tokio::time::timeout(Duration::from_secs(3), async {
+            match flow {
+                "device" => {
+                    let response: StandardDeviceAuthorizationResponse = oauth
+                        .exchange_device_code()
+                        .add_scope(Scope::new("fixture-scope".into()))
+                        .add_extra_param("response_type", "device_code")
+                        .request_async(&http)
+                        .await
+                        .unwrap();
+                    assert_eq!(response.device_code().secret(), "synthetic-device");
+                }
+                "poll" => {
+                    let response: StandardDeviceAuthorizationResponse =
+                        serde_json::from_str(device).unwrap();
+                    let tokens = oauth
+                        .exchange_device_access_token(&response)
+                        .request_async(&http, tokio::time::sleep, Some(Duration::from_secs(2)))
+                        .await
+                        .unwrap();
+                    assert_eq!(tokens.access_token().secret(), "synthetic-access");
+                }
+                "code" => {
+                    let tokens = oauth
+                        .exchange_code(AuthorizationCode::new("synthetic-code".into()))
+                        .set_redirect_uri(std::borrow::Cow::Owned(
+                            oauth2::RedirectUrl::new("https://example.invalid/callback".into())
+                                .unwrap(),
+                        ))
+                        .set_pkce_verifier(PkceCodeVerifier::new("synthetic-verifier".into()))
+                        .request_async(&http)
+                        .await
+                        .unwrap();
+                    assert_eq!(tokens.access_token().secret(), "synthetic-access");
+                }
+                _ => {
+                    let refresh = RefreshToken::new("synthetic-refresh".into());
+                    let tokens = oauth
+                        .exchange_refresh_token(&refresh)
+                        .add_scope(Scope::new("fixture-scope".into()))
+                        .request_async(&http)
+                        .await
+                        .unwrap();
+                    assert_eq!(tokens.access_token().secret(), "synthetic-access");
+                }
+            }
+        })
+        .await
+        .unwrap();
+        let request = recorded.join().unwrap();
+        let (head, body) = request.split_once("\r\n\r\n").unwrap();
+        assert!(head.starts_with("POST /fixture HTTP/1.1\r\n"));
+        assert!(!head.to_ascii_lowercase().contains("authorization: basic"));
+        let fields: HashMap<_, _> = form_urlencoded::parse(body.as_bytes())
+            .into_owned()
+            .collect();
+        assert_eq!(fields["client_id"], client_id);
+        assert_eq!(fields["client_secret"], "synthetic-secret");
+        match flow {
+            "device" => {
+                assert_eq!(fields["response_type"], "device_code");
+                assert_eq!(fields["scope"], "fixture-scope");
+            }
+            "poll" => {
+                assert_eq!(
+                    fields["grant_type"],
+                    "urn:ietf:params:oauth:grant-type:device_code"
+                );
+                assert_eq!(fields["device_code"], "synthetic-device");
+            }
+            "code" => {
+                assert_eq!(fields["grant_type"], "authorization_code");
+                assert_eq!(fields["code"], "synthetic-code");
+                assert_eq!(fields["code_verifier"], "synthetic-verifier");
+                assert_eq!(fields["redirect_uri"], "https://example.invalid/callback");
+            }
+            _ => {
+                assert_eq!(fields["grant_type"], "refresh_token");
+                assert_eq!(fields["refresh_token"], "synthetic-refresh");
+                assert_eq!(fields["scope"], "fixture-scope");
+            }
+        }
+    }
+}
+
+#[tokio::test]
+async fn oauth_transport_never_follows_a_token_redirect() {
+    let target = TcpListener::bind("127.0.0.1:0").unwrap();
+    target.set_nonblocking(true).unwrap();
+    let location = format!(
+        "Location: http://{}/must-not-receive-token\r\n",
+        target.local_addr().unwrap()
+    );
+    let (url, recorded) = fixture("302 Found", &location, "{}");
+    let oauth = XalAuthenticator::default()
+        .oauth_client()
+        .unwrap()
+        .set_token_uri(TokenUrl::new(url).unwrap());
+    let http = oauth_http_client().unwrap();
+    let result = tokio::time::timeout(
+        Duration::from_secs(3),
+        oauth
+            .exchange_code(AuthorizationCode::new("synthetic-code".into()))
+            .request_async(&http),
+    )
+    .await
+    .unwrap();
+    assert!(result.is_err());
+    recorded.join().unwrap();
+    assert_eq!(
+        target.accept().unwrap_err().kind(),
+        std::io::ErrorKind::WouldBlock
+    );
+}
