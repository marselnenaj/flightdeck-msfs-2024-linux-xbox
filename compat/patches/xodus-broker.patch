new file mode 100644
index 0000000..9962e13
--- /dev/null
+++ b/crates/xodus-service/src/store_account.rs
@@ -0,0 +1,171 @@
+//! Read-only selection of the broker's real configured MSA account. No XUser,
+//! authentication exchange, credential write, or license assertion is involved.
+use quick_xml::{Reader, events::Event};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use xodus::models::{secrets::Token, soap};
+use xodus::tokens::TokenManager;
+
+#[derive(PartialEq, Eq)]
+struct Snapshot { digest: [u8; 32], expires_at: i64, identity: Option<[u8;32]> }
+
+#[derive(Default)]
+pub struct BrokerStoreAccount {
+    // Deliberately no Debug; only a digest and opaque random ID survive a read.
+    selected: Option<(Snapshot, String)>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct StoreAccountContextRequest {}
+
+#[derive(Clone, Copy, Serialize, PartialEq, Eq, Debug)]
+enum Status { Available, Unavailable, Expired }
+
+#[derive(Serialize)]
+#[serde(rename = "StoreAccountContextResponse", rename_all = "PascalCase")]
+struct Response {
+    status: Status,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    context: Option<String>,
+}
+
+fn valid_request(input: &[u8]) -> Result<(), ()> {
+    // Existing native XML packets may include one trailing terminator.
+    let input = input.strip_suffix(&[0]).unwrap_or(input);
+    if input.len() > 128 || input.contains(&0) { return Err(()); }
+    let mut reader = Reader::from_reader(input);
+    let mut roots = 0;
+    let mut depth = 0;
+    loop {
+        match reader.read_event().map_err(|_| ())? {
+            Event::Start(element) => {
+                if depth != 0 || element.name().as_ref() != "StoreAccountContextRequest"
+                    || element.attributes().next().is_some() { return Err(()); }
+                roots += 1; depth += 1;
+            }
+            Event::Empty(element) => {
+                if depth != 0 || element.name().as_ref() != "StoreAccountContextRequest"
+                    || element.attributes().next().is_some() { return Err(()); }
+                roots += 1;
+            }
+            Event::End(_) => { if depth != 1 { return Err(()); } depth -= 1; }
+            Event::Text(text) if text.as_ref().chars().all(|c| c.is_ascii_whitespace()) => (),
+            Event::Decl(_) if roots == 0 => (),
+            Event::Eof => break,
+            _ => return Err(()),
+        }
+    }
+    if roots != 1 || depth != 0 { return Err(()); }
+    let _: StoreAccountContextRequest = quick_xml::de::from_reader(input).map_err(|_| ())?;
+    Ok(())
+}
+
+fn snapshot(tokens: &TokenManager) -> Result<Snapshot, Status> {
+    let Token::Legacy(token) = tokens.get_user_sts_token().map_err(|_| Status::Unavailable)?
+        else { return Err(Status::Unavailable); };
+    if token.token.is_empty() || token.token.len() > 1024 * 1024 { return Err(Status::Unavailable); }
+    // Parse the same encrypted credential the real MSA exchange consumes. This
+    // validates local structure only; current server acceptance is not implied.
+    let encrypted: soap::EncryptedData = quick_xml::de::from_str(&token.token)
+        .map_err(|_| Status::Unavailable)?;
+    if encrypted.cipher_data.cipher_value.is_empty() { return Err(Status::Unavailable); }
+    let expiry = chrono::DateTime::parse_from_rfc3339(&token.lifetime.expires)
+        .map_err(|_| Status::Unavailable)?.timestamp();
+    let bytes = serde_json::to_vec(&token).map_err(|_| Status::Unavailable)?;
+    let identity=tokens.get_user().ok().filter(|u| !u.puid.is_empty()).map(|u|Sha256::digest(u.puid.as_bytes()).into());
+    Ok(Snapshot { digest: Sha256::digest(bytes).into(), expires_at: expiry, identity })
+}
+
+impl BrokerStoreAccount {
+    pub fn response(&mut self, request: &[u8], tokens: &TokenManager) -> Result<Vec<u8>, ()> {
+        valid_request(request)?;
+        self.response_at(tokens, chrono::Utc::now().timestamp())
+    }
+
+    fn response_at(&mut self, tokens: &TokenManager, now: i64) -> Result<Vec<u8>, ()> {
+        let current = snapshot(tokens).and_then(|snapshot|
+            if snapshot.expires_at <= now { Err(Status::Expired) } else { Ok(snapshot) });
+        let response = match current {
+            Ok(snapshot) => {
+                if !self.selected.as_ref().is_some_and(|(old, _)| old == &snapshot || old.identity.is_some() && old.identity==snapshot.identity) {
+                    let random: [u8; 32] = rand::random();
+                    // A zero context is reserved as invalid by the native parser.
+                    if random == [0; 32] { return Err(()); }
+                    let context = random.iter().map(|byte| format!("{byte:02x}")).collect();
+                    self.selected = Some((snapshot, context));
+                } else if let Some((old,_))=&mut self.selected {
+                    *old=snapshot;
+                }
+                Response { status: Status::Available, context: self.selected.as_ref().map(|(_, value)| value.clone()) }
+            }
+            Err(status) => { self.selected = None; Response { status, context: None } }
+        };
+        quick_xml::se::to_string(&response).map(String::into_bytes).map_err(|_| ())
+    }
+
+    /// A normal STS refresh does not switch accounts. License operations require
+    /// real broker metadata; it remains private and is never returned by IPC.
+    pub fn validate_context(&mut self,context:&str,tokens:&TokenManager)->bool {
+        let Ok(current)=snapshot(tokens) else{self.selected=None;return false;};
+        let now=chrono::Utc::now().timestamp();
+        let same_account=self.selected.as_ref().is_some_and(|(old,_)|current.expires_at>now && current.identity.is_some() && old.identity==current.identity);
+        if !same_account {self.selected=None;return false;}
+        let valid=self.selected.as_ref().is_some_and(|(_,id)|id==context);
+        if valid {if let Some((old,_))=&mut self.selected {*old=current;}}
+        valid
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use xodus::models::secrets::LegacyToken;
+    use xodus::tokens::PASSPORT_STS;
+    fn seed(tokens: &TokenManager, cipher: &str, expiry: &str) {
+        let token = LegacyToken {
+            key_name: Some(PASSPORT_STS.into()),
+            token: quick_xml::se::to_string(&soap::EncryptedData::binary_da_token(cipher.into())).unwrap(),
+            binary_secret: None, tpm_key: None,
+            lifetime: soap::Timestamp { id: None, created: "2020-01-01T00:00:00Z".into(), expires: expiry.into() },
+        };
+        tokens.save_user_token(PASSPORT_STS.into(), Token::Legacy(token)).unwrap();
+    }
+    #[test]
+    fn empty_and_terminated_requests_only() {
+        for valid in [b"<StoreAccountContextRequest/>".as_slice(), b"<StoreAccountContextRequest/>\0", b"<StoreAccountContextRequest></StoreAccountContextRequest>"] { assert!(valid_request(valid).is_ok()); }
+        for invalid in [b"<Other/>".as_slice(), b"<StoreAccountContextRequest user='x'/>", b"<StoreAccountContextRequest><XUser/></StoreAccountContextRequest>", b"<StoreAccountContextRequest/>\0\0", b"<!DOCTYPE x><StoreAccountContextRequest/>", b"<StoreAccountContextRequest/><StoreAccountContextRequest/>"] { assert!(valid_request(invalid).is_err()); }
+    }
+    #[test]
+    fn account_is_real_snapshot_without_xuser_or_metadata() {
+        let tokens = TokenManager::with_memory();
+        seed(&tokens, "SYNTHETIC-CIPHER-A", "2040-01-01T00:00:00Z");
+        let mut state = BrokerStoreAccount::default();
+        let first = state.response_at(&tokens, 1).unwrap();
+        assert!(String::from_utf8_lossy(&first).contains("<Status>Available</Status>"));
+        assert_eq!(first, state.response_at(&tokens, 1).unwrap());
+        assert!(!String::from_utf8_lossy(&first).contains("SYNTHETIC"));
+        seed(&tokens, "SYNTHETIC-CIPHER-B", "2040-01-01T00:00:00Z");
+        assert_ne!(first, state.response_at(&tokens, 1).unwrap());
+    }
+    #[test]
+    fn missing_expired_malformed_and_wrong_token_type_fail_closed() {
+        let tokens = TokenManager::with_memory();
+        let mut state = BrokerStoreAccount::default();
+        assert_eq!(state.response_at(&tokens, 1).unwrap(), b"<StoreAccountContextResponse><Status>Unavailable</Status></StoreAccountContextResponse>");
+        seed(&tokens, "SYNTHETIC", "2000-01-01T00:00:00Z");
+        assert_eq!(state.response_at(&tokens, 2_000_000_000).unwrap(), b"<StoreAccountContextResponse><Status>Expired</Status></StoreAccountContextResponse>");
+        seed(&tokens, "SYNTHETIC", "invalid");
+        assert!(String::from_utf8_lossy(&state.response_at(&tokens, 1).unwrap()).contains("Unavailable"));
+        tokens.save_user_token(PASSPORT_STS.into(), Token::Compact("SYNTHETIC".into())).unwrap();
+        assert!(String::from_utf8_lossy(&state.response_at(&tokens, 1).unwrap()).contains("Unavailable"));
+    }
+    #[test]
+    fn same_broker_refresh_preserves_context_but_account_switch_does_not() {
+        let tokens=TokenManager::with_memory();let mut state=BrokerStoreAccount::default();
+        tokens.save_user(&xodus::models::secrets::User{puid:"SYNTHETIC_ACCOUNT_A".into(),username:"SYNTHETIC_NAME".into()}).unwrap();
+        seed(&tokens,"SYNTHETIC_A","2040-01-01T00:00:00Z");let first=state.response_at(&tokens,1).unwrap();let context=state.selected.as_ref().unwrap().1.clone();
+        seed(&tokens,"SYNTHETIC_REFRESH","2041-01-01T00:00:00Z");assert!(state.validate_context(&context,&tokens));assert_eq!(first,state.response_at(&tokens,1).unwrap());
+        tokens.save_user(&xodus::models::secrets::User{puid:"SYNTHETIC_ACCOUNT_B".into(),username:"SYNTHETIC_NAME".into()}).unwrap();assert!(!state.validate_context(&context,&tokens));assert_ne!(first,state.response_at(&tokens,1).unwrap());
+    }
+}
diff --git a/crates/xodus-service/src/store_collections/auth.rs b/crates/xodus-service/src/store_collections/auth.rs
new file mode 100644
index 0000000..056ef65
--- /dev/null
+++ b/crates/xodus-service/src/store_collections/auth.rs
@@ -0,0 +1,294 @@
+//! Store-account-only RPS -> Device/Title/User XSTS, using one in-memory PoP key.
+//! No Game-XUser fallback, no invented device identity and no credential writes.
+use super::model::Request;
+use crate::store_license::Status;
+use serde_json::{Value, json};
+use std::time::{Duration, Instant};
+use xal::{
+    RequestSigner, SignaturePolicyCache, SigningAlgorithm, extensions::SigningReqwestBuilder,
+};
+use xodus::{
+    models::{live::ExchangeUserTokenOutcome, secrets::Token, soap},
+    tokens::TokenManager,
+};
+
+pub const URL: &str = "https://collections.mp.microsoft.com/v8.0/collections/b2bLicensePreview";
+pub struct Session {
+    client: reqwest11::Client,
+    signer: RequestSigner,
+    authorization: String,
+    pub expires_at: i64,
+    created: Instant,
+    key: (String, u32, String),
+}
+fn diag(stage: &str, http: u16) {
+    if std::env::var_os("XODUS_COLLECTIONS_DIAGNOSTICS").is_some() {
+        eprintln!("[collections-broker] stage={stage} http={http}");
+    }
+}
+fn failure(stage: &str) -> Status {
+    diag(stage, 0);
+    Status::Error
+}
+async fn bounded(mut response: reqwest11::Response, stage: &str) -> Result<Value, Status> {
+    diag(stage, response.status().as_u16());
+    let status = response.status();
+    let mut bytes = Vec::new();
+    while let Some(chunk) = response.chunk().await.map_err(|_| Status::Error)? {
+        if bytes.len() + chunk.len() > 1024 * 1024 {
+            return Err(Status::Unsupported);
+        }
+        bytes.extend_from_slice(&chunk);
+    }
+    if !status.is_success() {
+        if stage == "collections" && std::env::var_os("XODUS_COLLECTIONS_DIAGNOSTICS").is_some() {
+            // Whitelisted boolean categories only, never the server's message/code.
+            let text = String::from_utf8_lossy(&bytes).to_ascii_lowercase();
+            for category in [
+                "signature",
+                "token",
+                "sku",
+                "satisf",
+                "product",
+                "auth",
+                "json",
+                "contract",
+                "duplicate",
+                "invalid",
+            ] {
+                eprintln!(
+                    "[collections-broker] error_category={category} present={}",
+                    u8::from(text.contains(category))
+                );
+            }
+        }
+        return Err(match status.as_u16() {
+            401 | 403 => Status::Unavailable,
+            408 | 429 | 504 => Status::Timeout,
+            _ => Status::Error,
+        });
+    }
+    serde_json::from_slice(&bytes).map_err(|_| Status::Unsupported)
+}
+async fn signed(
+    client: &reqwest11::Client,
+    signer: &mut RequestSigner,
+    url: &str,
+    body: &Value,
+    authorization: Option<&str>,
+) -> Result<Value, Status> {
+    let stage = match url {
+        "https://device.auth.xboxlive.com/device/authenticate" => "device",
+        "https://title.auth.xboxlive.com/title/authenticate" => "title",
+        "https://user.auth.xboxlive.com/user/authenticate" => "user",
+        "https://xsts.auth.xboxlive.com/xsts/authorize" => "xsts",
+        URL => "collections",
+        _ => "unknown",
+    };
+    let policy = signer
+        .signature_policy_cache
+        .find_policy_for_url(url)
+        .await
+        .map_err(|_| Status::Unsupported)?
+        .ok_or(Status::Unsupported)?;
+    if policy.version != 1
+        || !policy
+            .supported_algorithms
+            .contains(&SigningAlgorithm::ES256)
+    {
+        return Err(Status::Unsupported);
+    }
+    let body = serde_json::to_vec(body).map_err(|_| Status::Error)?;
+    // Keep whole request bodies covered. Current exact-SKU batches are <8 KiB.
+    if body.len() > policy.max_body_bytes {
+        return Err(Status::Unsupported);
+    }
+    let mut request = client
+        .post(url)
+        .header("Content-Type", "application/json")
+        .header("Accept", "application/json")
+        .body(body);
+    // Xbox auth's contract header does not apply to the Commerce v8 API.
+    if url != URL {
+        request = request.header("x-xbl-contract-version", "1");
+    }
+    if let Some(value) = authorization {
+        request = request.header("Authorization", value);
+    }
+    let response = request
+        .sign(signer, None)
+        .await
+        .map_err(|_| failure("sign"))?
+        .send()
+        .await
+        .map_err(|_| failure("http"))?;
+    bounded(response, stage).await
+}
+fn token(value: &Value) -> Result<(String, i64), Status> {
+    let token = value
+        .get("Token")
+        .and_then(Value::as_str)
+        .filter(|s| !s.is_empty() && s.len() < 65536)
+        .ok_or(Status::Unsupported)?;
+    let expiry = value
+        .get("NotAfter")
+        .and_then(Value::as_str)
+        .and_then(|s| chrono::DateTime::parse_from_rfc3339(s).ok())
+        .map(|d| d.timestamp())
+        .ok_or(Status::Unsupported)?;
+    if expiry <= chrono::Utc::now().timestamp() {
+        return Err(Status::Expired);
+    }
+    Ok((token.into(), expiry))
+}
+fn compact(response: soap::RequestSecurityTokenResponse) -> Result<(String, i64), Status> {
+    let expiry = chrono::DateTime::parse_from_rfc3339(&response.lifetime.expires)
+        .map_err(|_| Status::Unsupported)?
+        .timestamp();
+    if expiry <= chrono::Utc::now().timestamp() {
+        return Err(Status::Expired);
+    }
+    let Token::Compact(token) = Token::from(response) else {
+        return Err(Status::Unsupported);
+    };
+    if token.is_empty() || token.len() > 65536 {
+        return Err(Status::Unsupported);
+    }
+    Ok((token, expiry))
+}
+impl Session {
+    pub fn matches(&self, request: &Request) -> bool {
+        self.key
+            == (
+                request.context.clone(),
+                request.title_id,
+                request.msa_app_id.clone(),
+            )
+            && self.created.elapsed() < Duration::from_secs(30)
+            && self.expires_at > chrono::Utc::now().timestamp() + 5
+    }
+    pub async fn create(request: &Request, tokens: &TokenManager) -> Result<Self, Status> {
+        let Token::Legacy(device) = tokens
+            .get_device_sts_token()
+            .map_err(|_| Status::Unavailable)?
+        else {
+            return Err(Status::Unavailable);
+        };
+        let Token::Legacy(user) = tokens
+            .get_user_sts_token()
+            .map_err(|_| Status::Unavailable)?
+        else {
+            return Err(Status::Unavailable);
+        };
+        let client13 = reqwest::Client::builder()
+            .timeout(Duration::from_secs(15))
+            .redirect(reqwest::redirect::Policy::none())
+            .build()
+            .map_err(|_| Status::Error)?;
+        let device_response = xodus::api::live::exchange_device_token(
+            &client13,
+            device.clone(),
+            "{28C08266-F973-4AE6-FFE4-409B249F138F}".into(),
+            "scope=service::user.auth.xboxlive.com::MBI_SSL&api-version=2.0".into(),
+            Some(soap::PolicyReference::token_broker()),
+        )
+        .await
+        .map_err(|_| failure("device_rps"))?;
+        let (device_rps, de) = compact(device_response)?;
+        let app = &request.msa_app_id;
+        let user_response=xodus::api::live::exchange_user_token(&client13,user,"USERNAME".into(),device,None,Some("Silent".into()),app.clone(),&[(format!("scope=service::user.auth.xboxlive.com::MBI_SSL&api-version=2.0&clientid={app}"),Some(soap::PolicyReference::token_broker())),("http://Passport.NET/tb".into(),None)]).await.map_err(|_|failure("user_rps"))?;
+        let response = match user_response {
+            ExchangeUserTokenOutcome::Issued(
+                soap::BodyContent::RequestSecurityTokenResponseCollection(mut c),
+            ) if !c.security_tokens.is_empty() => c.security_tokens.remove(0),
+            ExchangeUserTokenOutcome::Issued(soap::BodyContent::RequestSecurityTokenResponse(
+                r,
+            )) => *r,
+            _ => return Err(Status::Unsupported),
+        };
+        let (user_rps, ue) = compact(response)?;
+        let client = reqwest11::Client::builder()
+            .timeout(Duration::from_secs(15))
+            .redirect(reqwest11::redirect::Policy::none())
+            .user_agent("xodus-store-collections/0.1")
+            .build()
+            .map_err(|_| Status::Error)?;
+        let policies = bounded(
+            client
+                .get("https://title.mgt.xboxlive.com/titles/default/endpoints?type=1")
+                .header("x-xbl-contract-version", "1")
+                .send()
+                .await
+                .map_err(|_| failure("policy_http"))?,
+            "policy",
+        )
+        .await?;
+        // XAL v0.1.3 does not canonicalize additional signed headers. Do not silently
+        // accept a future policy requiring them or a non-XBL signature.
+        for p in policies
+            .get("SignaturePolicies")
+            .and_then(Value::as_array)
+            .ok_or(Status::Unsupported)?
+        {
+            if p.get("ExtraHeaders")
+                .is_some_and(|v| !v.as_array().is_some_and(|a| a.is_empty()) && !v.is_null())
+            {
+                return Err(Status::Unsupported);
+            }
+        }
+        let mut signer = RequestSigner::default();
+        signer.signature_policy_cache = SignaturePolicyCache::new(
+            serde_json::from_value(policies).map_err(|_| Status::Unsupported)?,
+        );
+        let proof = signer.get_proof_key();
+        let d=signed(&client,&mut signer,"https://device.auth.xboxlive.com/device/authenticate",&json!({"RelyingParty":"http://auth.xboxlive.com","TokenType":"JWT","Properties":{"AuthMethod":"RPS","RpsTicket":device_rps,"SiteName":"user.auth.xboxlive.com","Version":"10.0.22621","ProofKey":proof}}),None).await?;
+        let (device_token, de2) = token(&d)?;
+        let title=signed(&client,&mut signer,"https://title.auth.xboxlive.com/title/authenticate",&json!({"RelyingParty":"http://auth.xboxlive.com","TokenType":"JWT","Properties":{"DeviceToken":device_token,"ProofKey":proof,"TitleId":request.title_id}}),None).await?;
+        let tid = title["DisplayClaims"]["xti"]["tid"].as_u64().or_else(|| {
+            title["DisplayClaims"]["xti"]["tid"]
+                .as_str()
+                .and_then(|s| s.parse().ok())
+        });
+        if tid != Some(request.title_id as u64) {
+            return Err(Status::Unavailable);
+        }
+        let (title_token, te) = token(&title)?;
+        let u=signed(&client,&mut signer,"https://user.auth.xboxlive.com/user/authenticate",&json!({"RelyingParty":"http://auth.xboxlive.com","TokenType":"JWT","Properties":{"AuthMethod":"RPS","RpsTicket":user_rps,"SiteName":"user.auth.xboxlive.com"}}),None).await?;
+        let (user_token, ue2) = token(&u)?;
+        let x=signed(&client,&mut signer,"https://xsts.auth.xboxlive.com/xsts/authorize",&json!({"RelyingParty":"http://licensing.xboxlive.com","TokenType":"JWT","Properties":{"SandboxId":"RETAIL","DeviceToken":device_token,"TitleToken":title_token,"UserTokens":[user_token]}}),None).await?;
+        let (token, xe) = token(&x)?;
+        let users = x["DisplayClaims"]["xui"]
+            .as_array()
+            .filter(|v| v.len() == 1)
+            .ok_or(Status::Unsupported)?;
+        let hash = users[0]["uhs"]
+            .as_str()
+            .filter(|s| !s.is_empty() && s.len() <= 64 && s.bytes().all(|b| b.is_ascii_digit()))
+            .ok_or(Status::Unsupported)?;
+        Ok(Self {
+            client,
+            signer,
+            authorization: format!("XBL3.0 x={hash};{token}"),
+            expires_at: [de, ue, de2, te, ue2, xe].into_iter().min().unwrap(),
+            created: Instant::now(),
+            key: (
+                request.context.clone(),
+                request.title_id,
+                request.msa_app_id.clone(),
+            ),
+        })
+    }
+    pub async fn page(&mut self, body: &Value) -> Result<Value, Status> {
+        if self.expires_at <= chrono::Utc::now().timestamp() {
+            return Err(Status::Expired);
+        }
+        signed(
+            &self.client,
+            &mut self.signer,
+            URL,
+            body,
+            Some(&self.authorization),
+        )
+        .await
+    }
+}
diff --git a/crates/xodus-service/src/store_collections/model.rs b/crates/xodus-service/src/store_collections/model.rs
new file mode 100644
index 0000000..eb2fb48
--- /dev/null
+++ b/crates/xodus-service/src/store_collections/model.rs
@@ -0,0 +1,628 @@
+//! Narrow consumer-collection evidence. Never infer shared ownership or balances.
+use crate::store_license::Status;
+use serde_json::Value;
+use std::collections::{BTreeMap, BTreeSet};
+
+#[derive(Clone, PartialEq, Eq)]
+pub struct Wanted {
+    pub store_id: String,
+    pub kind: u32,
+}
+#[derive(Clone)]
+pub struct Request {
+    pub context: String,
+    pub store_id: String,
+    pub title_id: u32,
+    pub msa_app_id: String,
+    pub products: Vec<Wanted>,
+}
+#[derive(Clone, PartialEq, Eq)]
+pub struct Item {
+    pub store_id: String,
+    pub kind: u32,
+    pub acquired_date: i64,
+    pub start_date: i64,
+    pub end_date: i64,
+    pub quantity: u32,
+    pub is_trial: bool,
+    pub trial_time_remaining_in_seconds: u32,
+    pub campaign_id: Option<String>,
+    pub developer_offer_id: Option<String>,
+}
+pub struct Record {
+    pub item: Item,
+    pub active: bool,
+}
+pub struct Page {
+    pub records: Vec<Record>,
+    pub continuation: Option<String>,
+}
+pub struct Snapshot {
+    pub items: Vec<Item>,
+    pub absent: Vec<String>,
+    pub unknown: Vec<String>,
+    pub observed_at: i64,
+    pub expires_at: i64,
+}
+
+pub fn parent_expiry(records: &[Record], parent: &str, now: i64) -> Result<i64, Status> {
+    records
+        .iter()
+        .filter(|r| {
+            r.active
+                && r.item.kind == 4
+                && r.item.store_id[..12] == *parent
+                && r.item.acquired_date <= now
+                && r.item.start_date <= now
+                && r.item.end_date > now
+        })
+        .map(|r| r.item.end_date)
+        .max()
+        .ok_or(Status::Unsupported)
+}
+
+/// Each HTTP batch must independently reach a terminal page and carry the
+/// positive parent control. An empty later batch cannot borrow earlier proof.
+#[derive(Default)]
+pub struct BatchPages {
+    records: Vec<Record>,
+    seen: BTreeSet<String>,
+    pages: usize,
+    complete: bool,
+}
+impl BatchPages {
+    pub fn push(&mut self, page: Page) -> Result<Option<String>, Status> {
+        if self.complete || self.pages >= 20 || self.records.len() + page.records.len() > 1000 {
+            return Err(Status::Unsupported);
+        }
+        self.pages += 1;
+        if let Some(cursor) = &page.continuation {
+            if !self.seen.insert(cursor.clone()) || self.pages == 20 {
+                return Err(Status::Unsupported);
+            }
+        }
+        self.complete = page.continuation.is_none();
+        self.records.extend(page.records);
+        Ok(page.continuation)
+    }
+    pub fn finish(self, parent: &str, now: i64) -> Result<(Vec<Record>, i64), Status> {
+        if !self.complete {
+            return Err(Status::Unsupported);
+        }
+        let expiry = parent_expiry(&self.records, parent, now)?;
+        Ok((self.records, expiry))
+    }
+}
+
+pub fn valid_id(v: &str, n: usize) -> bool {
+    v.len() == n
+        && v.bytes()
+            .all(|b| b.is_ascii_uppercase() || b.is_ascii_digit())
+}
+pub fn valid_sku(v: &str) -> bool {
+    v.len() == 17 && v.as_bytes()[12] == b'/' && valid_id(&v[..12], 12) && valid_id(&v[13..], 4)
+}
+pub fn valid_guid(s: &str) -> bool {
+    s.len() == 36
+        && s.bytes().enumerate().all(|(i, b)| {
+            if [8, 13, 18, 23].contains(&i) {
+                b == b'-'
+            } else {
+                b.is_ascii_hexdigit()
+            }
+        })
+}
+// MicrosoftGame.config supports both legacy 16-digit hexadecimal MSA IDs
+// and newer GUIDs. Preserve the title's exact ID for the token exchange.
+pub fn valid_app_id(s: &str) -> bool {
+    valid_guid(s) || (s.len() == 16 && s.bytes().all(|b| b.is_ascii_hexdigit()))
+}
+pub fn validate(request: &Request) -> Result<(), Status> {
+    if request.context.len() != 64
+        || !request
+            .context
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        || !valid_id(&request.store_id, 12)
+        || request.title_id == 0
+        || !valid_app_id(&request.msa_app_id)
+        || request.products.is_empty()
+        || request.products.len() > 100
+    {
+        return Err(Status::InvalidRequest);
+    }
+    let mut seen = BTreeSet::new();
+    for p in &request.products {
+        if !valid_sku(&p.store_id)
+            || ![1, 2, 4, 8, 16].contains(&p.kind)
+            || !seen.insert(&p.store_id)
+        {
+            return Err(Status::InvalidRequest);
+        }
+    }
+    Ok(())
+}
+fn text<'a>(v: &'a Value, key: &str) -> Result<&'a str, Status> {
+    v.get(key)
+        .and_then(Value::as_str)
+        .ok_or(Status::Unsupported)
+}
+fn date(v: &Value, key: &str) -> Result<i64, Status> {
+    chrono::DateTime::parse_from_rfc3339(text(v, key)?)
+        .map(|d| d.timestamp())
+        .map_err(|_| Status::Unsupported)
+}
+fn optional(v: &Value, key: &str) -> Result<Option<String>, Status> {
+    match v.get(key) {
+        None | Some(Value::Null) => Ok(None),
+        Some(Value::String(s)) if s.len() <= 512 && s.chars().all(|c| !c.is_control()) => {
+            Ok(Some(s.clone()))
+        }
+        _ => Err(Status::Unsupported),
+    }
+}
+fn duration(s: &str) -> Result<u32, Status> {
+    let parts = s.split(':').collect::<Vec<_>>();
+    if !(3..=4).contains(&parts.len()) {
+        return Err(Status::Unsupported);
+    }
+    let number = |s: &str| -> Result<u64, Status> {
+        if s.is_empty() || !s.bytes().all(|b| b.is_ascii_digit()) {
+            return Err(Status::Unsupported);
+        }
+        s.parse().map_err(|_| Status::Unsupported)
+    };
+    let (days, hours) = if parts.len() == 4 {
+        (number(parts[0])?, number(parts[1])?)
+    } else if let Some((d, h)) = parts[0].split_once('.') {
+        (number(d)?, number(h)?)
+    } else {
+        (0, number(parts[0])?)
+    };
+    let minutes = number(parts[parts.len() - 2])?;
+    let last = parts[parts.len() - 1];
+    let seconds = if let Some((s, f)) = last.split_once('.') {
+        if f.is_empty() || f.len() > 9 || !f.bytes().all(|b| b.is_ascii_digit()) {
+            return Err(Status::Unsupported);
+        }
+        number(s)?
+    } else {
+        number(last)?
+    };
+    if hours > 23 || minutes > 59 || seconds > 59 {
+        return Err(Status::Unsupported);
+    }
+    days.checked_mul(86400)
+        .and_then(|d| d.checked_add(hours * 3600 + minutes * 60 + seconds))
+        .and_then(|s| u32::try_from(s).ok())
+        .ok_or(Status::Unsupported)
+}
+pub fn parse_page(value: &Value) -> Result<Page, Status> {
+    let rows = value
+        .get("items")
+        .and_then(Value::as_array)
+        .ok_or(Status::Unsupported)?;
+    if rows.len() > 100 {
+        return Err(Status::Unsupported);
+    }
+    let continuation = match value.get("continuationToken") {
+        None | Some(Value::Null) => None,
+        Some(Value::String(s)) if s.is_empty() => None,
+        Some(Value::String(s)) if s.len() <= 8192 => Some(s.clone()),
+        _ => return Err(Status::Unsupported),
+    };
+    let mut records = Vec::new();
+    for row in rows {
+        let product = text(row, "productId")?;
+        let sku = text(row, "skuId")?;
+        if !valid_id(product, 12) || !valid_id(sku, 4) {
+            return Err(Status::Unsupported);
+        }
+        let kind_name = text(row, "productKind")?;
+        if let Some(alias) = row.get("productType") {
+            if alias.as_str() != Some(kind_name) {
+                return Err(Status::Unsupported);
+            }
+        }
+        let kind = match kind_name {
+            "Consumable" => 1,
+            "Durable" => 2,
+            "Game" => 4,
+            "Pass" => 8,
+            "UnmanagedConsumable" => 16,
+            _ => return Err(Status::Unsupported),
+        };
+        let status = text(row, "status")?;
+        if !["Active", "Expired", "Revoked", "Banned", "Suspended"].contains(&status) {
+            return Err(Status::Unsupported);
+        }
+        if text(row, "sharingSource")? != "None" {
+            return Err(Status::Unsupported);
+        }
+        let satisfying = row
+            .get("satisfiedByProductIds")
+            .and_then(Value::as_array)
+            .ok_or(Status::Unsupported)?;
+        if satisfying.len() > 1000
+            || satisfying
+                .iter()
+                .any(|v| !v.as_str().is_some_and(|s| valid_id(s, 12)))
+        {
+            return Err(Status::Unsupported);
+        }
+        let acquired_date = date(row, "acquiredDate")?;
+        let start_date = date(row, "startDate")?;
+        let end_date = date(row, "endDate")?;
+        if start_date >= end_date {
+            return Err(Status::Unsupported);
+        }
+        // Collections v8 documents quantity as optional and non-consumable
+        // quantity as exactly one. Expanded satisfying Game records omit it in
+        // genuine responses. Consumable balances always require the field.
+        let quantity = match row.get("quantity") {
+            None if matches!(kind, 2 | 4 | 8) => 1,
+            Some(value) => value
+                .as_u64()
+                .and_then(|v| u32::try_from(v).ok())
+                .ok_or(Status::Unsupported)?,
+            _ => return Err(Status::Unsupported),
+        };
+        if matches!(kind, 2 | 4 | 8) && quantity != 1 {
+            return Err(Status::Unsupported);
+        }
+        let trial = row
+            .get("trialData")
+            .and_then(Value::as_object)
+            .ok_or(Status::Unsupported)?;
+        let is_trial = trial
+            .get("isTrial")
+            .and_then(Value::as_bool)
+            .ok_or(Status::Unsupported)?;
+        let in_trial = trial
+            .get("isInTrialPeriod")
+            .and_then(Value::as_bool)
+            .ok_or(Status::Unsupported)?;
+        if in_trial && !is_trial {
+            return Err(Status::Unsupported);
+        }
+        let trial_time_remaining_in_seconds = match trial.get("trialTimeRemaining") {
+            Some(Value::String(s)) => duration(s)?,
+            None | Some(Value::Null) if !is_trial && !in_trial => 0,
+            _ => return Err(Status::Unsupported),
+        };
+        records.push(Record {
+            item: Item {
+                store_id: format!("{product}/{sku}"),
+                kind,
+                acquired_date,
+                start_date,
+                end_date,
+                quantity,
+                is_trial,
+                trial_time_remaining_in_seconds,
+                campaign_id: optional(row, "campaignId")?,
+                developer_offer_id: optional(row, "devOfferId")?,
+            },
+            active: status == "Active",
+        });
+    }
+    Ok(Page {
+        records,
+        continuation,
+    })
+}
+
+/// Only after every requested server page was acquired, and an active known
+/// parent proved this account/title response. Missing shareable SKUs stay unknown.
+pub fn finish(
+    request: &Request,
+    records: Vec<Record>,
+    now: i64,
+    expires: i64,
+) -> Result<Snapshot, Status> {
+    validate(request)?;
+    if expires <= now {
+        return Err(Status::Expired);
+    }
+    let parent_expires = parent_expiry(&records, &request.store_id, now)?;
+    let mut active = BTreeMap::<String, Item>::new();
+    for row in records {
+        if row.item.acquired_date > now {
+            return Err(Status::Unsupported);
+        }
+        if !row.active || row.item.start_date > now || row.item.end_date <= now {
+            continue;
+        }
+        if let Some(wanted) = request
+            .products
+            .iter()
+            .find(|p| p.store_id == row.item.store_id)
+        {
+            if wanted.kind != row.item.kind {
+                return Err(Status::Unsupported);
+            }
+            if let Some(previous) = active.get(&row.item.store_id) {
+                if previous != &row.item {
+                    return Err(Status::Unsupported);
+                }
+            } else {
+                active.insert(row.item.store_id.clone(), row.item);
+            }
+        }
+    }
+    let mut items = Vec::new();
+    let mut absent = Vec::new();
+    let mut unknown = Vec::new();
+    let mut expires_at = expires.min(parent_expires).min(now.saturating_add(30));
+    for wanted in &request.products {
+        if let Some(item) = active.remove(&wanted.store_id) {
+            expires_at = expires_at.min(item.end_date);
+            items.push(item);
+        } else if matches!(wanted.kind, 1 | 16) {
+            absent.push(wanted.store_id.clone());
+        } else {
+            unknown.push(wanted.store_id.clone());
+        }
+    }
+    Ok(Snapshot {
+        items,
+        absent,
+        unknown,
+        observed_at: now,
+        expires_at,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    #[test]
+    fn both_microsoft_application_id_formats_are_supported() {
+        assert!(valid_app_id("000000001234ABCD"));
+        assert!(valid_app_id("00000000-1111-2222-3333-444444444444"));
+        for bad in ["", "000000001234ABCD&", "000000001234ABCG", "123", "{00000000-1111-2222-3333-444444444444}"] {
+            assert!(!valid_app_id(bad));
+        }
+        let mut r=request();r.msa_app_id="000000001234ABCD".into();assert!(validate(&r).is_ok());
+    }
+    fn request() -> Request {
+        Request {
+            context: "a".repeat(64),
+            store_id: "ABCD1234EFGH".into(),
+            title_id: 123,
+            msa_app_id: "00000000-1111-2222-3333-444444444444".into(),
+            products: vec![
+                Wanted {
+                    store_id: "COIN1234EFGH/0001".into(),
+                    kind: 16,
+                },
+                Wanted {
+                    store_id: "GAME1234EFGH/0001".into(),
+                    kind: 4,
+                },
+            ],
+        }
+    }
+    fn row() -> Value {
+        json!({"productId":"ABCD1234EFGH","skuId":"0001","productKind":"Game","status":"Active","acquiredDate":"2020-01-01T00:00:00.1234567Z","startDate":"2020-01-01T00:00:00Z","endDate":"9999-12-31T23:59:59.9999999+00:00","quantity":1,"trialData":{"isTrial":false,"isInTrialPeriod":false},"sharingSource":"None","satisfiedByProductIds":[]})
+    }
+    #[test]
+    fn actual_shape_and_far_future_dates() {
+        let page = parse_page(&json!({"items":[row()]})).unwrap();
+        assert_eq!(page.records[0].item.end_date, 253402300799);
+        assert_eq!(page.records[0].item.trial_time_remaining_in_seconds, 0);
+        assert!(page.records[0].item.campaign_id.is_none());
+    }
+    #[test]
+    fn expanded_nonconsumable_quantity_is_documented_one_only() {
+        for kind in ["Game", "Durable", "Pass"] {
+            let mut record = row();
+            record["productKind"] = json!(kind);
+            record.as_object_mut().unwrap().remove("quantity");
+            assert_eq!(
+                parse_page(&json!({"items":[record.clone()]}))
+                    .unwrap()
+                    .records[0]
+                    .item
+                    .quantity,
+                1
+            );
+            record["quantity"] = json!(0);
+            assert!(parse_page(&json!({"items":[record]})).is_err());
+        }
+        for kind in ["Consumable", "UnmanagedConsumable"] {
+            let mut record = row();
+            record["productKind"] = json!(kind);
+            record.as_object_mut().unwrap().remove("quantity");
+            assert!(parse_page(&json!({"items":[record.clone()]})).is_err());
+            record["quantity"] = json!(0);
+            assert_eq!(
+                parse_page(&json!({"items":[record]})).unwrap().records[0]
+                    .item
+                    .quantity,
+                0
+            );
+        }
+    }
+    #[test]
+    fn narrow_negative_scope_and_parent_control() {
+        let rows = parse_page(&json!({"items":[row()]})).unwrap().records;
+        let s = finish(&request(), rows, 1800000000, 1900000000).unwrap();
+        assert_eq!(s.absent, ["COIN1234EFGH/0001"]);
+        assert_eq!(s.unknown, ["GAME1234EFGH/0001"]);
+        assert!(matches!(
+            finish(&request(), vec![], 1800000000, 1900000000),
+            Err(Status::Unsupported)
+        ));
+    }
+    #[test]
+    fn positive_exact_sku_and_active_time() {
+        let mut coin = row();
+        coin["productId"] = json!("COIN1234EFGH");
+        coin["productKind"] = json!("UnmanagedConsumable");
+        let s = finish(
+            &request(),
+            parse_page(&json!({"items":[row(),coin.clone()]}))
+                .unwrap()
+                .records,
+            1800000000,
+            1900000000,
+        )
+        .unwrap();
+        assert_eq!(s.items.len(), 1);
+        assert!(s.absent.is_empty());
+        coin["status"] = json!("Expired");
+        let s = finish(
+            &request(),
+            parse_page(&json!({"items":[row(),coin]})).unwrap().records,
+            1800000000,
+            1900000000,
+        )
+        .unwrap();
+        assert_eq!(s.absent.len(), 1);
+    }
+    #[test]
+    fn contradictory_active_duplicates_fail() {
+        let mut coin = row();
+        coin["productId"] = json!("COIN1234EFGH");
+        coin["productKind"] = json!("UnmanagedConsumable");
+        let mut changed = coin.clone();
+        changed["quantity"] = json!(2);
+        assert!(matches!(
+            finish(
+                &request(),
+                parse_page(&json!({"items":[row(),coin,changed]}))
+                    .unwrap()
+                    .records,
+                1800000000,
+                1900000000
+            ),
+            Err(Status::Unsupported)
+        ));
+    }
+    #[test]
+    fn malformed_and_unproven_fields_fail() {
+        for (field, value) in [
+            ("quantity", json!(-1)),
+            ("quantity", json!(4294967296u64)),
+            ("quantity", json!(1.5)),
+            ("startDate", json!("invalid")),
+            ("status", json!("Unknown")),
+            ("sharingSource", json!("Shared")),
+            ("productType", json!("Durable")),
+            ("skuId", json!("abc")),
+            ("trialData", json!({"isTrial":true,"isInTrialPeriod":true})),
+            ("satisfiedByProductIds", json!(["../bad"])),
+        ] {
+            let mut r = row();
+            r[field] = value;
+            assert!(parse_page(&json!({"items":[r]})).is_err(), "{field}");
+        }
+    }
+    #[test]
+    fn trial_duration_checked() {
+        for (s, n) in [
+            ("09:43:52.8580690", 35032),
+            ("1.09:43:52", 121432),
+            ("01:09:43:52.000", 121432),
+            ("00:00:00", 0),
+        ] {
+            assert_eq!(duration(s).unwrap(), n);
+        }
+        for s in [
+            "24:00:00",
+            "00:60:00",
+            "00:00:60",
+            "-1:00:00",
+            "99999999999999:00:00:00",
+            "00:00:00.bad",
+        ] {
+            assert!(duration(s).is_err());
+        }
+    }
+    #[test]
+    fn page_contract_never_infers_missing_items_empty() {
+        assert!(parse_page(&json!({})).is_err());
+        assert!(parse_page(&json!({"items":[],"continuationToken":13})).is_err());
+        assert!(
+            parse_page(&json!({"items":[],"continuationToken":"opaque"}))
+                .unwrap()
+                .continuation
+                .is_some()
+        );
+    }
+    #[test]
+    fn empty_intermediate_page_requires_terminal_parent() {
+        let mut b = BatchPages::default();
+        assert_eq!(
+            b.push(parse_page(&json!({"items":[],"continuationToken":"opaque"})).unwrap())
+                .unwrap(),
+            Some("opaque".into())
+        );
+        assert!(
+            b.push(parse_page(&json!({"items":[row()]})).unwrap())
+                .unwrap()
+                .is_none()
+        );
+        assert_eq!(b.finish("ABCD1234EFGH", 1800000000).unwrap().0.len(), 1);
+        let mut empty = BatchPages::default();
+        empty
+            .push(parse_page(&json!({"items":[]})).unwrap())
+            .unwrap();
+        assert!(empty.finish("ABCD1234EFGH", 1800000000).is_err());
+    }
+    #[test]
+    fn repeated_or_unfinished_paging_never_publishes() {
+        let mut b = BatchPages::default();
+        b.push(parse_page(&json!({"items":[row()],"continuationToken":"same"})).unwrap())
+            .unwrap();
+        assert!(b.finish("ABCD1234EFGH", 1800000000).is_err());
+        let mut b = BatchPages::default();
+        b.push(parse_page(&json!({"items":[row()],"continuationToken":"same"})).unwrap())
+            .unwrap();
+        assert!(
+            b.push(parse_page(&json!({"items":[],"continuationToken":"same"})).unwrap())
+                .is_err()
+        );
+        let mut b = BatchPages::default();
+        for i in 0..19 {
+            b.push(parse_page(&json!({"items":[],"continuationToken":i.to_string()})).unwrap())
+                .unwrap();
+        }
+        assert!(
+            b.push(parse_page(&json!({"items":[row()],"continuationToken":"last"})).unwrap())
+                .is_err()
+        );
+    }
+    #[test]
+    fn independent_batches_cannot_borrow_parent() {
+        let mut good = BatchPages::default();
+        good.push(parse_page(&json!({"items":[row()]})).unwrap())
+            .unwrap();
+        assert!(good.finish("ABCD1234EFGH", 1800000000).is_ok());
+        let mut other = BatchPages::default();
+        other
+            .push(parse_page(&json!({"items":[]})).unwrap())
+            .unwrap();
+        assert!(other.finish("ABCD1234EFGH", 1800000000).is_err());
+    }
+    #[test]
+    fn parent_expiry_bounds_all_negative_evidence() {
+        let mut rows = parse_page(&json!({"items":[row()]})).unwrap().records;
+        rows[0].item.end_date = 1800000003;
+        let s = finish(&request(), rows, 1800000000, 1900000000).unwrap();
+        assert_eq!(s.expires_at, 1800000003);
+    }
+    #[test]
+    fn contradictory_trial_and_future_acquisition_fail() {
+        let mut r = row();
+        r["trialData"] =
+            json!({"isTrial":false,"isInTrialPeriod":true,"trialTimeRemaining":"00:00:00"});
+        assert!(parse_page(&json!({"items":[r]})).is_err());
+        let mut rows = parse_page(&json!({"items":[row()]})).unwrap().records;
+        rows[0].item.acquired_date = 1800000001;
+        assert!(parent_expiry(&rows, "ABCD1234EFGH", 1800000000).is_err());
+        assert!(finish(&request(), rows, 1800000000, 1900000000).is_err());
+    }
+}
diff --git a/crates/xodus-service/src/store_collections.rs b/crates/xodus-service/src/store_collections.rs
new file mode 100644
index 0000000..95f95a8
--- /dev/null
+++ b/crates/xodus-service/src/store_collections.rs
@@ -0,0 +1,328 @@
+//! Account-bound, read-only exact-SKU consumer Collections evidence.
+//! Shared entitlements and whole-title inventory are intentionally not asserted.
+pub(crate) mod auth;
+pub(crate) mod model;
+use crate::store_license::Status;
+use model::{Request, Snapshot, Wanted};
+use quick_xml::{Reader, events::Event};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use std::{collections::BTreeSet, sync::Arc, time::Duration};
+use xodus::tokens::TokenManager;
+
+#[derive(Deserialize)]
+#[serde(
+    rename = "StoreCollectionsRequest",
+    rename_all = "PascalCase",
+    deny_unknown_fields
+)]
+struct WireRequest {
+    context: String,
+    store_id: String,
+    title_id: u32,
+    msa_app_id: String,
+    products: Products,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Products {
+    #[serde(rename = "Product", default)]
+    items: Vec<Product>,
+}
+#[derive(Deserialize)]
+#[serde(rename_all = "PascalCase", deny_unknown_fields)]
+struct Product {
+    store_id: String,
+    kind: u32,
+}
+
+pub fn parse_request(bytes: &[u8]) -> Result<Request, Status> {
+    let bytes = bytes.strip_suffix(&[0]).unwrap_or(bytes);
+    if bytes.is_empty() || bytes.len() > 16384 || bytes.contains(&0) {
+        return Err(Status::InvalidRequest);
+    }
+    let mut reader = Reader::from_reader(bytes);
+    let mut stack = Vec::<String>::new();
+    let mut root = false;
+    loop {
+        match reader.read_event().map_err(|_| Status::InvalidRequest)? {
+            Event::Start(e) => {
+                let name = e.name().as_ref().to_string();
+                let allowed = match stack.last().map(String::as_str) {
+                    None => !root && name == "StoreCollectionsRequest",
+                    Some("StoreCollectionsRequest") => {
+                        ["Context", "StoreId", "TitleId", "MsaAppId", "Products"]
+                            .contains(&name.as_str())
+                    }
+                    Some("Products") => name == "Product",
+                    Some("Product") => ["StoreId", "Kind"].contains(&name.as_str()),
+                    _ => false,
+                };
+                if !allowed || e.attributes().next().is_some() {
+                    return Err(Status::InvalidRequest);
+                }
+                if stack.is_empty() {
+                    root = true;
+                }
+                stack.push(name);
+            }
+            Event::End(_) => {
+                stack.pop().ok_or(Status::InvalidRequest)?;
+            }
+            Event::Text(t) => {
+                if !matches!(
+                    stack.last().map(String::as_str),
+                    Some("Context" | "StoreId" | "TitleId" | "MsaAppId" | "Kind")
+                ) && !t.as_ref().chars().all(|c| c.is_ascii_whitespace())
+                {
+                    return Err(Status::InvalidRequest);
+                }
+            }
+            Event::Eof => break,
+            _ => return Err(Status::InvalidRequest),
+        }
+    }
+    if !root || !stack.is_empty() {
+        return Err(Status::InvalidRequest);
+    }
+    let wire: WireRequest =
+        quick_xml::de::from_reader(bytes).map_err(|_| Status::InvalidRequest)?;
+    let request = Request {
+        context: wire.context,
+        store_id: wire.store_id,
+        title_id: wire.title_id,
+        msa_app_id: wire.msa_app_id,
+        products: wire
+            .products
+            .items
+            .into_iter()
+            .map(|p| Wanted {
+                store_id: p.store_id,
+                kind: p.kind,
+            })
+            .collect(),
+    };
+    model::validate(&request)?;
+    Ok(request)
+}
+
+#[derive(Default)]
+pub struct Broker {
+    session: Option<auth::Session>,
+}
+fn query_body(request: &Request, batch: &[Wanted]) -> Value {
+    // Product-wide filters cover every requested SKU. Mixing entries with and
+    // without the optional skuId was observed to fail with HTTP400; using only
+    // documented productId filters also keeps the parent control independent of
+    // the caller's selected SKU. Exact matching happens only after full paging.
+    let mut products = batch
+        .iter()
+        .map(|p| &p.store_id[..12])
+        .collect::<BTreeSet<_>>();
+    products.insert(&request.store_id);
+    let ids = products
+        .into_iter()
+        .map(|id| json!({"productId":id}))
+        .collect::<Vec<_>>();
+    json!({"market":"neutral","validityType":"All","maxPageSize":100,"excludeDuplicates":true,"expandSatisfyingItems":true,"entitlementFilters":["*:Game","*:Durable","*:Pass","*:Consumable","*:UnmanagedConsumable"],"productSkuIds":ids})
+}
+impl Broker {
+    pub fn clear(&mut self) {
+        self.session = None;
+    }
+    pub async fn query(
+        &mut self,
+        request: &Request,
+        tokens: Arc<TokenManager>,
+    ) -> Result<Snapshot, Status> {
+        // Cancellation drops all reqwest work; no detached query or token request.
+        match tokio::time::timeout(Duration::from_secs(35), self.query_inner(request, &tokens))
+            .await
+        {
+            Ok(result) => result,
+            Err(_) => {
+                self.clear();
+                Err(Status::Timeout)
+            }
+        }
+    }
+    async fn query_inner(
+        &mut self,
+        request: &Request,
+        tokens: &TokenManager,
+    ) -> Result<Snapshot, Status> {
+        model::validate(request)?;
+        if !self.session.as_ref().is_some_and(|s| s.matches(request)) {
+            self.session = None;
+            self.session = Some(auth::Session::create(request, tokens).await?);
+        }
+        let session = self.session.as_mut().ok_or(Status::Error)?;
+        let mut records = Vec::new();
+        let mut expires = session.expires_at;
+        // At most 99 requested product IDs plus the parent control per HTTP query.
+        // The extra control is not returned as a requested product to the caller.
+        for batch in request.products.chunks(99) {
+            let mut body = query_body(request, batch);
+            let mut batch_pages = model::BatchPages::default();
+            loop {
+                let page = model::parse_page(&session.page(&body).await?)?;
+                if let Some(cursor) = batch_pages.push(page)? {
+                    body["continuationToken"] = Value::String(cursor);
+                } else {
+                    break;
+                }
+            }
+            let (batch_records, parent_expiry) =
+                batch_pages.finish(&request.store_id, chrono::Utc::now().timestamp())?;
+            if records.len() + batch_records.len() > 1000 {
+                return Err(Status::Unsupported);
+            }
+            expires = expires.min(parent_expiry);
+            records.extend(batch_records);
+        }
+        model::finish(request, records, chrono::Utc::now().timestamp(), expires)
+    }
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "PascalCase")]
+struct WireItem<'a> {
+    store_id: &'a str,
+    kind: u32,
+    acquired_date: i64,
+    start_date: i64,
+    end_date: i64,
+    quantity: u32,
+    is_trial: bool,
+    trial_time_remaining_in_seconds: u32,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    campaign_id: Option<&'a str>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    developer_offer_id: Option<&'a str>,
+}
+pub fn encode(result: Result<Snapshot, Status>) -> Vec<u8> {
+    fn inner(s: Snapshot) -> Result<String, Status> {
+        let now = chrono::Utc::now().timestamp();
+        if s.observed_at > now || s.expires_at <= now {
+            return Err(Status::Expired);
+        }
+        let mut body = format!(
+            "<Status>Available</Status><ContextBound>true</ContextBound><Complete>true</Complete><DirectCoverage>true</DirectCoverage><SatisfyingCoverage>true</SatisfyingCoverage><SharedCoverage>false</SharedCoverage><ParentControlActive>true</ParentControlActive><ObservedAt>{}</ObservedAt><ExpiresAt>{}</ExpiresAt><Items>",
+            s.observed_at, s.expires_at
+        );
+        for i in &s.items {
+            let item = WireItem {
+                store_id: &i.store_id,
+                kind: i.kind,
+                acquired_date: i.acquired_date,
+                start_date: i.start_date,
+                end_date: i.end_date,
+                quantity: i.quantity,
+                is_trial: i.is_trial,
+                trial_time_remaining_in_seconds: i.trial_time_remaining_in_seconds,
+                campaign_id: i.campaign_id.as_deref(),
+                developer_offer_id: i.developer_offer_id.as_deref(),
+            };
+            let xml =
+                quick_xml::se::to_string_with_root("Item", &item).map_err(|_| Status::Error)?;
+            body.push_str(&xml);
+        }
+        body.push_str("</Items><AbsentIds>");
+        for id in s.absent {
+            body.push_str(&format!("<StoreId>{id}</StoreId>"));
+        }
+        body.push_str("</AbsentIds><UnknownIds>");
+        for id in s.unknown {
+            body.push_str(&format!("<StoreId>{id}</StoreId>"));
+        }
+        body.push_str("</UnknownIds>");
+        if body.len() + 64 > u16::MAX as usize {
+            return Err(Status::Unsupported);
+        }
+        Ok(body)
+    }
+    let body = match result.and_then(inner) {
+        Ok(body) => body,
+        Err(status) => format!("<Status>{status:?}</Status>"),
+    };
+    format!("<StoreCollectionsResponse>{body}</StoreCollectionsResponse>").into_bytes()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn xml() -> String {
+        format!(
+            "<StoreCollectionsRequest><Context>{}</Context><StoreId>ABCD1234EFGH</StoreId><TitleId>1</TitleId><MsaAppId>00000000-1111-2222-3333-444444444444</MsaAppId><Products><Product><StoreId>COIN1234EFGH/0001</StoreId><Kind>16</Kind></Product></Products></StoreCollectionsRequest>",
+            "a".repeat(64)
+        )
+    }
+    #[test]
+    fn strict_wire_and_duplicates() {
+        assert_eq!(parse_request(xml().as_bytes()).unwrap().products.len(), 1);
+        assert!(parse_request(format!("{}\0", xml()).as_bytes()).is_ok());
+        for bad in [
+            xml().replace("<Kind>16</Kind>", "<Kind>31</Kind>"),
+            xml().replace(
+                "<TitleId>1</TitleId>",
+                "<TitleId>1</TitleId><TitleId>2</TitleId>",
+            ),
+            xml().replace("<Products>", "<Products attr='1'>"),
+            xml().replace("<Kind>16</Kind>", "<Kind>16</Kind><X>1</X>"),
+            format!("<!DOCTYPE x>{}", xml()),
+            format!("{}\0\0", xml()),
+            xml().replace("COIN1234EFGH/0001", "COIN1234EFGH"),
+        ] {
+            assert!(parse_request(bad.as_bytes()).is_err());
+        }
+    }
+    #[test]
+    fn expired_and_error_responses_are_status_only() {
+        let now = chrono::Utc::now().timestamp();
+        let s = Snapshot {
+            items: vec![],
+            absent: vec![],
+            unknown: vec![],
+            observed_at: now,
+            expires_at: now,
+        };
+        assert_eq!(
+            encode(Ok(s)),
+            b"<StoreCollectionsResponse><Status>Expired</Status></StoreCollectionsResponse>"
+        );
+        assert_eq!(
+            encode(Err(Status::Unavailable)),
+            b"<StoreCollectionsResponse><Status>Unavailable</Status></StoreCollectionsResponse>"
+        );
+    }
+    #[test]
+    fn exact_query_has_satisfying_and_unique_parent_control() {
+        let request = parse_request(xml().as_bytes()).unwrap();
+        let body = query_body(&request, &request.products);
+        assert_eq!(body["expandSatisfyingItems"], true);
+        assert_eq!(body["productSkuIds"].as_array().unwrap().len(), 2);
+        assert!(
+            body["productSkuIds"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .all(|p| p.get("skuId").is_none())
+        );
+        let parent = Wanted {
+            store_id: format!("{}/0001", request.store_id),
+            kind: 4,
+        };
+        let body = query_body(
+            &request,
+            &[
+                parent.clone(),
+                Wanted {
+                    store_id: format!("{}/0002", request.store_id),
+                    kind: 4,
+                },
+            ],
+        );
+        assert_eq!(body["productSkuIds"].as_array().unwrap().len(), 1);
+        assert_eq!(body["productSkuIds"][0]["productId"], request.store_id);
+    }
+}
diff --git a/crates/xodus-service/src/store_inventory.rs b/crates/xodus-service/src/store_inventory.rs
new file mode 100644
index 0000000..9311f9e
--- /dev/null
+++ b/crates/xodus-service/src/store_inventory.rs
@@ -0,0 +1,493 @@
+//! Current Store account's direct and satisfying entitlements for this title.
+//! Exhaust the authenticated library before filtering; catalog visibility is
+//! never evidence of ownership. Device-shared entitlements are not covered.
+use crate::store_collections::{
+    auth,
+    model::{self, Item, Record, Snapshot},
+};
+use crate::store_license::{self, Status};
+use quick_xml::{Reader, events::Event};
+use serde::Deserialize;
+use serde_json::{Value, json};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    sync::Arc,
+    time::{Duration, Instant},
+};
+use xodus::tokens::TokenManager;
+
+#[derive(Clone, Deserialize, PartialEq, Eq)]
+#[serde(
+    rename = "StoreInventoryRequest",
+    rename_all = "PascalCase",
+    deny_unknown_fields
+)]
+pub struct Request {
+    pub context: String,
+    pub store_id: String,
+    pub title_id: u32,
+    pub msa_app_id: String,
+    pub market: String,
+    pub kinds: u32,
+    pub page_size: usize,
+    #[serde(default)]
+    pub continuation: String,
+}
+fn context_id(s: &str) -> bool {
+    s.len() == 64
+        && s.bytes()
+            .all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c))
+}
+pub fn parse_request(bytes: &[u8]) -> Result<Request, Status> {
+    let bytes = bytes.strip_suffix(&[0]).unwrap_or(bytes);
+    if bytes.is_empty() || bytes.len() > 2048 || bytes.contains(&0) {
+        return Err(Status::InvalidRequest);
+    }
+    let mut reader = Reader::from_reader(bytes);
+    let mut depth = 0;
+    let mut root = false;
+    loop {
+        match reader.read_event().map_err(|_| Status::InvalidRequest)? {
+            Event::Start(e) => {
+                if e.attributes().next().is_some() || depth > 1 {
+                    return Err(Status::InvalidRequest);
+                }
+                if depth == 0 {
+                    if root || e.name().as_ref() != "StoreInventoryRequest" {
+                        return Err(Status::InvalidRequest);
+                    }
+                    root = true;
+                } else if ![
+                    "Context",
+                    "StoreId",
+                    "TitleId",
+                    "MsaAppId",
+                    "Market",
+                    "Kinds",
+                    "PageSize",
+                    "Continuation",
+                ]
+                .contains(&e.name().as_ref())
+                {
+                    return Err(Status::InvalidRequest);
+                }
+                depth += 1;
+            }
+            Event::End(_) => {
+                if depth == 0 {
+                    return Err(Status::InvalidRequest);
+                }
+                depth -= 1;
+            }
+            Event::Text(t) if depth == 2 || t.as_ref().chars().all(|c| c.is_ascii_whitespace()) => {
+                ()
+            }
+            Event::Eof => break,
+            _ => return Err(Status::InvalidRequest),
+        }
+    }
+    if !root || depth != 0 {
+        return Err(Status::InvalidRequest);
+    }
+    let r: Request = quick_xml::de::from_reader(bytes).map_err(|_| Status::InvalidRequest)?;
+    if !context_id(&r.context)
+        || !model::valid_id(&r.store_id, 12)
+        || r.title_id == 0
+        || !model::valid_app_id(&r.msa_app_id)
+        || r.market.len() != 2
+        || !r.market.bytes().all(|c| c.is_ascii_uppercase())
+        || r.kinds == 0
+        || r.kinds & !31 != 0
+        || !(1..=100).contains(&r.page_size)
+        || (!r.continuation.is_empty() && !context_id(&r.continuation))
+    {
+        return Err(Status::InvalidRequest);
+    }
+    Ok(r)
+}
+pub struct Page {
+    pub snapshot: Snapshot,
+    pub continuation: String,
+}
+struct Pending {
+    request: Request,
+    items: Vec<Item>,
+    observed_at: i64,
+    expires_at: i64,
+    created: Instant,
+    cursor: String,
+    offset: usize,
+}
+#[derive(Default)]
+pub struct Broker {
+    pending: Vec<Pending>,
+}
+impl Broker {
+    pub fn clear(&mut self) {
+        self.pending.clear();
+    }
+    pub async fn query(&mut self, r: &Request, tokens: Arc<TokenManager>) -> Result<Page, Status> {
+        self.pending.retain(|p| {
+            p.created.elapsed() < Duration::from_secs(30)
+                && p.expires_at > chrono::Utc::now().timestamp()
+        });
+        if !r.continuation.is_empty() {
+            let index = self
+                .pending
+                .iter()
+                .position(|p| p.cursor == r.continuation && same_query(&p.request, r))
+                .ok_or(Status::Expired)?;
+            let result = take_page(&mut self.pending[index]);
+            self.pending.retain(|p| p.offset < p.items.len());
+            return result;
+        }
+        let pending = tokio::time::timeout(Duration::from_secs(35), collect(r, tokens))
+            .await
+            .map_err(|_| Status::Timeout)??;
+        if self.pending.len() >= 8 {
+            return Err(Status::Unavailable);
+        }
+        self.pending.push(pending);
+        let result = take_page(self.pending.last_mut().ok_or(Status::Error)?);
+        self.pending.retain(|p| p.offset < p.items.len());
+        result
+    }
+}
+fn same_query(a: &Request, b: &Request) -> bool {
+    a.context == b.context
+        && a.store_id == b.store_id
+        && a.title_id == b.title_id
+        && a.msa_app_id == b.msa_app_id
+        && a.market == b.market
+        && a.kinds == b.kinds
+        && a.page_size == b.page_size
+}
+fn token() -> String {
+    rand::random::<[u8; 32]>()
+        .iter()
+        .map(|b| format!("{b:02x}"))
+        .collect()
+}
+fn take_page(p: &mut Pending) -> Result<Page, Status> {
+    let now = chrono::Utc::now().timestamp();
+    if p.expires_at <= now || p.observed_at > now || p.created.elapsed() >= Duration::from_secs(30)
+    {
+        return Err(Status::Expired);
+    }
+    let start = p.offset;
+    let mut end = start;
+    let mut products = BTreeSet::new();
+    while end < p.items.len() {
+        let id = &p.items[end].store_id[..12];
+        if !products.contains(id) && products.len() == p.request.page_size {
+            break;
+        }
+        products.insert(id.to_owned());
+        end += 1;
+    }
+    // Bound XML frames as well as product count, never split one product's SKUs.
+    if end - start > 100 {
+        return Err(Status::Unsupported);
+    }
+    let continuation = if end < p.items.len() {
+        token()
+    } else {
+        String::new()
+    };
+    let page = Page {
+        snapshot: Snapshot {
+            items: p.items[start..end].to_vec(),
+            absent: vec![],
+            unknown: vec![],
+            observed_at: p.observed_at,
+            expires_at: p.expires_at,
+        },
+        continuation: continuation.clone(),
+    };
+    // Only advance after proving that the complete frame fits the IPC contract.
+    encode_page(&page)?;
+    p.offset = end;
+    p.cursor = continuation;
+    Ok(page)
+}
+fn active_items(records: Vec<Record>, kinds: u32, now: i64) -> Result<Vec<Item>, Status> {
+    let mut items = BTreeMap::<String, Item>::new();
+    for r in records {
+        if !r.active
+            || r.item.end_date <= now
+            || r.item.start_date > now
+            || r.item.kind & kinds == 0
+        {
+            continue;
+        }
+        if r.item.acquired_date > now {
+            return Err(Status::Unsupported);
+        }
+        if let Some(old) = items.get(&r.item.store_id) {
+            if old != &r.item {
+                return Err(Status::Unsupported);
+            }
+        } else {
+            items.insert(r.item.store_id.clone(), r.item);
+        }
+    }
+    Ok(items.into_values().collect())
+}
+fn associated(value: &Value, product: &str, parent: &str) -> Result<bool, Status> {
+    let p = &value["Product"];
+    if p["ProductId"].as_str() != Some(product) {
+        return Err(Status::Unsupported);
+    }
+    if product == parent {
+        return Ok(true);
+    }
+    let markets = p["MarketProperties"]
+        .as_array()
+        .ok_or(Status::Unsupported)?;
+    for market in markets {
+        let related = market["RelatedProducts"]
+            .as_array()
+            .ok_or(Status::Unsupported)?;
+        for r in related {
+            if r["RelatedProductId"].as_str() == Some(parent)
+                && r["RelationshipType"].as_str() == Some("addOnParent")
+            {
+                return Ok(true);
+            }
+        }
+    }
+    Ok(false)
+}
+async fn collect(r: &Request, tokens: Arc<TokenManager>) -> Result<Pending, Status> {
+    let binding = model::Request {
+        context: r.context.clone(),
+        store_id: r.store_id.clone(),
+        title_id: r.title_id,
+        msa_app_id: r.msa_app_id.clone(),
+        products: vec![],
+    };
+    let mut session = auth::Session::create(&binding, &tokens).await?;
+    let mut body = json!({"market":"neutral","validityType":"All","maxPageSize":100,"excludeDuplicates":true,"expandSatisfyingItems":true,"entitlementFilters":["*:Game","*:Durable","*:Pass","*:Consumable","*:UnmanagedConsumable"]});
+    let mut pages = model::BatchPages::default();
+    loop {
+        let page = model::parse_page(&session.page(&body).await?)?;
+        if let Some(cursor) = pages.push(page)? {
+            body["continuationToken"] = Value::String(cursor);
+        } else {
+            break;
+        }
+    }
+    let now = chrono::Utc::now().timestamp();
+    let (records, parent_expiry) = pages.finish(&r.store_id, now)?;
+    let mut items = active_items(records, r.kinds, now)?;
+    let roots = items
+        .iter()
+        .map(|i| i.store_id[..12].to_owned())
+        .collect::<BTreeSet<_>>();
+    let client = reqwest::Client::builder()
+        .timeout(Duration::from_secs(12))
+        .redirect(reqwest::redirect::Policy::none())
+        .build()
+        .map_err(|_| Status::Error)?;
+    let mut allowed = BTreeSet::new();
+    let mut workers = tokio::task::JoinSet::new();
+    let mut roots = roots.into_iter();
+    loop {
+        while workers.len() < 4 {
+            let Some(product) = roots.next() else {
+                break;
+            };
+            let client = client.clone();
+            let market = r.market.clone();
+            let parent = r.store_id.clone();
+            workers.spawn(async move {
+                let value = store_license::fetch_catalogue(&client, &product, &market).await?;
+                Ok::<_, Status>((product.clone(), associated(&value, &product, &parent)?))
+            });
+        }
+        match workers.join_next().await {
+            Some(result) => {
+                let (id, yes) = result.map_err(|_| Status::Error)??;
+                if yes {
+                    allowed.insert(id);
+                }
+            }
+            None => break,
+        }
+    }
+    items.retain(|i| allowed.contains(&i.store_id[..12]));
+    let now = chrono::Utc::now().timestamp();
+    let expires_at = items.iter().map(|i| i.end_date).fold(
+        session.expires_at.min(parent_expiry).min(now + 30),
+        i64::min,
+    );
+    if expires_at <= now {
+        return Err(Status::Expired);
+    }
+    Ok(Pending {
+        request: r.clone(),
+        items,
+        observed_at: now,
+        expires_at,
+        created: Instant::now(),
+        cursor: String::new(),
+        offset: 0,
+    })
+}
+fn encode_page(p: &Page) -> Result<Vec<u8>, Status> {
+    let s = Snapshot {
+        items: p.snapshot.items.clone(),
+        absent: vec![],
+        unknown: vec![],
+        observed_at: p.snapshot.observed_at,
+        expires_at: p.snapshot.expires_at,
+    };
+    let xml =
+        String::from_utf8(crate::store_collections::encode(Ok(s))).map_err(|_| Status::Error)?;
+    if !xml.contains("<Status>Available</Status>") {
+        return Err(Status::Expired);
+    }
+    let xml = xml.replace(
+        "</StoreCollectionsResponse>",
+        &format!(
+            "<Continuation>{}</Continuation></StoreCollectionsResponse>",
+            p.continuation
+        ),
+    );
+    if xml.len() > u16::MAX as usize {
+        return Err(Status::Unsupported);
+    }
+    Ok(xml.into_bytes())
+}
+pub fn encode(result: Result<Page, Status>) -> Vec<u8> {
+    match result.and_then(|p| encode_page(&p)) {
+        Ok(bytes) => bytes,
+        Err(status) => crate::store_collections::encode(Err(status)),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn request() -> Request {
+        Request {
+            context: "a".repeat(64),
+            store_id: "GAME1234EFGH".into(),
+            title_id: 1,
+            msa_app_id: "00000000-1111-2222-3333-444444444444".into(),
+            market: "US".into(),
+            kinds: 2,
+            page_size: 1,
+            continuation: String::new(),
+        }
+    }
+    fn item(id: &str) -> Item {
+        Item {
+            store_id: id.into(),
+            kind: 2,
+            acquired_date: 1,
+            start_date: 1,
+            end_date: i64::MAX,
+            quantity: 1,
+            is_trial: false,
+            trial_time_remaining_in_seconds: 0,
+            campaign_id: None,
+            developer_offer_id: None,
+        }
+    }
+    #[test]
+    fn entitled_items_ignore_expired_and_reject_conflicts() {
+        let good = item("ADDN1234EFGH/0001");
+        let mut expired = good.clone();
+        expired.end_date = 2;
+        let result = active_items(
+            vec![
+                Record {
+                    item: good.clone(),
+                    active: true,
+                },
+                Record {
+                    item: expired,
+                    active: true,
+                },
+            ],
+            2,
+            3,
+        )
+        .unwrap();
+        assert_eq!(result.len(), 1);
+        let mut other = good.clone();
+        other.acquired_date = 2;
+        assert!(
+            active_items(
+                vec![
+                    Record {
+                        item: good,
+                        active: true
+                    },
+                    Record {
+                        item: other,
+                        active: true
+                    }
+                ],
+                2,
+                3
+            )
+            .is_err()
+        );
+    }
+    #[test]
+    fn title_association_is_exact_and_independent_of_purchase_visibility() {
+        let v = json!({"Product":{"ProductId":"ADDN1234EFGH","MarketProperties":[{"RelatedProducts":[{"RelationshipType":"addOnParent","RelatedProductId":"GAME1234EFGH"}]}]}});
+        assert!(associated(&v, "ADDN1234EFGH", "GAME1234EFGH").unwrap());
+        assert!(!associated(&v, "ADDN1234EFGH", "OTHR1234EFGH").unwrap());
+        assert!(associated(&v, "OTHR1234EFGH", "GAME1234EFGH").is_err());
+    }
+    #[test]
+    fn pages_keep_product_skus_together_and_expire() {
+        let now = chrono::Utc::now().timestamp();
+        let mut p = Pending {
+            request: request(),
+            items: vec![
+                item("ADDN1234EFGH/0001"),
+                item("ADDN1234EFGH/0002"),
+                item("NEXT1234EFGH/0001"),
+            ],
+            observed_at: now,
+            expires_at: now + 30,
+            created: Instant::now(),
+            cursor: String::new(),
+            offset: 0,
+        };
+        let first = take_page(&mut p).unwrap();
+        assert_eq!(first.snapshot.items.len(), 2);
+        assert!(context_id(&first.continuation));
+        let second = take_page(&mut p).unwrap();
+        assert_eq!(second.snapshot.items.len(), 1);
+        assert!(second.continuation.is_empty());
+        p.expires_at = now;
+        assert!(matches!(take_page(&mut p), Err(Status::Expired)));
+    }
+    #[test]
+    fn request_binding_and_xml_are_strict() {
+        let xml = format!(
+            "<StoreInventoryRequest><Context>{}</Context><StoreId>GAME1234EFGH</StoreId><TitleId>1</TitleId><MsaAppId>00000000-1111-2222-3333-444444444444</MsaAppId><Market>US</Market><Kinds>2</Kinds><PageSize>1</PageSize></StoreInventoryRequest>",
+            "a".repeat(64)
+        );
+        assert!(parse_request(xml.as_bytes()).is_ok());
+        for bad in [
+            xml.replace("<Kinds>2", "<Kinds>32"),
+            xml.replace("<PageSize>1", "<PageSize>0"),
+            xml.replace(
+                "</StoreInventoryRequest>",
+                "<Context>x</Context></StoreInventoryRequest>",
+            ),
+            format!("{xml}{xml}"),
+        ] {
+            assert!(parse_request(bad.as_bytes()).is_err());
+        }
+        let mut other = request();
+        other.context = "b".repeat(64);
+        assert!(!same_query(&request(), &other));
+    }
+}
