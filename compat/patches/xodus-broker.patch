+            .await
+            .expect("Failed to sign HTTP GET request")
+            .build();
+
+        assert!(request.is_ok())
+    }
+
+    #[tokio::test]
+    async fn build_signed_post_request() {
+        let mut signer = get_request_signer();
+        let request = Client::new()
+            .post("https://example.xboxlive.com")
