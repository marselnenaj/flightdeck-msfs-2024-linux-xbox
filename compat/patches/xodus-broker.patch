+use eappx::{EAppxFile, FileInfo, Manifest};
+
+type ExtractResult<T> = Result<T, Box<dyn std::error::Error>>;
+
+/// Resolve every package-selected output before creating any destination file.
+fn extraction_plan<R: BufRead + Seek>(
+    package: &EAppxFile,
+    reader: &mut R,
+) -> ExtractResult<Vec<(String, FileInfo)>> {
+    let mut plan = Vec::new();
+    let blockmap = package
+        .find_footer_for_file(package.header.block_map_file_id)
+        .ok_or("missing blockmap footer")?;
+    plan.push(("AppxBlockmap.xml".to_owned(), blockmap.into()));
+    for (name, info) in [
+        (
+            "AppxSignature.p7x",
+            package.header.appx_signature_fileinfo(),
+        ),
+        (
+            "CodeIntegrity.cat",
+            package.header.code_integrity_fileinfo(),
+        ),
+    ] {
+        if let Some(info) = info.filter(|info| info.offset_to_file < package.file_len) {
+            plan.push((name.to_owned(), info));
+        }
+    }
+    for file in &package.blockmap.files {
+        let mut info: FileInfo = package
+            .find_footer_for_file(file.id())
+            .ok_or("missing file footer")?
+            .into();
+        if file.size != info.uncompressed_length {
+            return Err("blockmap file length mismatch".into());
+        }
+        info.filehash = file.filehash_bytes();
+        info.block_hashes = Some(file.block_hashes());
+        plan.push((file.name.clone(), info));
+    }
+    if package.header.is_bundle() {
+        let Manifest::BundleManifest(manifest) = package.read_manifest(reader)? else {
+            return Err("expected bundle manifest".into());
+        };
+        for (index, file) in manifest.packages.package.into_iter().enumerate() {
+            let info: FileInfo = package
+                .find_footer_for_file(index as u64)
+                .ok_or("missing bundle footer")?
+                .into();
+            if file.offset != info.offset_to_file {
+                return Err("bundle file offset mismatch".into());
+            }
+            plan.push((file.filename, info));
+        }
+    }
+    validate_names(plan.iter().map(|(name, _)| name.as_str()))?;
+    Ok(plan)
+}
+
+fn write_entry<R: BufRead + Seek>(
+    output: &Output,
+    reader: &mut R,
+    name: &str,
+    info: FileInfo,
+    from_bundle: bool,
+    crypto: Option<CryptoFileContext>,
+    checksum: bool,
+) -> ExtractResult<()> {
+    let mut file = output.begin(name)?;
+    EAppxFile::read_file(reader, &mut file, info, from_bundle, crypto, checksum)?;
+    Ok(())
+}
+
+fn extract<R: BufRead + Seek>(
+    package: &EAppxFile,
+    reader: &mut R,
+    destination: &Path,
+) -> ExtractResult<()> {
+    let plan = extraction_plan(package, reader)?;
+    std::fs::create_dir_all(destination)?;
+    let output = Output::open(destination)?;
+    for (name, info) in plan {
+        let crypto = if info.key_id_index == 0xFFFF {
+            None
+        } else {
+            package
+                .header
+                .key_ids
+                .get(info.key_id_index as usize)
+                .and_then(|id| package.keys.get(id))
+                .map(|key| -> ExtractResult<_> {
+                    let key: [u8; 32] = key.as_slice().try_into()?;
+                    Ok(CryptoFileContext {
+                        cipher: create_cipher(&key),
+                        tweak: get_tweak_for_file(
+                            &package.header.app_name(),
+                            &package.header.publisher_id(),
+                            &name,
+                        ),
+                    })
+                })
+                .transpose()?
+        };
+        write_entry(
+            &output,
+            reader,
+            &name,
+            info,
+            package.header.is_bundle(),
+            crypto,
+            package.do_checksum_check,
+        )?;
+    }
+    Ok(())
+}
