+
+    async fn poll_read_once<R, W>(
+        file: &mut PrefixCacheFile<R, W>,
+        bytes: &mut [u8],
+    ) -> std::task::Poll<io::Result<usize>>
+    where
+        R: tokio::io::AsyncRead + Unpin,
+        W: tokio::io::AsyncWrite + tokio::io::AsyncSeek + Unpin,
+    {
+        use std::future::Future;
