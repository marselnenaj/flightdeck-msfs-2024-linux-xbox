+        for bad in [xml.replace("OTHER1234567","ABCD1234EFGH"),xml.replace("OTHER1234567","../wrong"),xml.replace("</DurableStoreId>","</DurableStoreId><DurableStoreId>OTHER1234567</DurableStoreId>")]{assert!(parse_request(bad.as_bytes()).is_err());}
+    }
+    #[tokio::test]
+    async fn valid_cache_needs_no_credentials_but_never_survives_expiry_or_clear() {
+        let now=chrono::Utc::now().timestamp();let r=request();let mut cache=LicenseCache::default();
+        let license=map_full_license(&[product("0001",now+100)],&catalogue(),&r,now).unwrap();
+        cache.cached=Some(Cached{key:(r.context.clone(),r.store_id.clone(),r.package_family_name.clone(),r.market.clone()),observation:Observation{license:license.clone(),_candidates:vec![product("0001",now+100)],jwt_expires_at:now+90,observed_at:now,observed_instant:Instant::now()}});
+        let tokens=Arc::new(TokenManager::with_memory());assert_eq!(cache.query(&r,tokens.clone()).await.unwrap().revision,license.revision);
+        cache.cached.as_mut().unwrap().observation.jwt_expires_at=now-1;assert!(matches!(cache.query(&r,tokens.clone()).await,Err(Status::Unavailable)));assert!(cache.cached.is_none());
+        cache.clear();assert!(matches!(cache.query(&r,tokens).await,Err(Status::Unavailable)));
+    }
+}
diff --git c/crates/xodus-service/src/store_license/verified_token.rs w/crates/xodus-service/src/store_license/verified_token.rs
new file mode 100644
--- /dev/null
+++ w/crates/xodus-service/src/store_license/verified_token.rs
@@ -0,0 +1,143 @@
+//! Microsoft-documented PC license token validation. Inputs/claims have no Debug
+//! implementation and are never logged. Public certificate fetch has a fixed origin.
+use base64::prelude::*;
+use openssl::{hash::MessageDigest,pkey::Id,sign::Verifier,x509::X509};
+use serde_json::Value;
+
+pub struct VerifiedToken {
+    pub products: Vec<Product>,
+    pub expires_at: i64,
+    pub not_before: i64,
+}
+#[derive(Clone)]
+pub struct Product { pub product_id: String, pub sku_id: String, pub ends_at: i64 }
+
+pub fn nonce() -> Result<String,&'static str> {
+    use std::io::Read;
+    let mut bytes=[0;32];
+    std::fs::File::open("/dev/urandom").and_then(|mut f| f.read_exact(&mut bytes)).map_err(|_|"nonce")?;
+    Ok(BASE64_URL_SAFE_NO_PAD.encode(bytes))
+}
+
+pub async fn verify(client:&reqwest::Client, token:&str, nonce:&str) -> Result<VerifiedToken,&'static str> {
+    if token.len()>1024*1024 {return Err("token_size");}
+    let parts:Vec<_>=token.split('.').collect();
+    if parts.len()!=3 {return Err("token_format");}
+    let header:Value=serde_json::from_slice(&BASE64_URL_SAFE_NO_PAD.decode(parts[0]).map_err(|_|"header_encoding")?).map_err(|_|"header_json")?;
+    if header["alg"].as_str()!=Some("RS256") {return Err("signature_algorithm");}
+    let claims:Value=serde_json::from_slice(&BASE64_URL_SAFE_NO_PAD.decode(parts[1]).map_err(|_|"claims_encoding")?).map_err(|_|"claims_json")?;
+    let encoded=claims["LicenseTokenClaim"].as_str().ok_or("license_claim_missing")?;
+    let inner=BASE64_STANDARD.decode(encoded).map_err(|_|"license_claim_encoding")?;
+    let start=inner.iter().position(|&b|b==b'{').ok_or("license_claim_prefix")?;
+    if start>256 {return Err("license_claim_prefix");}
+    let license:Value=serde_json::from_slice(&inner[start..]).map_err(|_|"license_claim_json")?;
+    let certificate_id=license["certificateId"].as_str().ok_or("certificate_id")?;
+    if certificate_id.is_empty() || certificate_id.len()>128 || !certificate_id.bytes().all(|b|b.is_ascii_alphanumeric()||b==b'-') {return Err("certificate_id");}
+    let url=format!("https://licensing.mp.microsoft.com/v8.0/licenseToken/fullCertificate/{certificate_id}");
+    let mut response=client.get(url).send().await.map_err(|_|"certificate_request")?.error_for_status().map_err(|_|"certificate_status")?;
+    let mut bytes=Vec::new();
+    while let Some(chunk)=response.chunk().await.map_err(|_|"certificate_body")? {
+        if bytes.len()+chunk.len()>256*1024 {return Err("certificate_size");}
+        bytes.extend_from_slice(&chunk);
+    }
+    let cert=decode_certificate(&bytes)?;
+    verify_with_certificate(token,nonce,&cert,chrono::Utc::now().timestamp())
+}
+
+fn verify_with_certificate(token:&str,nonce:&str,cert:&X509,now:i64)->Result<VerifiedToken,&'static str> {
+    if token.len()>1024*1024 {return Err("token_size");}
+    let parts:Vec<_>=token.split('.').collect();
+    if parts.len()!=3 {return Err("token_format");}
+    let header:Value=serde_json::from_slice(&BASE64_URL_SAFE_NO_PAD.decode(parts[0]).map_err(|_|"header_encoding")?).map_err(|_|"header_json")?;
+    if header["alg"].as_str()!=Some("RS256") {return Err("signature_algorithm");}
+    let claims:Value=serde_json::from_slice(&BASE64_URL_SAFE_NO_PAD.decode(parts[1]).map_err(|_|"claims_encoding")?).map_err(|_|"claims_json")?;
+    let encoded=claims["LicenseTokenClaim"].as_str().ok_or("license_claim_missing")?;
+    let inner=BASE64_STANDARD.decode(encoded).map_err(|_|"license_claim_encoding")?;
+    let start=inner.iter().position(|&b|b==b'{').ok_or("license_claim_prefix")?;
+    if start>256 {return Err("license_claim_prefix");}
+    let license:Value=serde_json::from_slice(&inner[start..]).map_err(|_|"license_claim_json")?;
+    let der=cert.to_der().map_err(|_|"certificate_der")?;
+    let thumbprint=BASE64_URL_SAFE_NO_PAD.encode(openssl::sha::sha1(&der));
+    if header["x5t"].as_str().map(|s|s.trim_end_matches('='))!=Some(thumbprint.as_str()) {return Err("certificate_thumbprint");}
+    let time=openssl::asn1::Asn1Time::from_unix(now).map_err(|_|"clock")?;
+    if cert.not_before()>time || cert.not_after()<time {return Err("certificate_expired");}
+    let key=cert.public_key().map_err(|_|"certificate_public_key")?;
+    if key.id()!=Id::RSA || key.bits()<2048 {return Err("certificate_key_type");}
+    let signature=BASE64_URL_SAFE_NO_PAD.decode(parts[2]).map_err(|_|"signature_encoding")?;
+    let mut verifier=Verifier::new(MessageDigest::sha256(),&key).map_err(|_|"signature_setup")?;
+    verifier.update(format!("{}.{}",parts[0],parts[1]).as_bytes()).map_err(|_|"signature_setup")?;
+    if !verifier.verify(&signature).map_err(|_|"signature_verify")? {return Err("signature_invalid");}
+    let expires_at=claims["exp"].as_i64().ok_or("jwt_expiry")?;
+    let not_before=claims["nbf"].as_i64().ok_or("jwt_not_before")?;
+    if expires_at<=now || not_before>now || expires_at<=not_before {return Err("jwt_expired");}
+    if license["tokenVersion"].as_u64()!=Some(1) {return Err("token_version");}
+    // Microsoft documents no literal issuer/audience contract here. Trust comes
+    // from the fixed-origin TLS exchange, the Microsoft certificate/signature,
+    // current signed token dates, and the unique request nonce. Do not invent a
+    // stricter literal gate or use arbitrary audience values as account IDs.
+    if license["customDeveloperString"].as_str()!=Some(nonce) {return Err("nonce_mismatch");}
+    let items=license["licensableProducts"].as_array().ok_or("products_missing")?;
+    if items.len()>128 {return Err("product_count");}
+    let mut products=Vec::new();
+    for item in items {
+        let product_id=item["productId"].as_str().ok_or("product_id")?;
+        let sku_id=item["skuId"].as_str().ok_or("sku_id")?;
+        if product_id.len()!=12 || !product_id.bytes().all(|b|b.is_ascii_uppercase()||b.is_ascii_digit()) || sku_id.len()!=4 || !sku_id.bytes().all(|b|b.is_ascii_uppercase()||b.is_ascii_digit()) {return Err("product_id_format");}
+        let end=item["endDate"].as_str().ok_or("product_expiry")?;
+        let ends_at=chrono::DateTime::parse_from_rfc3339(end).map_err(|_|"product_expiry")?.timestamp();
+        if let Some(existing)=products.iter().find(|p:&&Product|p.product_id==product_id&&p.sku_id==sku_id) {
+            if existing.ends_at!=ends_at {return Err("conflicting_duplicate_product");}
+        } else {products.push(Product{product_id:product_id.into(),sku_id:sku_id.into(),ends_at});}
+    }
+    Ok(VerifiedToken{products,expires_at,not_before})
+}
+
+fn decode_certificate(bytes:&[u8]) -> Result<X509,&'static str> {
+    if let Ok(cert)=X509::from_der(bytes) {return Ok(cert);}
+    if let Ok(cert)=X509::from_pem(bytes) {return Ok(cert);}
+    let json:Value=serde_json::from_slice(bytes).map_err(|_|"certificate_json")?;
+    let text=json.as_str().or_else(||json["certificate"].as_str()).or_else(||json["Certificate"].as_str()).ok_or("certificate_field")?;
+    let der=BASE64_STANDARD.decode(text).map_err(|_|"certificate_base64")?;
+    X509::from_der(&der).map_err(|_|"certificate_parse")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use openssl::{asn1::Asn1Time,pkey::{PKey,Private},rsa::Rsa,sign::Signer,x509::X509NameBuilder};
+    use serde_json::json;
+    fn cert()->(PKey<Private>,X509) {
+        let key=PKey::from_rsa(Rsa::generate(2048).unwrap()).unwrap();let mut name=X509NameBuilder::new().unwrap();name.append_entry_by_text("CN","Synthetic License Test").unwrap();let name=name.build();
+        let mut cert=X509::builder().unwrap();cert.set_version(2).unwrap();cert.set_subject_name(&name).unwrap();cert.set_issuer_name(&name).unwrap();cert.set_pubkey(&key).unwrap();cert.set_not_before(&Asn1Time::from_unix(1_000).unwrap()).unwrap();cert.set_not_after(&Asn1Time::from_unix(10_000).unwrap()).unwrap();cert.sign(&key,MessageDigest::sha256()).unwrap();(key,cert.build())
+    }
+    fn token(key:&PKey<Private>,cert:&X509,license:Value,mutate:impl FnOnce(&mut Value))->String {
+        let header=json!({"alg":"RS256","x5t":BASE64_URL_SAFE_NO_PAD.encode(openssl::sha::sha1(&cert.to_der().unwrap()))});
+        let mut claims=json!({"iss":"https://licensing.mp.microsoft.com","aud":"https://licensing.mp.microsoft.com","nbf":2000,"exp":4000,"LicenseTokenClaim":BASE64_STANDARD.encode(format!("prefix{license}"))});mutate(&mut claims);
+        let body=format!("{}.{}",BASE64_URL_SAFE_NO_PAD.encode(header.to_string()),BASE64_URL_SAFE_NO_PAD.encode(claims.to_string()));let mut signer=Signer::new(MessageDigest::sha256(),key).unwrap();signer.update(body.as_bytes()).unwrap();format!("{body}.{}",BASE64_URL_SAFE_NO_PAD.encode(signer.sign_to_vec().unwrap()))
+    }
+    fn license()->Value {json!({"certificateId":"synthetic-id","customDeveloperString":"SYNTHETIC_NONCE","tokenVersion":1,"licensableProducts":[{"productId":"ABCD1234EFGH","skuId":"0001","endDate":"2040-01-01T00:00:00Z"}]})}
+    #[test]
+    fn caller_challenge_is_exact_signed_content_and_empty_products_are_valid() {
+        let (key,cert)=cert();
+        for challenge in ["  &<>\"'\r\n\t Österreich 🛫  ", "FIRST_CALLER_NONCE", "SECOND_CALLER_NONCE"] {
+            let mut l=license();l["customDeveloperString"]=json!(challenge);l["licensableProducts"]=json!([]);
+            let signed=token(&key,&cert,l,|_|{});let original=signed.clone();
+            assert!(verify_with_certificate(&signed,challenge,&cert,3000).unwrap().products.is_empty());
+            assert_eq!(signed,original);
+            assert_eq!(verify_with_certificate(&signed,&format!("{challenge}changed"),&cert,3000).err(),Some("nonce_mismatch"));
+        }
+    }
+    #[test]
+    fn signed_token_nonce_time_version_and_duplicates() {
+        let (key,cert)=cert();let good=token(&key,&cert,license(),|_|{});
+        let verified=verify_with_certificate(&good,"SYNTHETIC_NONCE",&cert,3000).unwrap();assert_eq!(verified.products.len(),1);assert_eq!(verified.expires_at,4000);
+        assert_eq!(verify_with_certificate(&good,"WRONG_NONCE",&cert,3000).err(),Some("nonce_mismatch"));
+        assert_eq!(verify_with_certificate(&good,"SYNTHETIC_NONCE",&cert,4000).err(),Some("jwt_expired"));
+        assert_eq!(verify_with_certificate(&good,"SYNTHETIC_NONCE",&cert,1999).err(),Some("jwt_expired"));
+        let alternate=token(&key,&cert,license(),|c|c["iss"]=json!("other signed issuer"));assert!(verify_with_certificate(&alternate,"SYNTHETIC_NONCE",&cert,3000).is_ok());
+        let mut l=license();l["tokenVersion"]=json!(2);let bad=token(&key,&cert,l,|_|{});assert_eq!(verify_with_certificate(&bad,"SYNTHETIC_NONCE",&cert,3000).err(),Some("token_version"));
+        let mut l=license();let mut duplicate=l["licensableProducts"][0].clone();duplicate["endDate"]=json!("2041-01-01T00:00:00Z");l["licensableProducts"].as_array_mut().unwrap().push(duplicate);let bad=token(&key,&cert,l,|_|{});assert_eq!(verify_with_certificate(&bad,"SYNTHETIC_NONCE",&cert,3000).err(),Some("conflicting_duplicate_product"));
+        let mut split:Vec<String>=good.split('.').map(String::from).collect();let mut sig=BASE64_URL_SAFE_NO_PAD.decode(&split[2]).unwrap();sig[0]^=1;split[2]=BASE64_URL_SAFE_NO_PAD.encode(sig);assert_eq!(verify_with_certificate(&split.join("."),"SYNTHETIC_NONCE",&cert,3000).err(),Some("signature_invalid"));
+        assert_eq!(verify_with_certificate(&good,"SYNTHETIC_NONCE",&cert,11_000).err(),Some("certificate_expired"));
+    }
+}
diff --git c/crates/xodus-service/src/store_license_token.rs w/crates/xodus-service/src/store_license_token.rs
new file mode 100644
--- /dev/null
+++ w/crates/xodus-service/src/store_license_token.rs
@@ -0,0 +1,250 @@
+//! Receipt acquisition, not an entitlement decision. The original Microsoft JWT
+//! and caller challenge have no Debug implementations and must never be logged.
+use crate::store_license::{acquire_msa_tokens, verified_token, Status};
+use quick_xml::{events::Event, Reader};
+use std::{sync::Arc, time::Duration};
+use xodus::tokens::TokenManager;
+
+pub const MAX_PRODUCTS: usize = 100;
+pub const MAX_CHALLENGE: usize = 8192;
+pub const MAX_TOKEN: usize = 60000;
+
+#[derive(Clone)]
+pub struct Request {
+    pub context: String,
+    pub store_id: String,
+    pub product_ids: Vec<String>,
+    pub custom_developer_string: String,
+}
+
+// The wrapper carries validity through the final account check and XML encoding.
+// No token cache: each call, including repeated challenges, performs a new request.
+pub struct Receipt { token: String, not_before: i64, expires_at: i64 }
+
+#[derive(Default)]
+struct Node { name: String, text: String, children: Vec<Node> }
+
+fn xml_char(c: char) -> bool {
+    matches!(c, '\t'|'\n'|'\r'|'\u{20}'..='\u{d7ff}'|'\u{e000}'..='\u{fffd}'|'\u{10000}'..='\u{10ffff}')
+}
+fn product_id(s: &str) -> bool {
+    s.len() == 12 && s.bytes().all(|b| b.is_ascii_uppercase() || b.is_ascii_digit())
+}
+fn begin(stack: &mut Vec<Node>, name: &str, root_seen: bool) -> Result<(), Status> {
+    let allowed = match stack.last().map(|n| n.name.as_str()) {
+        None => !root_seen && name == "StoreLicenseTokenRequest",
+        Some("StoreLicenseTokenRequest") => ["Context", "StoreId", "ProductIds", "CustomDeveloperString"].contains(&name),
+        Some("ProductIds") => name == "ProductId" && stack.last().unwrap().children.len() < MAX_PRODUCTS,
+        _ => false,
+    };
+    if !allowed { return Err(Status::InvalidRequest); }
+    stack.push(Node { name: name.into(), ..Node::default() });
+    Ok(())
+}
+fn end(stack: &mut Vec<Node>, root: &mut Option<Node>) -> Result<(), Status> {
+    let node = stack.pop().ok_or(Status::InvalidRequest)?;
+    if let Some(parent) = stack.last_mut() { parent.children.push(node); }
+    else if root.replace(node).is_some() { return Err(Status::InvalidRequest); }
+    Ok(())
+}
+fn text(stack: &mut [Node], value: &str) -> Result<(), Status> {
+    if !value.chars().all(xml_char) { return Err(Status::InvalidRequest); }
+    match stack.last_mut() {
+        Some(node) if !["StoreLicenseTokenRequest", "ProductIds"].contains(&node.name.as_str()) => node.text.push_str(value),
+        _ if value.chars().all(|c| matches!(c, ' '|'\t'|'\r'|'\n')) => (),
+        _ => return Err(Status::InvalidRequest),
+    }
+    Ok(())
+}
+
+pub fn parse_request(input: &[u8]) -> Result<Request, Status> {
+    if input.len() > u16::MAX as usize { return Err(Status::InvalidRequest); }
+    let input = input.strip_suffix(&[0]).unwrap_or(input);
+    let input = std::str::from_utf8(input).map_err(|_| Status::InvalidRequest)?;
+    if input.is_empty() || input.contains('\0') { return Err(Status::InvalidRequest); }
+    let mut reader = Reader::from_str(input);
+    let mut stack = Vec::new();
+    let mut root = None;
+    loop {
+        match reader.read_event().map_err(|_| Status::InvalidRequest)? {
+            Event::Start(e) => {
+                if e.attributes().next().is_some() { return Err(Status::InvalidRequest); }
+                begin(&mut stack, e.name().as_ref(), root.is_some())?;
+            },
+            Event::Empty(e) => {
+                if e.attributes().next().is_some() { return Err(Status::InvalidRequest); }
+                begin(&mut stack, e.name().as_ref(), root.is_some())?;
+                end(&mut stack, &mut root)?;
+            },
+            Event::End(_) => end(&mut stack, &mut root)?,
+            // Deliberately preserve whitespace/UTF-8 exactly. The native encoder
+            // represents CR as &#13;, so XML line-ending conversion cannot alter it.
+            Event::Text(t) => text(&mut stack, t.as_ref())?,
+            Event::GeneralRef(r) => {
+                let ch = match r.resolve_char_ref().map_err(|_| Status::InvalidRequest)? {
+                    Some(ch) => ch,
+                    None => match r.as_ref() { "amp" => '&', "lt" => '<', "gt" => '>', "quot" => '"', "apos" => '\'', _ => return Err(Status::InvalidRequest) },
+                };
+                text(&mut stack, ch.encode_utf8(&mut [0; 4]))?;
+            },
+            Event::Eof => break,
+            // No DTD/entity declarations, namespaces, comments, PI or CDATA.
+            _ => return Err(Status::InvalidRequest),
+        }
+    }
+    if !stack.is_empty() { return Err(Status::InvalidRequest); }
+    let root = root.ok_or(Status::InvalidRequest)?;
+    let mut fields = std::collections::BTreeMap::new();
+    for node in root.children {
+        if fields.insert(node.name.clone(), node).is_some() { return Err(Status::InvalidRequest); }
+    }
+    if fields.len() != 4 { return Err(Status::InvalidRequest); }
+    let context = fields.remove("Context").ok_or(Status::InvalidRequest)?.text;
+    let store_id = fields.remove("StoreId").ok_or(Status::InvalidRequest)?.text;
+    let product_ids = fields.remove("ProductIds").ok_or(Status::InvalidRequest)?.children.into_iter().map(|n| n.text).collect::<Vec<_>>();
+    let custom_developer_string = fields.remove("CustomDeveloperString").ok_or(Status::InvalidRequest)?.text;
+    if context.len() != 64 || !context.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        || !product_id(&store_id) || !product_ids.iter().all(|s| product_id(s))
+        || custom_developer_string.is_empty() || custom_developer_string.len() > MAX_CHALLENGE {
+        return Err(Status::InvalidRequest);
+    }
+    Ok(Request { context, store_id, product_ids, custom_developer_string })
+}
+
+pub async fn query(request: Request, tokens: Arc<TokenManager>) -> Result<Receipt, Status> {
+    let mut worker = tokio::task::JoinSet::new();
+    worker.spawn(async move { acquire(&request, &tokens).await });
+    match tokio::time::timeout(Duration::from_secs(35), worker.join_next()).await {
+        Ok(Some(Ok(result))) => result,
+        Ok(_) => Err(Status::Error),
+        Err(_) => {
+            worker.abort_all();
+            while worker.join_next().await.is_some() {}
+            Err(Status::Timeout)
+        },
+    }
+}
+
+async fn acquire(request: &Request, tokens: &TokenManager) -> Result<Receipt, Status> {
+    let client = reqwest::Client::builder().timeout(Duration::from_secs(15)).redirect(reqwest::redirect::Policy::none()).build().map_err(|_| Status::Error)?;
+    let (device, user, puid) = acquire_msa_tokens(&client, tokens).await?;
+    // Forward order, duplicates and the exact developer string. Never substitute
+    // GameLicense's generated nonce or silently add the parent to this array.
+    for attempt in 0..3 {
+        let token = xodus::licensing::content::get_license_token(&client, device.clone(), user.clone(), puid.clone(),
+            request.store_id.clone(), request.product_ids.clone(), request.custom_developer_string.clone())
+            .await.map_err(|_| Status::Error)?;
+        if !wire_token(&token) { return Err(Status::Error); }
+        let verified = verified_token::verify(&client, &token, &request.custom_developer_string).await
+            .map_err(|stage| { tracing::warn!(stage, "Store receipt verification failed"); Status::Error })?;
+        let now = chrono::Utc::now().timestamp();
+        let result = receipt(token, &verified, request, now)?;
+        // Downloads can race the service's license renewal. Repeat the real
+        // read for explicitly requested products with only expired grants.
+        // Never alter the signed receipt, retry missing ownership, or cache a
+        // developer challenge. The existing deadline/cancellation bounds us.
+        if attempt==2 || !needs_refresh(&verified, request, now) { return Ok(result); }
+        tokio::time::sleep(Duration::from_millis(if attempt==0 {350} else {1000})).await;
+    }
+    Err(Status::Error)
+}
+
+fn needs_refresh(verified:&verified_token::VerifiedToken, request:&Request, now:i64)->bool {
+    request.product_ids.iter().any(|id| {
+        verified.products.iter().any(|p| &p.product_id==id && p.ends_at<=now) &&
+        !verified.products.iter().any(|p| &p.product_id==id && p.ends_at>now)
+    })
+}
+
+fn wire_token(token: &str) -> bool {
+    !token.is_empty() && token.len() <= MAX_TOKEN && token.split('.').count() == 3
+        && token.bytes().all(|b| b.is_ascii_alphanumeric() || matches!(b, b'.'|b'_'|b'-'))
+}
+fn receipt(token: String, verified: &verified_token::VerifiedToken, request: &Request, now: i64) -> Result<Receipt, Status> {
+    if now < verified.not_before || now >= verified.expires_at { return Err(Status::Expired); }
+    // The documented endpoint receives a parent plus related products. Accept
+    // either, but never introduce unrelated signed products into this request.
+    if verified.products.iter().any(|p| p.product_id != request.store_id && !request.product_ids.contains(&p.product_id)) { return Err(Status::Error); }
+    // Empty/partial entitlements and trials are legitimate receipt contents. The
+    // game's service evaluates the unmodified signed claims; no catalogue mapping.
+    Ok(Receipt { token, not_before: verified.not_before, expires_at: verified.expires_at })
+}
+
+pub fn encode(result: Result<Receipt, Status>) -> Vec<u8> {
+    let now = chrono::Utc::now().timestamp();
+    let result = result.and_then(|r| {
+        if now < r.not_before || now >= r.expires_at { Err(Status::Expired) }
+        else if !wire_token(&r.token) { Err(Status::Error) }
+        else { Ok(r) }
+    });
+    let body = match result {
+        Ok(r) => format!("<Status>Available</Status><Token>{}</Token>", r.token),
+        Err(status) => format!("<Status>{status:?}</Status>"),
+    };
+    format!("<StoreLicenseTokenResponse>{body}</StoreLicenseTokenResponse>").into_bytes()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn xml(challenge: &str, ids: &str) -> String {
+        format!("<StoreLicenseTokenRequest><Context>{}</Context><StoreId>ABCD1234EFGH</StoreId><ProductIds>{ids}</ProductIds><CustomDeveloperString>{challenge}</CustomDeveloperString></StoreLicenseTokenRequest>", "a".repeat(64))
+    }
+    #[test]
+    fn exact_challenge_and_product_list_roundtrip() {
+        let r = parse_request(xml("  &amp;&lt;&gt;&quot;&apos;&#13;\n\t Österreich 🛫  ", "<ProductId>ABCD1234EFGH</ProductId><ProductId>OTHER1234567</ProductId><ProductId>ABCD1234EFGH</ProductId>").as_bytes()).unwrap();
+        assert_eq!(r.custom_developer_string, "  &<>\"'\r\n\t Österreich 🛫  ");
+        assert_eq!(r.product_ids, ["ABCD1234EFGH", "OTHER1234567", "ABCD1234EFGH"]);
+        assert!(parse_request(xml("valid", "").as_bytes()).unwrap().product_ids.is_empty());
+        assert!(parse_request(xml("valid", "").replace("<ProductIds></ProductIds>", "<ProductIds/>").as_bytes()).is_ok());
+        assert!(parse_request(format!("{}\0", xml("valid", "")).as_bytes()).is_ok());
+    }
+    #[test]
+    fn malformed_schema_is_status_only() {
+        let good = xml("synthetic", "<ProductId>ABCD1234EFGH</ProductId>");
+        for bad in [good.replace("synthetic", ""), good.replace("synthetic", "&#0;"), good.replace("synthetic", "&#1;"), good.replace("synthetic", "&unknown;"), good.replace("synthetic", "\u{1}"), good.replace("synthetic", "<![CDATA[value]]>"), good.replace("<StoreId>", "<StoreId x='1'>"), good.replace("</StoreId>", "</StoreId><StoreId>ABCD1234EFGH</StoreId>"), good.replace("<ProductId>", "<Unexpected>"), good.replace("<ProductIds>", "<ProductIds>text"), good.replace("ABCD1234EFGH", "../escape"), format!("<!DOCTYPE x>{good}"), format!("{good}{good}"), format!("{good}\0\0"), good.replace("synthetic", &"x".repeat(MAX_CHALLENGE + 1)), good.replace("<ProductId>ABCD1234EFGH</ProductId>", &"<ProductId>ABCD1234EFGH</ProductId>".repeat(MAX_PRODUCTS + 1))] {
+            assert!(matches!(parse_request(bad.as_bytes()), Err(Status::InvalidRequest)));
+        }
+        for status in [Status::Unavailable, Status::Expired, Status::NotLicensed, Status::Unsupported, Status::InvalidRequest, Status::Error, Status::Timeout] {
+            assert_eq!(String::from_utf8(encode(Err(status))).unwrap(), format!("<StoreLicenseTokenResponse><Status>{status:?}</Status></StoreLicenseTokenResponse>"));
+        }
+    }
+    #[test]
+    fn opaque_receipt_partial_empty_time_and_output_bounds() {
+        let request = parse_request(xml("test", "<ProductId>OTHER1234567</ProductId>").as_bytes()).unwrap();
+        let now = chrono::Utc::now().timestamp();
+        let mut verified = verified_token::VerifiedToken { products: vec![], not_before: now - 1, expires_at: now + 100 };
+        let original = "eyJTest.Exact_Payload.Signature-123".to_string();
+        let encoded = encode(receipt(original.clone(), &verified, &request, now));
+        assert_eq!(encoded, format!("<StoreLicenseTokenResponse><Status>Available</Status><Token>{original}</Token></StoreLicenseTokenResponse>").as_bytes());
+        // A signed expired product still belongs in the receipt for the server.
+        verified.products.push(verified_token::Product { product_id: "OTHER1234567".into(), sku_id: "0001".into(), ends_at: 0 });
+        assert!(receipt(original.clone(), &verified, &request, now).is_ok());
+        assert!(matches!(receipt(original.clone(), &verified, &request, now + 100), Err(Status::Expired)));
+        verified.products[0].product_id = "UNRELATED123".into();
+        assert!(matches!(receipt(original, &verified, &request, now), Err(Status::Error)));
+        assert!(!wire_token("a.b.<")); assert!(!wire_token("a.b.c\0")); assert!(!wire_token(&format!("a.b.{}", "a".repeat(MAX_TOKEN))));
+        let max = format!("a.b.{}", "a".repeat(MAX_TOKEN - 4));
+        assert!(encode(Ok(Receipt { token: max, not_before: now - 1, expires_at: now + 100 })).len() <= u16::MAX as usize);
+        assert!(String::from_utf8(encode(Ok(Receipt { token: "a.b.c".into(), not_before: now - 100, expires_at: now }))).unwrap().contains("<Status>Expired</Status>"));
+    }
+    #[tokio::test]
+    async fn missing_broker_never_returns_cached_receipt() {
+        let tokens = Arc::new(TokenManager::with_memory());
+        for challenge in ["first", "second"] {
+            assert!(matches!(query(parse_request(xml(challenge, "").as_bytes()).unwrap(), tokens.clone()).await, Err(Status::Unavailable)));
+        }
+    }
+    #[test]
+    fn refresh_only_expired_requested_products_without_a_valid_alternative() {
+        let request=parse_request(xml("same-challenge","<ProductId>OTHER1234567</ProductId>").as_bytes()).unwrap();
+        let mut verified=verified_token::VerifiedToken {products:vec![],not_before:0,expires_at:1000};
+        assert!(!needs_refresh(&verified,&request,100));
+        verified.products.push(verified_token::Product {product_id:request.store_id.clone(),sku_id:"0001".into(),ends_at:1});
+        assert!(!needs_refresh(&verified,&request,100));
+        verified.products.push(verified_token::Product {product_id:"OTHER1234567".into(),sku_id:"0001".into(),ends_at:100});
+        assert!(needs_refresh(&verified,&request,100));
+        verified.products.push(verified_token::Product {product_id:"OTHER1234567".into(),sku_id:"0002".into(),ends_at:101});
+        assert!(!needs_refresh(&verified,&request,100));
+    }
+}
diff --git c/crates/xodus-service/src/store_package_updates.rs w/crates/xodus-service/src/store_package_updates.rs
new file mode 100644
--- /dev/null
+++ w/crates/xodus-service/src/store_package_updates.rs
@@ -0,0 +1,438 @@
+//! Online check of Flightdeck's single registered MSIXVC base package.
+//! No installed DLC is inferred from ownership. Newer revisions remain an
+//! explicit error until update-policy metadata and package installation exist.
+use crate::store_license::{self, Status};
+use quick_xml::{Reader, events::Event};
+use serde::Deserialize;
+use serde_json::Value;
+use std::{collections::BTreeSet, sync::Arc, time::Duration};
+use xodus::{
+    models::{live::ExchangeUserTokenOutcome, secrets::Token, soap},
+    tokens::TokenManager,
+};
+
+#[derive(Clone, Deserialize)]
+#[serde(
+    rename = "StorePackageUpdatesRequest",
+    rename_all = "PascalCase",
+    deny_unknown_fields
+)]
+pub struct Request {
+    pub context: String,
+    pub store_id: String,
+    pub package_family_name: String,
+    pub market: String,
+    pub version: String,
+    pub scope: String,
+}
+#[derive(Debug, PartialEq, Eq)]
+pub enum Outcome {
+    Current,
+    DifferentRevision,
+}
+fn version(s: &str) -> Option<[u16; 4]> {
+    let parts = s.split('.').collect::<Vec<_>>();
+    if parts.len() != 4 {
+        return None;
+    }
+    let mut out = [0; 4];
+    for (i, p) in parts.iter().enumerate() {
+        if p.is_empty() || p.len() > 5 || !p.bytes().all(|c| c.is_ascii_digit()) {
+            return None;
+        }
+        out[i] = p.parse().ok()?;
+    }
+    Some(out)
+}
+fn uuid(s: &str) -> bool {
+    s.len() == 36
+        && s.bytes().enumerate().all(|(i, b)| {
+            if [8, 13, 18, 23].contains(&i) {
+                b == b'-'
+            } else {
+                b.is_ascii_hexdigit()
+            }
+        })
+}
+pub fn parse_request(bytes: &[u8]) -> Result<Request, Status> {
+    let bytes = bytes.strip_suffix(&[0]).unwrap_or(bytes);
+    if bytes.is_empty() || bytes.len() > 2048 || bytes.contains(&0) {
+        return Err(Status::InvalidRequest);
+    }
+    let mut reader = Reader::from_reader(bytes);
+    let mut depth = 0;
+    let mut roots = 0;
+    loop {
+        match reader.read_event().map_err(|_| Status::InvalidRequest)? {
+            Event::Start(e) => {
+                if e.attributes().next().is_some() || depth > 1 {
+                    return Err(Status::InvalidRequest);
+                }
+                if depth == 0 {
+                    if e.name().as_ref() != "StorePackageUpdatesRequest" {
+                        return Err(Status::InvalidRequest);
+                    }
+                    roots += 1;
+                } else if ![
+                    "Context",
+                    "StoreId",
+                    "PackageFamilyName",
+                    "Market",
+                    "Version",
+                    "Scope",
+                ]
+                .contains(&e.name().as_ref())
+                {
+                    return Err(Status::InvalidRequest);
+                }
+                depth += 1;
+            }
+            Event::End(_) => {
+                if depth == 0 {
+                    return Err(Status::InvalidRequest);
+                }
+                depth -= 1;
+            }
+            Event::Text(t) if depth == 2 || t.as_ref().chars().all(|c| c.is_ascii_whitespace()) => {
+                ()
+            }
+            Event::Eof => break,
+            _ => return Err(Status::InvalidRequest),
+        }
+    }
+    if roots != 1 || depth != 0 {
+        return Err(Status::InvalidRequest);
+    }
+    let r: Request = quick_xml::de::from_reader(bytes).map_err(|_| Status::InvalidRequest)?;
+    if r.context.len() != 64
+        || !r
+            .context
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        || r.store_id.len() != 12
+        || !r
+            .store_id
+            .bytes()
+            .all(|b| b.is_ascii_uppercase() || b.is_ascii_digit())
+        || r.package_family_name.is_empty()
+        || r.package_family_name.len() > 64
+        || !r
+            .package_family_name
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'.' || b == b'-')
+        || r.market.len() != 2
+        || !r.market.bytes().all(|b| b.is_ascii_uppercase())
+        || version(&r.version).is_none()
+        || r.scope != "FlightdeckBaseGameOnlyV1"
+    {
+        return Err(Status::InvalidRequest);
+    }
+    Ok(r)
+}
+pub fn encode(result: Result<Outcome, Status>) -> Vec<u8> {
+    let status = match result {
+        Ok(Outcome::Current) => "Current".into(),
+        Ok(Outcome::DifferentRevision) => "DifferentRevision".into(),
+        Err(s) => format!("{s:?}"),
+    };
+    format!("<StorePackageUpdatesResponse><Status>{status}</Status></StorePackageUpdatesResponse>")
+        .into_bytes()
+}
+fn content_id(c: &Value, r: &Request) -> Result<String, Status> {
+    let p = &c["Product"];
+    if p["ProductId"].as_str() != Some(&r.store_id) || p["ProductKind"].as_str() != Some("Game") {
+        return Err(Status::Unsupported);
+    }
+    let mut ids = BTreeSet::new();
+    for item in p["DisplaySkuAvailabilities"]
+        .as_array()
+        .ok_or(Status::Unsupported)?
+    {
+        let sku = &item["Sku"];
+        let properties = &sku["Properties"];
+        if sku["SkuType"] != "full"
+            || properties["IsTrial"] != false
+            || properties["IsPreOrder"] != false
+            || properties["IsBundle"] != false
+        {
+            continue;
+        }
+        for package in properties["Packages"]
+            .as_array()
+            .ok_or(Status::Unsupported)?
+        {
+            if package["PackageFamilyName"].as_str() == Some(&r.package_family_name)
+                && package["PackageFormat"] == "MSIXVC"
+                && package["PlatformDependencies"]
+                    .as_array()
+                    .is_some_and(|v| v.iter().any(|v| v["PlatformName"] == "Windows.Desktop"))
+            {
+                let id = package["ContentId"]
+                    .as_str()
+                    .filter(|s| uuid(s))
+                    .ok_or(Status::Unsupported)?;
+                ids.insert(id.to_ascii_lowercase());
+            }
+        }
+    }
+    if ids.len() != 1 {
+        return Err(Status::Unsupported);
+    }
+    Ok(ids.into_iter().next().ok_or(Status::Unsupported)?)
+}
+fn classify(p: &Value, content: &str, installed: &str) -> Result<Outcome, Status> {
+    if p["PackageFound"] != true
+        || p["ContentId"]
+            .as_str()
+            .map(str::to_ascii_lowercase)
+            .as_deref()
+            != Some(content)
+        || p["UpdatePredownload"] != false
+    {
+        return Err(Status::Unsupported);
+    }
+    let revision = p["VersionId"].as_str().ok_or(Status::Unsupported)?;
+    let raw = p["Version"].as_str().ok_or(Status::Unsupported)?;
+    let latest = if let Some(v) = version(raw) {
+        if !uuid(revision) {
+            return Err(Status::Unsupported);
+        }
+        v
+    } else {
+        let (v, id) = raw.rsplit_once('.').ok_or(Status::Unsupported)?;
+        if revision != raw || !uuid(id) {
+            return Err(Status::Unsupported);
+        }
+        version(v).ok_or(Status::Unsupported)?
+    };
+    let files = p["PackageFiles"].as_array().ok_or(Status::Unsupported)?;
+    let images = files
+        .iter()
+        .filter(|f| {
+            f["FileName"]
+                .as_str()
+                .is_some_and(|s| s.ends_with(".msixvc"))
+        })
+        .collect::<Vec<_>>();
+    if images.len() != 1 {
+        return Err(Status::Unsupported);
+    }
+    let file = images[0];
+    if file["ContentId"]
+        .as_str()
+        .map(str::to_ascii_lowercase)
+        .as_deref()
+        != Some(content)
+        || file["VersionId"].as_str() != Some(revision)
+        || !file["FileSize"]
+            .as_u64()
+            .is_some_and(|n| n > 0 && n < 8 * 1024u64.pow(4))
+    {
+        return Err(Status::Unsupported);
+    }
+    let installed = version(installed).ok_or(Status::InvalidRequest)?;
+    // Neither server rollback nor a future installation becomes "no updates".
+    Ok(if latest == installed {
+        Outcome::Current
+    } else {
+        Outcome::DifferentRevision
+    })
+}
+async fn observe(r: &Request, tokens: &TokenManager) -> Result<Outcome, Status> {
+    let client = reqwest::Client::builder()
+        .timeout(Duration::from_secs(12))
+        .redirect(reqwest::redirect::Policy::none())
+        .build()
+        .map_err(|_| Status::Error)?;
+    let catalogue = store_license::fetch_catalogue(&client, &r.store_id, &r.market).await?;
+    let content = content_id(&catalogue, r)?;
+    let Token::Legacy(device) = tokens
+        .get_device_sts_token()
+        .map_err(|_| Status::Unavailable)?
+    else {
+        return Err(Status::Unavailable);
+    };
+    let Token::Legacy(user) = tokens
+        .get_user_sts_token()
+        .map_err(|_| Status::Unavailable)?
+    else {
+        return Err(Status::Unavailable);
+    };
+    let exchange = xodus::api::live::exchange_user_token(
+        &client,
+        user,
+        "USERNAME".into(),
+        device,
+        None,
+        Some("Silent".into()),
+        "{d6d5a677-0872-4ab0-9442-bb792fce85c5}".into(),
+        &[(
+            "user.auth.xboxlive.com".into(),
+            Some(soap::PolicyReference::mbi_ssl()),
+        )],
+    )
+    .await
+    .map_err(Status::from)?;
+    let issued = match exchange {
+        ExchangeUserTokenOutcome::Issued(
+            soap::BodyContent::RequestSecurityTokenResponseCollection(mut c),
+        ) if c.security_tokens.len() == 1 => c.security_tokens.remove(0),
+        ExchangeUserTokenOutcome::Issued(soap::BodyContent::RequestSecurityTokenResponse(r)) => *r,
+        ExchangeUserTokenOutcome::Fault(pp) => return Err(match xodus::tokens::session::fault(pp.as_ref()) {
+            xodus::tokens::session::SessionError::SignInRequired => Status::Expired, _ => Status::Error,
+        }),
+        _ => return Err(Status::Unavailable),
+    };
+    if chrono::DateTime::parse_from_rfc3339(&issued.lifetime.expires)
+        .map_err(|_| Status::Unsupported)?
+        .timestamp()
+        <= chrono::Utc::now().timestamp()
+    {
+        return Err(Status::Expired);
+    }
+    let Token::Compact(rps) = Token::from(issued) else {
+        return Err(Status::Unsupported);
+    };
+    let user = xodus::api::xbox::authenticate_xbox_user(&client, rps)
+        .await
+        .map_err(|_| Status::Unavailable)?;
+    if user.not_after <= chrono::Utc::now() {
+        return Err(Status::Expired);
+    }
+    let auth =
+        xodus::api::xbox::request_xsts_token(&client, user.token, "http://update.xboxlive.com")
+            .await
+            .map_err(|_| Status::Unavailable)?;
+    if auth.not_after <= chrono::Utc::now() || auth.token.is_empty() {
+        return Err(Status::Expired);
+    }
+    let uhs = auth
+        .user_hash()
+        .filter(|s| !s.is_empty())
+        .ok_or(Status::Unsupported)?;
+    let response = client
+        .get(format!(
+            "https://packagespc.xboxlive.com/GetBasePackage/{content}"
+        ))
+        .header("x-xbl-contract-version", "3")
+        .header("Authorization", format!("XBL3.0 x={uhs};{}", auth.token))
+        .send()
+        .await
+        .map_err(|_| Status::Error)?;
+    let mut response = response.error_for_status().map_err(|_| Status::Error)?;
+    let mut bytes = Vec::new();
+    while let Some(chunk) = response.chunk().await.map_err(|_| Status::Error)? {
+        if bytes.len() + chunk.len() > 2 * 1024 * 1024 {
+            return Err(Status::Unsupported);
+        }
+        bytes.extend_from_slice(&chunk);
+    }
+    let value = serde_json::from_slice(&bytes).map_err(|_| Status::Unsupported)?;
+    classify(&value, &content, &r.version)
+}
+pub async fn query(r: Request, tokens: Arc<TokenManager>) -> Result<Outcome, Status> {
+    let mut workers = tokio::task::JoinSet::new();
+    workers.spawn(async move { observe(&r, &tokens).await });
+    match tokio::time::timeout(Duration::from_secs(35), workers.join_next()).await {
+        Ok(Some(Ok(result))) => result,
+        Ok(_) => Err(Status::Error),
+        Err(_) => {
+            workers.abort_all();
+            while workers.join_next().await.is_some() {}
+            Err(Status::Timeout)
+        }
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    const ID: &str = "11111111-2222-4333-8444-555555555555";
+    fn request() -> Request {
+        Request {
+            context: "a".repeat(64),
+            store_id: "GAME1234EFGH".into(),
+            package_family_name: "Test.Game_publisher".into(),
+            market: "AT".into(),
+            version: "1.2.3.4".into(),
+            scope: "FlightdeckBaseGameOnlyV1".into(),
+        }
+    }
+    fn package() -> Value {
+        let revision = format!("1.2.3.4.{ID}");
+        json!({"PackageFound":true,"ContentId":ID,"Version":revision,"VersionId":revision,"UpdatePredownload":false,"PackageFiles":[{"FileName":"game.msixvc","FileSize":4096,"ContentId":ID,"VersionId":revision,"KeyBlob":"PRIVATE_KEY","RelativeUrl":"PRIVATE_URL"}]})
+    }
+    #[test]
+    fn revisions_are_compared_without_guessing_update_policy() {
+        let p = package();
+        assert_eq!(classify(&p, ID, "1.2.3.4").unwrap(), Outcome::Current);
+        for s in ["1.2.3.3", "1.2.3.5"] {
+            assert_eq!(classify(&p, ID, s).unwrap(), Outcome::DifferentRevision);
+        }
+    }
+    #[test]
+    fn malformed_or_unavailable_is_never_current() {
+        for (key, value) in [
+            ("PackageFound", json!(false)),
+            ("ContentId", json!("other")),
+            ("UpdatePredownload", json!(true)),
+            ("VersionId", json!(ID)),
+            ("Version", json!("1.2")),
+            ("PackageFiles", json!([])),
+        ] {
+            let mut p = package();
+            p[key] = value;
+            assert!(classify(&p, ID, "1.2.3.4").is_err());
+        }
+        for (key, value) in [
+            ("FileSize", json!(0)),
+            ("VersionId", json!(ID)),
+            ("ContentId", json!("other")),
+        ] {
+            let mut p = package();
+            p["PackageFiles"][0][key] = value;
+            assert!(classify(&p, ID, "1.2.3.4").is_err());
+        }
+    }
+    #[test]
+    fn scope_and_xml_are_strict() {
+        let r = request();
+        let xml = format!(
+            "<StorePackageUpdatesRequest><Context>{}</Context><StoreId>{}</StoreId><PackageFamilyName>{}</PackageFamilyName><Market>AT</Market><Version>1.2.3.4</Version><Scope>FlightdeckBaseGameOnlyV1</Scope></StorePackageUpdatesRequest>",
+            r.context, r.store_id, r.package_family_name
+        );
+        assert!(parse_request(xml.as_bytes()).is_ok());
+        for bad in [
+            xml.replace("FlightdeckBaseGameOnlyV1", "all"),
+            xml.replace("1.2.3.4", "65536.2.3.4"),
+            xml.replace("</Version>", "</Version><Version>1.2.3.4</Version>"),
+            format!("<!DOCTYPE x>{xml}"),
+            format!("{xml}{xml}"),
+            xml.replace("<Market>", "<Market value='x'>"),
+        ] {
+            assert!(parse_request(bad.as_bytes()).is_err());
+        }
+    }
+    #[test]
+    fn no_package_secrets_in_result() {
+        assert_eq!(
+            String::from_utf8(encode(Ok(Outcome::Current))).unwrap(),
+            "<StorePackageUpdatesResponse><Status>Current</Status></StorePackageUpdatesResponse>"
+        );
+        assert!(
+            !String::from_utf8(encode(Err(Status::Error)))
+                .unwrap()
+                .contains("PRIVATE")
+        );
+    }
+    #[test]
+    fn exact_pc_package_required() {
+        let r = request();
+        let package = json!({"PackageFamilyName":r.package_family_name,"PackageFormat":"MSIXVC","ContentId":ID,"PlatformDependencies":[{"PlatformName":"Windows.Desktop"}]});
+        let mut c = json!({"Product":{"ProductId":r.store_id,"ProductKind":"Game","DisplaySkuAvailabilities":[{"Sku":{"SkuType":"full","Properties":{"IsTrial":false,"IsPreOrder":false,"IsBundle":false,"Packages":[package]}}}]}});
+        assert_eq!(content_id(&c, &r).unwrap(), ID);
+        c["Product"]["DisplaySkuAvailabilities"][0]["Sku"]["Properties"]["Packages"][0]["PackageFamilyName"] =
+            json!("Wrong_family");
+        assert!(content_id(&c, &r).is_err());
+    }
+}
diff --git c/crates/xodus-service/src/store_purchase.rs w/crates/xodus-service/src/store_purchase.rs
new file mode 100644
--- /dev/null
+++ w/crates/xodus-service/src/store_purchase.rs
