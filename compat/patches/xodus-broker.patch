+            mut self: std::pin::Pin<&mut Self>,
+            _: &mut std::task::Context<'_>,
+        ) -> std::task::Poll<io::Result<u64>> {
+            std::task::Poll::Ready(std::io::Seek::stream_position(&mut self.file))
+        }
+    }
