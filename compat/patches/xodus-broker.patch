+use super::*;
+use binrw::BinWrite;
+use std::io::Write;
+
+// Exercise the three XML readers through actual package headers and footers.
+// Unknown attributes model the previously quadratic quick-xml input without
+// putting wall-clock thresholds in the regression suite.
+fn package(bundle: bool, attributes: usize) -> Cursor<Vec<u8>> {
+    let attrs: String = (0..attributes).map(|n| format!(" a{n}=\"x\"")).collect();
+    let identity = "<Identity Name=\"Fixture\" Publisher=\"CN=A&amp;B\" Version=\"1.2.3.4\"/>";
+    let (name, manifest) = if bundle {
+        (
+            "AppxMetadata\\AppxBundleManifest.xml",
+            format!("<Bundle SchemaVersion=\"5.0\"{attrs}>{identity}<Packages><Package Type=\"application\" Version=\"1.2.3.4\" FileName=\"a&amp;b.msix\" Offset=\"0\" Size=\"7\"/></Packages></Bundle>"),
+        )
+    } else {
+        (
+            "AppxManifest.xml",
+            format!("<Package{attrs}>{identity}</Package>"),
+        )
+    };
+    let blockmap = format!("<b2:BlockMap HashMethod=\"sha256\"{attrs}><b2:File Name=\"{name}\" Id=\"0\" Size=\"{}\" Encrypted=\"false\"/></b2:BlockMap>", manifest.len());
+    let mut empty = vec![0; 256];
+    empty[..4].copy_from_slice(b"EXPH");
+    let mut header = EAppxHeader::read(&mut Cursor::new(empty)).unwrap();
+    if bundle {
+        header.magic = EAppxMagic::EXBH;
+    }
+    header.block_map_file_id = 1;
+    header.block_map_hash = Sha256::digest(blockmap.as_bytes()).to_vec();
+    header.file_count = 2;
+    header.footer_length = 80;
+    let mut stream = Cursor::new(Vec::new());
+    header.write(&mut stream).unwrap();
+    header.header_size = stream.position().try_into().unwrap();
+    header.footer_offset = stream.position() + blockmap.len() as u64 + manifest.len() as u64;
+    stream.set_position(0);
+    header.write(&mut stream).unwrap();
+    let block_offset = stream.position();
+    stream.write_all(blockmap.as_bytes()).unwrap();
+    let manifest_offset = stream.position();
+    stream.write_all(manifest.as_bytes()).unwrap();
+    for (file_id, offset, length) in [
+        (0, manifest_offset, manifest.len()),
+        (1, block_offset, blockmap.len()),
+    ] {
+        EAppxFooter {
+            magic: 0x4645,
+            footer_size: 40,
+            key_id_index: 0xffff,
+            compression_type: 0,
+            file_id,
+            offset_to_file: offset,
+            uncompressed_length: length as u64,
+            compressed_length: length as u64,
+        }
+        .write(&mut stream)
+        .unwrap();
+    }
+    stream.set_position(0);
+    stream
+}
+
+#[test]
+fn all_package_xml_readers_preserve_fields_with_large_attribute_sets() {
+    for attributes in [0, 16_000] {
+        for bundle in [false, true] {
+            let mut stream = package(bundle, attributes);
+            let package = EAppxFile::from_stream(&mut stream).unwrap();
+            assert_eq!(package.blockmap.files.len(), 1);
+            let manifest = package.read_manifest(&mut stream).unwrap();
+            assert_eq!(manifest.get_name(), "Fixture");
+            assert_eq!(manifest.get_publisher(), "CN=A&B");
+            if let Manifest::BundleManifest(manifest) = manifest {
+                assert_eq!(manifest.packages.package[0].filename, "a&b.msix");
+                assert_eq!(manifest.packages.package[0].size, 7);
+            } else {
+                assert!(!bundle);
+            }
+        }
+    }
+}
