@@ -4,0 +5,152 @@ use crate::models::xbox::{
+#[derive(Clone, Copy, Debug)]
+pub(super) enum AuthStage {
+    Microsoft,
+    XboxUser,
+    Device,
+    Sisu,
+    Xsts,
+}
+
+/// Only fixed categories and bounded server codes are retained. Never attach
+/// reqwest errors, SOAP faults, response bodies, tickets or token responses.
+#[derive(Debug)]
+pub struct AuthFailure {
+    stage: AuthStage,
+    reason: &'static str,
+    status: Option<u16>,
+    xbox_code: Option<String>,
+}
+
+impl AuthFailure {
+    pub(super) fn at(stage: AuthStage, reason: &'static str) -> Self {
+        Self {
+            stage,
+            reason,
+            status: None,
+            xbox_code: None,
+        }
+    }
+
+    pub(super) fn from_xal(stage: AuthStage, error: xal::Error) -> Self {
+        match error {
+            xal::Error::JsonHttpResponseError {
+                status, headers, ..
+            } => {
+                let code = headers
+                    .get("x-err")
+                    .and_then(|v| v.to_str().ok())
+                    .filter(|v| valid_xbox_code(v))
+                    .map(str::to_owned);
+                Self {
+                    stage,
+                    reason: if status.is_success() {
+                        "invalid token response"
+                    } else {
+                        "HTTP request rejected"
+                    },
+                    status: Some(status.as_u16()),
+                    xbox_code: code,
+                }
+            }
+            xal::Error::ReqwestError(error) if error.is_timeout() => {
+                Self::at(stage, "request timed out")
+            }
+            _ => Self::at(stage, "request failed"),
+        }
+    }
+    pub(super) fn invalid(stage: AuthStage) -> Self {
+        Self {
+            stage,
+            reason: "invalid token response",
+            status: None,
+            xbox_code: None,
+        }
+    }
+
+    pub fn missing_credentials() -> Self {
+        Self {
+            stage: AuthStage::Microsoft,
+            reason: "sign-in credentials unavailable",
+            status: None,
+            xbox_code: None,
+        }
+    }
+
+    pub(super) fn exchange() -> Self {
+        Self {
+            stage: AuthStage::Microsoft,
+            reason: "token exchange failed",
+            status: None,
+            xbox_code: None,
+        }
+    }
+}
+
+impl std::fmt::Display for AuthFailure {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        let stage = match self.stage {
+            AuthStage::Microsoft => "Microsoft token exchange",
+            AuthStage::XboxUser => "Xbox user authentication",
+            AuthStage::Device => "Xbox device authentication",
+            AuthStage::Sisu => "Xbox sign-in",
+            AuthStage::Xsts => "Xbox XSTS authorization",
+        };
+        write!(f, "{stage} failed: {}", self.reason)?;
+        if let Some(status) = self.status {
+            write!(f, "; HTTP {status}")?;
+        }
+        if let Some(code) = &self.xbox_code {
+            write!(f, "; X-Err {code}")?;
+        }
+        Ok(())
+    }
+}
+impl std::error::Error for AuthFailure {}
+
+fn xbox_code(headers: &reqwest::header::HeaderMap) -> Option<String> {
+    let value = headers.get("x-err")?.to_str().ok()?;
+    valid_xbox_code(value).then(|| value.to_owned())
+}
+fn valid_xbox_code(value: &str) -> bool {
+    let digits = value
+        .strip_prefix("0x")
+        .or_else(|| value.strip_prefix("0X"))
+        .unwrap_or(value);
+    !digits.is_empty() && value.len() <= 10 && digits.bytes().all(|b| b.is_ascii_hexdigit())
+}
+
+async fn checked_response(
+    stage: AuthStage,
+    response: reqwest::Result<reqwest::Response>,
+) -> Result<XstsResponse, AuthFailure> {
+    let response = response.map_err(|error| AuthFailure {
+        stage,
+        reason: if error.is_timeout() {
+            "request timed out"
+        } else {
+            "request failed"
+        },
+        status: None,
+        xbox_code: None,
+    })?;
+    let status = response.status();
+    let failure = AuthFailure {
+        stage,
+        reason: if status.is_success() {
+            "invalid token response"
+        } else {
+            "HTTP request rejected"
+        },
+        status: Some(status.as_u16()),
+        xbox_code: xbox_code(response.headers()),
+    };
+    if !status.is_success() {
+        return Err(failure);
+    }
+    let token: XstsResponse = response.json().await.map_err(|_| failure)?;
+    if token.token.is_empty() || token.not_after <= chrono::Utc::now() {
+        return Err(AuthFailure::invalid(stage));
+    }
+    Ok(token)
+}
