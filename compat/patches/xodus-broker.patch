@@ -0,0 +1,318 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! Windows SISU for authenticated package downloads. No account switches,
+//! persistent credential writes, new device identities or device-only fallback.
+use super::auth::{AuthFailure, AuthStage};
+use crate::models::{
+    live::ExchangeUserTokenOutcome, secrets::LegacyToken, soap, xbox::XstsResponse,
+};
+use xal::{DeviceType, XalAppParameters, XalAuthenticator, XalClientParameters};
+
+// Same application as Xodus' interactive sign-in and existing Xbox app flow.
+const APP: &str = "000000004424da1f";
+const TITLE: &str = "704208617";
+const DEVICE_SCOPE: &str = "scope=service::user.auth.xboxlive.com::MBI_SSL&api-version=2.0";
+const USER_SCOPE: &str = "scope=xboxlive.signin&api-version=2.0&clientid=000000004424da1f";
+const MAX_TICKET: usize = 1024 * 1024;
+
+fn fresh(time: chrono::DateTime<chrono::Utc>) -> bool {
+    time.timestamp() > chrono::Utc::now().timestamp() + 60
+}
+
+fn compact(body: soap::BodyContent, audience: &str) -> Result<String, AuthFailure> {
+    let invalid = || AuthFailure::invalid(AuthStage::Microsoft);
+    let responses = match body {
+        soap::BodyContent::RequestSecurityTokenResponse(r) => vec![*r],
+        soap::BodyContent::RequestSecurityTokenResponseCollection(c) if c.challenges.is_empty() => {
+            c.security_tokens
+        }
+        _ => return Err(invalid()),
+    };
+    // Match the requested audience, never the order of an RSTR collection.
+    let mut matching = responses
+        .into_iter()
+        .filter(|r| r.applies_to.endpoint_reference.address == audience);
+    let reply = matching.next().ok_or_else(invalid)?;
+    if matching.next().is_some()
+        || !chrono::DateTime::parse_from_rfc3339(&reply.lifetime.expires)
+            .is_ok_and(|t| fresh(t.to_utc()))
+        || reply.requested_security_token.encrypted_data.is_some()
+    {
+        return Err(invalid());
+    }
+    let ticket = reply
+        .requested_security_token
+        .binary_security_token
+        .ok_or_else(invalid)?
+        .value;
+    if ticket.is_empty() || ticket.len() > MAX_TICKET {
+        return Err(invalid());
+    }
+    match reply.token_type.as_str() {
+        "urn:passport:compact" => Ok(ticket),
+        "urn:passport:delegationcompact" => Ok(format!("d={ticket}")),
+        _ => Err(invalid()),
+    }
+}
+
+fn issued(outcome: ExchangeUserTokenOutcome) -> Result<String, AuthFailure> {
+    match outcome {
+        ExchangeUserTokenOutcome::Issued(body) => compact(body, USER_SCOPE),
+        ExchangeUserTokenOutcome::Fault(_) => Err(AuthFailure::exchange()),
+    }
+}
+
+fn user_hash(claims: Option<&xal::response::XAUDisplayClaims>) -> Option<&str> {
+    let users = &claims?.xui;
+    if users.len() != 1 {
+        return None;
+    }
+    users[0]
+        .get("uhs")
+        .map(String::as_str)
+        .filter(|s| valid_hash(s))
+}
+fn valid_hash(value: &str) -> bool {
+    !value.is_empty() && value.len() <= 64 && value.bytes().all(|b| b.is_ascii_digit())
+}
+
+fn project(
+    token: xal::response::XSTSToken,
+    expected_user_hash: &str,
+) -> Result<XstsResponse, AuthFailure> {
+    let invalid = || AuthFailure::invalid(AuthStage::Xsts);
+    if token.token.is_empty() || !fresh(token.not_after) || !valid_hash(expected_user_hash) {
+        return Err(invalid());
+    }
+    let users = &token.display_claims.as_ref().ok_or_else(invalid)?.xui;
+    if users.len() != 1 || users[0].get("uhs").map(String::as_str) != Some(expected_user_hash) {
+        return Err(invalid());
+    }
+    Ok(XstsResponse::authenticated_user(
+        token.not_after,
+        token.token,
+        expected_user_hash.to_owned(),
+    ))
+}
+
+pub(super) async fn authorize(
+    client: &reqwest::Client,
+    device: LegacyToken,
+    user: LegacyToken,
+    relying_party: &str,
+) -> Result<XstsResponse, AuthFailure> {
+    let device_reply = crate::api::live::exchange_device_token(
+        client,
+        device.clone(),
+        "{28C08266-F973-4AE6-FFE4-409B249F138F}".into(),
+        DEVICE_SCOPE.into(),
+        Some(soap::PolicyReference::token_broker()),
+    )
+    .await
+    .map_err(|_| AuthFailure::at(AuthStage::Microsoft, "device ticket exchange failed"))?;
+    let device_rps = compact(
+        soap::BodyContent::RequestSecurityTokenResponse(Box::new(device_reply)),
+        DEVICE_SCOPE,
+    )?;
+    let user_reply = crate::api::live::exchange_user_token(
+        client,
+        user,
+        "USERNAME".into(),
+        device,
+        None,
+        Some("Silent".into()),
+        APP.into(),
+        &[(
+            USER_SCOPE.into(),
+            Some(soap::PolicyReference::token_broker()),
+        )],
+    )
+    .await
+    .map_err(|_| AuthFailure::at(AuthStage::Microsoft, "user ticket exchange failed"))?;
+    let user_rps = issued(user_reply)?;
+    let mut auth = XalAuthenticator::new(
+        XalAppParameters {
+            client_id: APP.into(),
+            title_id: Some(TITLE.into()),
+            auth_scopes: vec![],
+            redirect_uri: None,
+            client_secret: None,
+        },
+        XalClientParameters {
+            user_agent: "XAL GRTS 2025.11.20251105.000".into(),
+            device_type: DeviceType::WIN32,
+            client_version: "10.0.22621".into(),
+            query_display: String::new(),
+        },
+        "RETAIL".into(),
+    );
+    let device = auth
+        .get_device_token_rps(device_rps)
+        .await
+        .map_err(|e| AuthFailure::from_xal(AuthStage::Device, e))?;
+    if device.token.is_empty() || !fresh(device.not_after) {
+        return Err(AuthFailure::invalid(AuthStage::Device));
+    }
+    let sisu = auth
+        .sisu_authorize_rps(&user_rps, &device.token, None)
+        .await
+        .map_err(|e| AuthFailure::from_xal(AuthStage::Sisu, e))?;
+    if sisu.user_token.token.is_empty()
+        || !fresh(sisu.user_token.not_after)
+        || sisu.title_token.token.is_empty()
+        || !fresh(sisu.title_token.not_after)
+        || sisu.title_token.display_claims.as_ref().and_then(|c| c.xti.get("tid")).map(String::as_str) != Some(TITLE)
+    {
+        return Err(AuthFailure::invalid(AuthStage::Sisu));
+    }
+    let expected = user_hash(sisu.user_token.display_claims.as_ref())
+        .ok_or_else(|| AuthFailure::invalid(AuthStage::Sisu))?;
+    // All three tokens and the same proof key are required. Never retry with
+    // only a device token when user authorization or game ownership fails.
+    let token = auth
+        .get_xsts_token(
+            Some(&device),
+            Some(&sisu.title_token),
+            Some(&sisu.user_token),
+            relying_party,
+        )
+        .await
+        .map_err(|e| AuthFailure::from_xal(AuthStage::Xsts, e))?;
+    project(token, expected)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn reply(audience: &str, kind: &str, value: &str) -> soap::RequestSecurityTokenResponse {
+        soap::RequestSecurityTokenResponse {
+            token_type: kind.into(),
+            applies_to: soap::AppliesTo {
+                endpoint_reference: soap::EndpointReference {
+                    address: audience.into(),
+                },
+            },
+            lifetime: soap::Timestamp {
+                id: None,
+                created: "2026-01-01T00:00:00Z".into(),
+                expires: "2099-01-01T00:00:00Z".into(),
+            },
+            requested_security_token: soap::RequestedSecurityToken {
+                encrypted_data: None,
+                binary_security_token: Some(soap::BinarySecurityTokenRes {
+                    id: "fixture".into(),
+                    value: value.into(),
+                    value_type: None,
+                }),
+            },
+            requested_proof_token: None,
+        }
+    }
+    fn collection(replies: Vec<soap::RequestSecurityTokenResponse>) -> soap::BodyContent {
+        soap::BodyContent::RequestSecurityTokenResponseCollection(
+            soap::RequestSecurityTokenResponseCollection {
+                security_tokens: replies,
+                challenges: vec![],
+            },
+        )
+    }
+    #[test]
+    fn requested_audience_is_selected_by_identity_and_prefix_follows_token_type() {
+        let intended = reply(
+            USER_SCOPE,
+            "urn:passport:delegationcompact",
+            "PRIVATE_TICKET",
+        );
+        let other = reply(DEVICE_SCOPE, "urn:passport:compact", "OTHER_TICKET");
+        for replies in [vec![intended.clone(), other.clone()], vec![other, intended]] {
+            assert_eq!(
+                compact(collection(replies), USER_SCOPE).unwrap(),
+                "d=PRIVATE_TICKET"
+            );
+        }
+        assert_eq!(
+            compact(
+                collection(vec![reply(
+                    DEVICE_SCOPE,
+                    "urn:passport:compact",
+                    "t=PRIVATE_TICKET"
+                )]),
+                DEVICE_SCOPE
+            )
+            .unwrap(),
+            "t=PRIVATE_TICKET"
+        );
+    }
+    #[test]
+    fn wrong_duplicate_or_missing_audiences_do_not_become_credentials() {
+        let expected = reply(USER_SCOPE, "urn:passport:compact", "PRIVATE_TICKET");
+        for replies in [
+            vec![],
+            vec![reply(
+                DEVICE_SCOPE,
+                "urn:passport:compact",
+                "PRIVATE_TICKET",
+            )],
+            vec![expected.clone(), expected],
+        ] {
+            let error = compact(collection(replies), USER_SCOPE).unwrap_err();
+            assert!(!format!("{error:?} {error}").contains("PRIVATE"));
+        }
+        assert!(issued(ExchangeUserTokenOutcome::Fault(None)).is_err());
+    }
+    #[test]
+    fn malformed_expired_empty_and_unexpected_ticket_types_return_errors() {
+        let valid = reply(USER_SCOPE, "urn:passport:compact", "PRIVATE_TICKET");
+        let mut cases = vec![
+            reply(USER_SCOPE, "unknown", "PRIVATE_TICKET"),
+            reply(USER_SCOPE, "urn:passport:compact", ""),
+        ];
+        let mut expired = valid.clone();
+        expired.lifetime.expires = "2000-01-01T00:00:00Z".into();
+        cases.push(expired);
+        let mut invalid = valid.clone();
+        invalid.lifetime.expires = "bad-time".into();
+        cases.push(invalid);
+        let mut missing = valid;
+        missing.requested_security_token.binary_security_token = None;
+        cases.push(missing);
+        for bad in cases {
+            assert!(compact(collection(vec![bad]), USER_SCOPE).is_err());
+        }
+    }
+    fn xsts(users: serde_json::Value) -> xal::response::XSTSToken {
+        serde_json::from_value(serde_json::json!({"IssueInstant":"2026-01-01T00:00:00Z","NotAfter":"2099-01-01T00:00:00Z",
+            "Token":"PRIVATE_XSTS","DisplayClaims":{"xui":users}})).unwrap()
+    }
+    #[test]
+    fn xsts_requires_one_matching_user_and_rejects_device_only_tokens() {
+        for users in [
+            serde_json::json!([]),
+            serde_json::json!([{"uhs":"456"}]),
+            serde_json::json!([{"uhs":"123"},{"uhs":"456"}]),
+            serde_json::json!([{}]),
+        ] {
+            let error = project(xsts(users), "123").unwrap_err();
+            assert!(!format!("{error:?} {error}").contains("PRIVATE"));
+        }
+        let mut device_only = xsts(serde_json::json!([]));
+        device_only.display_claims = None;
+        assert!(project(device_only, "123").is_err());
+        let mut expired = xsts(serde_json::json!([{"uhs":"123"}]));
+        expired.not_after = chrono::Utc::now();
+        assert!(project(expired, "123").is_err());
+        assert!(project(xsts(serde_json::json!([{"uhs":"PRIVATE"}])), "PRIVATE").is_err());
+    }
+    #[test]
+    fn authenticated_user_projection_preserves_the_account_for_package_access() {
+        let token = project(
+            xsts(serde_json::json!([{"uhs":"123","gtg":"PRIVATE_GAMERTAG"}])),
+            "123",
+        )
+        .unwrap();
+        assert_eq!(token.user_hash(), Some("123"));
+        assert_eq!(
+            super::super::get_xsts_auth_header(token).unwrap(),
+            "XBL3.0 x=123;PRIVATE_XSTS"
+        );
+    }
+}
