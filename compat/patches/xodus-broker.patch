+/// Manual extraction keeps its ordinary destination permissions and overwrite
+/// behavior without adopting resume receipts or an authenticated package ID.
+pub struct Output {
+    root: File,
+    cache_identity: std::sync::OnceLock<(u64, u64)>,
+}
+impl Output {
+    pub fn open(root: &Path) -> io::Result<Self> {
+        use std::os::unix::fs::OpenOptionsExt;
+        // A caller-selected root symlink is allowed, then anchored exactly once.
+        let root = File::options()
+            .read(true)
+            .custom_flags(libc::O_PATH | libc::O_DIRECTORY | libc::O_CLOEXEC)
+            .open(root)?;
+        Ok(Self {
+            root,
+            cache_identity: std::sync::OnceLock::new(),
+        })
+    }
+    pub fn root_path(&self) -> std::path::PathBuf {
+        format!("/proc/self/fd/{}", self.root.as_raw_fd()).into()
+    }
+    pub fn begin(&self, name: &str) -> io::Result<File> {
+        let (dir, leaf) = target_parent(&self.root, name, true, Creation::Ordinary)?;
+        // Never O_TRUNC: open_at must reject hardlinks and special files before
+        // any mutation of an existing target.
+        let file = open_at_mode(&dir, &leaf, libc::O_WRONLY | libc::O_CREAT, 0o666)?;
+        file.set_len(0)?;
+        Ok(file)
+    }
+    pub fn prepare_cache(&self) -> io::Result<(File, File)> {
+        prepare_cache(&self.root, &self.cache_identity, Creation::Ordinary)
+    }
+    pub fn previous_cache(&self) -> io::Result<Option<File>> {
+        match open_at(&self.root, ".xodus-streaming.msixvc", libc::O_RDONLY) {
+            Ok(file) => Ok(Some(file)),
+            Err(e)
+                if matches!(
+                    e.kind(),
+                    io::ErrorKind::NotFound | io::ErrorKind::PermissionDenied
+                ) =>
+            {
+                Ok(None)
+            }
+            Err(e) => Err(e),
+        }
+    }
+    pub fn finish(&self) -> io::Result<()> {
+        finish_cache(&self.root, &self.cache_identity, Creation::Ordinary)
+    }
+}
