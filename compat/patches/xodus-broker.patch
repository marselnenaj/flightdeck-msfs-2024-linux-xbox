+    #[test] fn invalid_xml_never_starts_ui() {
+        for request in [b"<Other/>".as_slice(), b"<!DOCTYPE x><StorePurchaseRequest/>", b"<StorePurchaseRequest/>\0\0"] { assert!(parse(request).is_err()); }
+    }
