+/// Stable, credential-free category for launchers. 77 remains reserved for the
+/// existing expired-session check; a rejected Xbox exchange must not relogin in a loop.
+pub fn package_error_exit_code(
+    error: &(dyn std::error::Error + 'static),
+) -> std::process::ExitCode {
+    if error.is::<xodus::api::xbox::AuthFailure>() {
+        std::process::ExitCode::from(94)
