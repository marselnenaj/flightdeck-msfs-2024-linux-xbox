--- /dev/null
+++ w/crates/xodus/src/licensing/content/tests.rs
@@ -0,0 +1,160 @@
+use super::*;
+use std::io::{Read, Write};
+use std::net::TcpListener;
+use std::time::Duration;
+
+fn fixture(status: u16, body: String) -> (String, std::thread::JoinHandle<String>) {
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let url = format!("http://{}/licenses/content", listener.local_addr().unwrap());
+    let thread = std::thread::spawn(move || {
+        let (mut socket, _) = listener.accept().unwrap();
+        socket
+            .set_read_timeout(Some(Duration::from_secs(5)))
+            .unwrap();
+        let mut request = Vec::new();
+        while !request.ends_with(b"\r\n\r\n") {
+            let mut b = [0];
+            socket.read_exact(&mut b).unwrap();
+            request.extend(b);
+            assert!(request.len() < 16384);
+        }
+        let start = request.len();
+        let head = String::from_utf8(request.clone())
+            .unwrap()
+            .to_ascii_lowercase();
+        let length: usize = head
+            .lines()
+            .find_map(|s| s.strip_prefix("content-length:"))
+            .unwrap()
+            .trim()
+            .parse()
+            .unwrap();
+        assert!(length < 16384);
+        request.resize(start + length, 0);
+        socket.read_exact(&mut request[start..]).unwrap();
+        write!(socket, "HTTP/1.1 {status} Fixture\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}", body.len()).unwrap();
+        String::from_utf8(request).unwrap()
+    });
+    (url, thread)
+}
+
+async fn request(
+    status: u16,
+    body: String,
+    ticket: &str,
+) -> (
+    Result<(LicenseContent, License), LicenseContentError>,
+    String,
+) {
+    let (endpoint, captured) = fixture(status, body);
+    let client = reqwest::Client::builder()
+        .no_proxy()
+        .timeout(Duration::from_secs(5))
+        .build()
+        .unwrap();
+    let response = get_license_content_at(
+        &client,
+        &endpoint,
+        "d=PRIVATE_DEVICE".into(),
+        ticket.into(),
+        "PRIVATE_PUID".into(),
+        "content-fixture".into(),
+        "US".into(),
+    )
+    .await;
+    (response, captured.join().unwrap())
+}
+
+fn success(key: &str) -> String {
+    serde_json::json!({"license":{"keys":[{"value":key}],"leases":[]}}).to_string()
+}
+
+#[tokio::test]
+async fn wire_identity_strips_delegation_marker_and_preserves_device_header_and_bare_ticket() {
+    let xml = r#"<License><SPLicenseBlock>fixture</SPLicenseBlock><LicenseInfo Type="Full"/><Binding Binding_Type="Device"/></License>"#;
+    for ticket in ["PRIVATE_USER", "d=PRIVATE_USER"] {
+        let (response, captured) =
+            request(200, success(&BASE64_STANDARD.encode(xml)), ticket).await;
+        assert_eq!(response.unwrap().1.splicense_block, "fixture");
+        let (headers, body) = captured.split_once("\r\n\r\n").unwrap();
+        assert!(
+            headers
+                .to_ascii_lowercase()
+                .contains("authorization: d=private_device\r\n")
+        );
+        let body: serde_json::Value = serde_json::from_str(body).unwrap();
+        let user = &body["users"].as_object().unwrap().values().next().unwrap()[0];
+        assert_eq!(user["identityType"], "Msa");
+        assert_eq!(user["identityValue"], "PRIVATE_USER");
+        assert_eq!(user["localTicketReference"], "PRIVATE_PUID");
+    }
+    // Do not strip unrelated prefixes or mutate stored ticket representations.
+    assert_eq!(
+        LicenseUserIdentity::msa("t=PRIVATE".into(), "ref".into()).identity_value,
+        "t=PRIVATE"
+    );
+    assert_eq!(
+        LicenseUserIdentity::msa("PRIVATE_d=body".into(), "ref".into()).identity_value,
+        "PRIVATE_d=body"
+    );
+}
+
+#[tokio::test]
+async fn invalid_msa_ticket_fault_is_reported_without_body_or_credentials() {
+    for status in [200, 400] {
+        let (result, _) = request(
+            status,
+            r#"{"code":"InvalidMsaTicketFormat","faultcode":4003,"detail":"PRIVATE_BODY"}"#.into(),
+            "d=PRIVATE_USER",
+        )
+        .await;
+        let error = result.unwrap_err();
+        assert!(matches!(
+            error,
+            LicenseContentError::Rejected {
+                faultcode: 4003,
+                ..
+            }
+        ));
+        let message = format!("{error} {error:?}");
+        assert!(message.contains("4003"));
+        assert!(!message.contains("PRIVATE"));
+    }
+}
+
+#[tokio::test]
+async fn malformed_missing_keys_and_non_success_licenses_return_errors_without_panics() {
+    for body in [
+        "PRIVATE_BODY".into(),
+        r#"{"license":{"keys":[],"leases":[]}}"#.into(),
+        success("not base64"),
+        success(&BASE64_STANDARD.encode([0xff])),
+        success(&BASE64_STANDARD.encode("PRIVATE_XML")),
+    ] {
+        let (result, _) = request(200, body, "d=PRIVATE_USER").await;
+        let error = result.unwrap_err();
+        assert!(matches!(
+            error,
+            LicenseContentError::InvalidResponse { status: 200 }
+        ));
+        assert!(!format!("{error} {error:?}").contains("PRIVATE"));
+    }
+    let (result, _) = request(403, success("fixture"), "PRIVATE_USER").await;
+    assert!(matches!(
+        result,
+        Err(LicenseContentError::InvalidResponse { status: 403 })
+    ));
+}
+
+#[tokio::test]
+async fn entitlement_denial_is_not_treated_as_a_license_or_auth_retry() {
+    let (result, _) = request(
+        200,
+        r#"{"satisfactionFailure":{"code":1,"description":"PRIVATE_BODY"}}"#.into(),
+        "PRIVATE_USER",
+    )
+    .await;
+    let error = result.unwrap_err();
+    assert!(matches!(error, LicenseContentError::NotEntitled));
+    assert!(!format!("{error} {error:?}").contains("PRIVATE"));
+}
