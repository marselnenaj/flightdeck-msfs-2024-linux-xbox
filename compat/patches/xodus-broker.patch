+// Select the licensing audience explicitly. Never use an unrelated first RSTR,
+// a challenge response, or the Xbox SISU/XSTS token as an MSA identity.
+fn licensing_ticket(body: soap::BodyContent) -> Result<String, String> {
+    let invalid = || "Invalid Microsoft licensing ticket response".to_owned();
+    let replies = match body {
+        soap::BodyContent::RequestSecurityTokenResponse(reply) => vec![*reply],
+        soap::BodyContent::RequestSecurityTokenResponseCollection(c) if c.challenges.is_empty() => {
+            c.security_tokens
+        }
+        _ => return Err(invalid()),
+    };
+    let mut matching = replies
+        .into_iter()
+        .filter(|r| r.applies_to.endpoint_reference.address == "www.microsoft.com");
+    let reply = matching.next().ok_or_else(invalid)?;
+    if matching.next().is_some()
+        || !matches!(
+            reply.token_type.as_str(),
+            "urn:passport:compact" | "urn:passport:delegationcompact"
+        )
+        || reply.requested_security_token.encrypted_data.is_some()
+        || !chrono::DateTime::parse_from_rfc3339(&reply.lifetime.expires)
+            .is_ok_and(|t| t.timestamp() > chrono::Utc::now().timestamp() + 60)
+    {
+        return Err(invalid());
+    }
+    let value = reply
+        .requested_security_token
+        .binary_security_token
+        .ok_or_else(invalid)?
+        .value;
+    if value.is_empty() || value.len() > 1024 * 1024 {
+        return Err(invalid());
+    }
+    // Preserve token representation here. The licensing identity constructor
+    // removes the marker only from the user identity, never the device header.
+    Ok(if reply.token_type == "urn:passport:delegationcompact" {
+        format!("d={value}")
+    } else {
+        value
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn reply(audience: &str, kind: &str) -> soap::RequestSecurityTokenResponse {
+        soap::RequestSecurityTokenResponse {
+            token_type: kind.into(),
+            applies_to: soap::AppliesTo {
+                endpoint_reference: soap::EndpointReference {
+                    address: audience.into(),
+                },
+            },
+            lifetime: soap::Timestamp {
+                id: None,
+                created: "2026-01-01T00:00:00Z".into(),
+                expires: "2099-01-01T00:00:00Z".into(),
+            },
+            requested_security_token: soap::RequestedSecurityToken {
+                encrypted_data: None,
+                binary_security_token: Some(soap::BinarySecurityTokenRes {
+                    id: "fixture".into(),
+                    value: "PRIVATE_TICKET".into(),
+                    value_type: None,
+                }),
+            },
+            requested_proof_token: None,
+        }
+    }
+    fn collection(replies: Vec<soap::RequestSecurityTokenResponse>) -> soap::BodyContent {
+        soap::BodyContent::RequestSecurityTokenResponseCollection(
+            soap::RequestSecurityTokenResponseCollection {
+                security_tokens: replies,
+                challenges: vec![],
+            },
+        )
+    }
+    #[test]
+    fn selects_licensing_audience_without_repurposing_xbox_tokens() {
+        let target = reply("www.microsoft.com", "urn:passport:delegationcompact");
+        let unrelated = reply("user.auth.xboxlive.com", "urn:passport:compact");
+        for replies in [
+            vec![target.clone(), unrelated.clone()],
+            vec![unrelated, target],
+        ] {
+            assert_eq!(
+                licensing_ticket(collection(replies)).unwrap(),
+                "d=PRIVATE_TICKET"
+            );
+        }
+        assert_eq!(
+            licensing_ticket(collection(vec![reply(
+                "www.microsoft.com",
+                "urn:passport:compact"
+            )]))
+            .unwrap(),
+            "PRIVATE_TICKET"
+        );
+    }
+    #[test]
+    fn invalid_ticket_replies_fail_without_panic_or_private_values() {
+        let valid = reply("www.microsoft.com", "urn:passport:compact");
+        let mut expired = valid.clone();
+        expired.lifetime.expires = "2000-01-01T00:00:00Z".into();
+        let mut missing = valid.clone();
+        missing.requested_security_token.binary_security_token = None;
+        for replies in [
+            vec![],
+            vec![valid.clone(), valid],
+            vec![reply("user.auth.xboxlive.com", "urn:passport:compact")],
+            vec![reply("www.microsoft.com", "unknown")],
+            vec![expired],
+            vec![missing],
+        ] {
+            let error = licensing_ticket(collection(replies)).unwrap_err();
+            assert!(!error.contains("PRIVATE"));
+        }
+    }
+}
