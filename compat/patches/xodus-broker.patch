+// SPDX-License-Identifier: GPL-3.0-only
+//! Restart-safe completed-file receipts, not byte-level or credential storage.
+//! A receipt is published only after the file and directory entry are durable.
+//! All mutations use anchored directory descriptors and reject symlink traversal.
+use std::ffi::CString;
+use std::fs::File;
+use std::io::{self, Read, Seek, SeekFrom, Write};
+use std::os::fd::{AsRawFd, FromRawFd};
+use std::os::unix::ffi::OsStrExt;
+use std::os::unix::fs::MetadataExt;
+use std::path::Path;
+
+use fs2::FileExt;
+use nix::libc;
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+
+const JOURNAL: &str = ".xodus-resume";
+#[derive(Clone, Copy)]
+enum Creation {
+    Private,
+    Ordinary,
+}
+impl Creation {
+    fn file_mode(self) -> libc::mode_t {
+        match self {
+            Self::Private => 0o600,
+            Self::Ordinary => 0o666,
+        }
+    }
+    fn directory_mode(self) -> libc::mode_t {
+        match self {
+            Self::Private => 0o700,
+            Self::Ordinary => 0o777,
+        }
+    }
+    fn directory_flags(self) -> i32 {
+        match self {
+            Self::Private => libc::O_RDONLY,
+            Self::Ordinary => libc::O_PATH,
+        }
+    }
+    fn sync_directory(self, dir: &File) -> io::Result<()> {
+        match self {
+            Self::Private => dir.sync_all(),
+            Self::Ordinary => Ok(()),
+        }
+    }
+}
+fn invalid() -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, "invalid streaming resume data")
+}
+fn cstr(s: &str) -> io::Result<CString> {
+    CString::new(s).map_err(|_| invalid())
+}
+fn open_at(dir: &File, name: &str, flags: i32) -> io::Result<File> {
+    open_at_mode(dir, name, flags, 0o600)
+}
+fn open_at_mode(dir: &File, name: &str, flags: i32, mode: libc::mode_t) -> io::Result<File> {
+    let name = cstr(name)?;
+    let fd = unsafe {
+        libc::openat(
+            dir.as_raw_fd(),
+            name.as_ptr(),
+            flags | libc::O_CLOEXEC | libc::O_NOFOLLOW | libc::O_NONBLOCK,
+            mode,
+        )
+    };
+    if fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let file = unsafe { File::from_raw_fd(fd) };
+    let m = file.metadata()?;
+    if !(m.is_file() || (flags & libc::O_DIRECTORY != 0 && m.is_dir())) {
+        return Err(invalid());
+    }
+    if m.is_file() && m.nlink() != 1 {
+        return Err(invalid());
+    }
+    Ok(file)
+}
+fn directory(dir: &File, name: &str, create: bool) -> io::Result<File> {
+    directory_with(dir, name, create, Creation::Private)
+}
+fn directory_with(dir: &File, name: &str, create: bool, creation: Creation) -> io::Result<File> {
+    if create {
+        let c = cstr(name)?;
+        if unsafe { libc::mkdirat(dir.as_raw_fd(), c.as_ptr(), creation.directory_mode()) } != 0 {
+            let error = io::Error::last_os_error();
+            if error.kind() != io::ErrorKind::AlreadyExists {
+                return Err(error);
+            }
+        } else {
+            creation.sync_directory(dir)?;
+        }
+    }
+    open_at(dir, name, creation.directory_flags() | libc::O_DIRECTORY)
+}
+fn unlink(dir: &File, name: &str) -> io::Result<()> {
+    let c = cstr(name)?;
+    if unsafe { libc::unlinkat(dir.as_raw_fd(), c.as_ptr(), 0) } != 0 {
+        let e = io::Error::last_os_error();
+        if e.kind() != io::ErrorKind::NotFound {
+            return Err(e);
+        }
+    }
+    Ok(())
+}
+fn rename(src: &File, from: &str, dst: &File, to: &str) -> io::Result<()> {
+    rename_with(src, from, dst, to, Creation::Private)
+}
+fn rename_with(src: &File, from: &str, dst: &File, to: &str, creation: Creation) -> io::Result<()> {
+    let from = cstr(from)?;
+    let to = cstr(to)?;
+    if unsafe { libc::renameat(src.as_raw_fd(), from.as_ptr(), dst.as_raw_fd(), to.as_ptr()) } != 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    creation.sync_directory(dst)?;
+    Ok(())
+}
+fn hex(bytes: impl AsRef<[u8]>) -> String {
+    bytes.as_ref().iter().map(|b| format!("{b:02x}")).collect()
+}
+pub fn hash_bytes(bytes: &[u8]) -> String {
+    hex(Sha256::digest(bytes))
+}
+fn file_hash(file: &mut File) -> io::Result<String> {
+    file.seek(SeekFrom::Start(0))?;
+    let mut hash = Sha256::new();
+    let mut buffer = [0u8; 64 * 1024];
+    loop {
+        let n = file.read(&mut buffer)?;
+        if n == 0 {
+            break;
+        }
+        hash.update(&buffer[..n]);
+    }
+    Ok(hex(hash.finalize()))
+}
+pub fn normalized(name: &str) -> io::Result<String> {
+    let name = name.replace('\\', "/");
+    if name.len() > 4096
+        || name.starts_with(".xodus-")
+        || name.contains(':')
+        || name.chars().any(char::is_control)
+        || name
+            .split('/')
+            .any(|v| v.is_empty() || v == "." || v == "..")
+    {
+        return Err(invalid());
+    }
+    Ok(name)
+}
+fn read_json(dir: &File, name: &str) -> io::Result<Value> {
+    let file = open_at(dir, name, libc::O_RDONLY)?;
+    if file.metadata()?.len() > 8192 {
+        return Err(invalid());
+    }
+    serde_json::from_reader(file).map_err(|_| invalid())
+}
+fn atomic_json(dir: &File, name: &str, value: &Value) -> io::Result<()> {
+    let tmp = format!("{name}.new");
+    // A stale temporary is never followed, reused, or accepted as a receipt.
+    unlink(dir, &tmp)?;
+    let mut f = open_at(dir, &tmp, libc::O_WRONLY | libc::O_CREAT | libc::O_EXCL)?;
+    serde_json::to_writer(&mut f, value)?;
+    f.flush()?;
+    f.sync_all()?;
+    rename(dir, &tmp, dir, name)
+}
+
+/// Validate the complete package before any output file is opened. Keep the
+/// original names for package identities, but reject aliases on the filesystem.
+pub fn validate_names<'a>(names: impl IntoIterator<Item = &'a str>) -> io::Result<()> {
+    let mut seen = std::collections::HashSet::new();
+    for name in names {
+        if !seen.insert(normalized(name)?) {
+            return Err(invalid());
+        }
+    }
+    for name in &seen {
+        for (end, _) in name.match_indices('/') {
+            if seen.contains(&name[..end]) {
+                return Err(invalid());
+            }
+        }
+    }
+    Ok(())
+}
+
+fn target_parent(
+    root: &File,
+    name: &str,
+    create: bool,
+    creation: Creation,
+) -> io::Result<(File, String)> {
+    let name = normalized(name)?;
+    let mut parts: Vec<_> = name.split('/').collect();
+    let leaf = parts.pop().ok_or_else(invalid)?.to_string();
+    let mut dir = root.try_clone()?;
+    for part in parts {
+        dir = directory_with(&dir, part, create, creation)?;
+    }
+    Ok((dir, leaf))
+}
+
+fn prepare_cache(
+    root: &File,
+    identity: &std::sync::OnceLock<(u64, u64)>,
+    creation: Creation,
+) -> io::Result<(File, File)> {
+    for name in [".xodus-streaming-tmp.msixvc", ".xodus-streaming.msixvc"] {
+        match open_at(root, name, creation.directory_flags()) {
+            Ok(_) => (),
+            Err(e) if e.kind() == io::ErrorKind::NotFound => (),
+            Err(e) => return Err(e),
+        }
+    }
+    unlink(root, ".xodus-streaming-tmp.msixvc")?;
+    let writer = open_at_mode(
+        root,
+        ".xodus-streaming-tmp.msixvc",
+        libc::O_RDWR | libc::O_CREAT | libc::O_EXCL,
+        creation.file_mode(),
+    )?;
+    let reader = open_at(root, ".xodus-streaming-tmp.msixvc", libc::O_RDONLY)?;
+    let expected = (writer.metadata()?.dev(), writer.metadata()?.ino());
+    if expected != (reader.metadata()?.dev(), reader.metadata()?.ino()) {
+        return Err(invalid());
+    }
+    identity.set(expected).map_err(|_| invalid())?;
+    Ok((reader, writer))
+}
+
+fn finish_cache(
+    root: &File,
+    identity: &std::sync::OnceLock<(u64, u64)>,
+    creation: Creation,
+) -> io::Result<()> {
+    let cache = open_at(root, ".xodus-streaming-tmp.msixvc", libc::O_RDONLY)?;
+    if identity.get() != Some(&(cache.metadata()?.dev(), cache.metadata()?.ino())) {
+        return Err(invalid());
+    }
+    cache.sync_all()?;
+    rename_with(
+        root,
+        ".xodus-streaming-tmp.msixvc",
+        root,
+        ".xodus-streaming.msixvc",
+        creation,
+    )
+}
