+    use super::*;
+    #[test]
+    fn encrypted_output_retains_whole_pages_and_plaintext_keeps_exact_size() {
+        for (length, expected) in [
+            (0, 0),
+            (1, 4096),
+            (4096, 4096),
+            (4097, 8192),
+            (195570688, 195571712),
+        ] {
+            let f = SegmentFile {
+                offset: 0,
+                length,
+                data_hashs: vec![],
+                keep_encrypted: true,
+            };
+            assert_eq!(output_length(&f), expected);
+            let f = SegmentFile {
+                keep_encrypted: false,
+                ..f
+            };
+            assert_eq!(output_length(&f), length);
+        }
+    }
