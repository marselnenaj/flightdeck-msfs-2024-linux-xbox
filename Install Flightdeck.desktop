[Desktop Entry]
Type=Application
Name=Install Flightdeck
Name[de]=Flightdeck installieren
Comment=Install the launcher for your user
Comment[de]=Launcher für deinen Benutzer installieren
Exec=/bin/bash -c "set -eu; p=\\$1; case \\"\\$p\\" in file://localhost/*) p=\\${p#file://localhost};; file:///*) p=\\${p#file://};; /*) exec \\"\\${p%%/*}/install.sh\\" --gui;; *) exit 1;; esac; [[ \\"\\$p\\" != *'?'* && \\"\\$p\\" != *'#'* ]] || exit 1; out=; while [[ \\"\\$p\\" == *%%* ]]; do before=\\${p%%%%\\\\%%*}; tail=\\${p#*%%}; hex=\\${tail:0:2}; [[ \\"\\$hex\\" =~ ^[0-9A-Fa-f]{2}\\$ && \\"\\$hex\\" != 00 ]] || exit 1; printf -v c '%%b' \\"\\\\\\\\x\\$hex\\"; out=\\$out\\$before\\$c; p=\\${tail:2}; done; p=\\$out\\$p; exec \\"\\${p%%/*}/install.sh\\" --gui" flightdeck-installer %k
Icon=applications-games
Terminal=false
Categories=Game;Simulation;
StartupNotify=false
