#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Bridge Xodus' NT entry-point argument to the tested Wine memfd loader.

The game remains encrypted on disk. A temporary sibling PE containing only
headers lets Wine choose the architecture; its image is supplied by Xodus' fd.
This wrapper does not obtain licenses or decrypt any content.
"""
import os
import json
from pathlib import Path
import signal
import struct
import subprocess
import sys
import tempfile
import time

BASE = Path(__file__).resolve().parent
DEFAULT_WINE = BASE.parent / "runner/files/bin/wine"

def fail(message):
    raise RuntimeError(message)

def nt_path(path):
    return "\\??\\Z:" + str(path).replace("/", "\\")

def main():
    if len(sys.argv) < 2:
        fail("Expected the executable path supplied by xodus-cli run")
    argument = sys.argv[1]
    if argument.startswith("\\??\\Z:\\"):
        source = Path(argument[6:].replace("\\", "/"))
    else:
        source = Path(argument)
    source = source.resolve(strict=True)
    config = BASE.parent / "private/runtime.json"
    if config.exists() or config.is_symlink():
        info = config.lstat()
        if not config.is_file() or config.is_symlink() or info.st_size > 65536:
            fail("Invalid runtime configuration")
        game_id = json.loads(config.read_text()).get("game_id", "msfs2024")
    else:
        game_id = "msfs2024"
    directories = {"msfs2020": ("MSFS2020", "FlightSimulator.exe"),
                   "msfs2024": ("MSFS2024", "FlightSimulator2024.exe")}
    if type(game_id) is not str or game_id not in directories:
        fail("Invalid configured game")
    directory, executable = directories[game_id]
    game_root = (BASE.parent / "games" / directory).resolve(strict=True)
    if not source.is_relative_to(game_root):
        fail("The entry point is outside the configured game directory")
    if source.name.casefold() != executable.casefold():
        fail("The entry point does not match the configured game")

    map_value = os.environ.get("WINE_DLL_FILE_MAP", "")
    mappings = []
    payload_fd = None
    for item in map_value.split("|"):
        number, separator, name = item.partition(":")
        if not separator or not number.isdecimal():
            fail("Missing or invalid WINE_DLL_FILE_MAP")
        fd = int(number)
        os.fstat(fd)
        mappings.append((fd, name))
        if name.casefold() == nt_path(source).casefold():
            payload_fd = fd
    if payload_fd is None:
        fail("The entry point is not present in Xodus' inherited fd map")

    dos = os.pread(payload_fd, 64, 0)
    if len(dos) != 64 or dos[:2] != b"MZ":
        fail("Mapped entry point is not a PE executable")
    offset = struct.unpack_from("<I", dos, 0x3c)[0]
    if offset > 1024 * 1024:
        fail("Invalid PE header offset")
    pe = os.pread(payload_fd, 88, offset)
    if len(pe) != 88 or pe[:4] != b"PE\0\0":
        fail("Invalid PE signature")
    header_size = struct.unpack_from("<I", pe, 24 + 60)[0]
    file_size = os.fstat(payload_fd).st_size
    if not offset + 88 <= header_size <= min(file_size, 1024 * 1024):
        fail("Invalid PE header length")
    headers = os.pread(payload_fd, header_size, 0)
    if len(headers) != header_size:
        fail("Incomplete PE headers in inherited fd")

    temporary = tempfile.TemporaryDirectory(prefix=".xodus-launch-", dir=source.parent)
    launch_dir = Path(temporary.name)
    stub = launch_dir / source.name
    guard = None
    try:
        for resource in source.parent.iterdir():
            if resource == source or resource == launch_dir or resource.name.startswith((".xodus-fenix-", ".xodus-launch-")):
                continue
            (launch_dir / resource.name).symlink_to(resource)
        with stub.open("xb") as stream:
            stream.write(headers)
            stream.truncate(file_size)
        child_env = dict(os.environ)
        child_env.setdefault("WINEPREFIX", str(BASE.parent / "local/msfs-prefix"))
        prefix = Path(child_env["WINEPREFIX"]).resolve()
        if prefix != (BASE.parent / "local/msfs-prefix").resolve():
            fail("The Wine prefix differs from this runtime configuration")
        child_env["WINEPREFIX"] = str(prefix)
        # This loader mounts exactly one Store MSIXVC package. Flightdeck has
        # no separate Store DLC package installer yet; simulator content packs
        # are managed by the game and are not registered Store packages. Keep
        # the scope explicit so generic Wine clients cannot assume no DLC.
        child_env["XODUS_STORE_PACKAGE_SCOPE"] = "FlightdeckBaseGameOnlyV1"
        source_parent = nt_path(source.parent) + "\\"
        aliases = [(fd, nt_path(launch_dir) + "\\" + name[len(source_parent):])
                   for fd, name in mappings
                   if name.casefold().startswith(source_parent.casefold())]
        child_env["WINE_DLL_FILE_MAP"] = map_value + "|" + "|".join(f"{fd}:{name}" for fd, name in aliases)
        wine = Path(child_env.get("XODUS_WINE_RUNNER", str(DEFAULT_WINE))).resolve(strict=True)
        guard_path = prefix / "drive_c/windows/system32/FenixWindowGuard.exe"
        if child_env.get("WINE_FENIX_WINDOW_GUARD") == "1" and guard_path.is_file():
            guard_env = dict(child_env)
            guard_env.pop("WINE_DLL_FILE_MAP", None)
            guard = subprocess.Popen([str(wine), str(guard_path)], env=guard_env,
                                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL, close_fds=True)
        started = time.monotonic()
        process = subprocess.Popen([str(wine), str(stub), *sys.argv[2:]],
                                   cwd=source.parent, env=child_env,
                                   pass_fds=tuple(sorted({fd for fd, _ in mappings})))
        def forward_signal(number, _frame):
            if process.poll() is None:
                process.send_signal(number)
        previous = {number: signal.signal(number, forward_signal)
                    for number in (signal.SIGINT, signal.SIGTERM)}
        try:
            status = process.wait()
            exit_code = status if status >= 0 else 128 - status
            result = f"exit_code={status}" if status >= 0 else f"signal={-status} shell_exit_code={exit_code}"
            print(f"xodus-wine-launch: wine_pid={process.pid} {result} elapsed_seconds={time.monotonic() - started:.3f}",
                  file=sys.stderr, flush=True)
            return exit_code
        finally:
            for number, handler in previous.items():
                signal.signal(number, handler)
    finally:
        if guard is not None and guard.poll() is None:
            guard.terminate()
            try:
                guard.wait(timeout=5)
            except subprocess.TimeoutExpired:
                guard.kill()
                guard.wait()
        temporary.cleanup()

if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (RuntimeError, OSError, ValueError) as error:
        print(f"xodus-wine-launch: {error}", file=sys.stderr)
        raise SystemExit(1)
